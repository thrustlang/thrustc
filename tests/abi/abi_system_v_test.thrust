fn printf(fmt: const array[char]) s32 @public @arbitraryArgs @extern("printf") @convention("C");

static mut hello: u8 = 9;

struct Color {
    a: u8,
    b: u8,
    c: u8
}

fn test(a: Color) {
    printf("%d", a.a as u32);
} 

fn main(argc: s32, argv: ptr[array[char]]) s32 @public {
    var a := new Color {
        a: 10,
        b: 10,
        c: 10
    };  
    
    test(a);

    return 0;
}