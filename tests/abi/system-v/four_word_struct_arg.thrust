struct Wide {
    a: u64,
    b: u64,
    c: u64,
    d: u64
}

fn check(value: Wide) s32 {
    if value.a != 1 { return 1; }
    if value.b != 2 { return 2; }
    if value.c != 3 { return 3; }
    if value.d != 4 { return 4; }
    return 0;
}

fn main() s32 @public {
    var v := new Wide { a: 1, b: 2, c: 3, d: 4 };
    return check(v);
}