target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

; Function Attrs: noinline nounwind optnone sspstrong uwtable
define dso_local <16 x float> @add_vectors(<16 x float> noundef %0, <16 x float> noundef %1) #0 {
  %3 = alloca <16 x float>, align 64
  %4 = alloca <16 x float>, align 64
  store <16 x float> %0, ptr %3, align 64
  store <16 x float> %1, ptr %4, align 64
  %5 = load <16 x float>, ptr %3, align 64
  %6 = load <16 x float>, ptr %4, align 64
  %7 = fadd <16 x float> %5, %6
  ret <16 x float> %7
}

