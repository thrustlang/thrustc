/*
 * WebAssembly ABI: mixed small integer arguments and returns.
 * The LLVM IR must use signext for s8/s16 and zeroext for u8/u16.
 */

fn signed8(value: s8) s8 @public @convention("C") {
    return value;
}

fn unsigned16(value: u16) u16 @public @convention("C") {
    return value;
}

fn callSigned8(value: s8) s8 @public @convention("C") {
    return signed8(value);
}

fn callUnsigned16(value: u16) u16 @public @convention("C") {
    return unsigned16(value);
}

fn main() s32 @public {
    return 0;
}