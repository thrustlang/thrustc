directive "--import-c-include=tests/import_c/helpers/scope";
directive "--import-c-scope=transitive-all";

importC "scope_bundle.h";

fn main() s32 @public {
    if scope_bundle::SCOPE_ROOT_VALUE != 13 { return 1; }
    if scope_bundle::SCOPE_DEP_VALUE != 27 { return 2; }
    if scope_bundle::ScopeDepKind=>ScopeDepKindCold != -1 { return 3; }

    return 0;
}
