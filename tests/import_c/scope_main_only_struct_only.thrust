directive "--import-c-include=tests/import_c/helpers/scope";
directive "--import-c-scope=main-only";

importC "scope_bundle.h";

fn main() s32 @public {
    var bundle: scope_bundle::ScopeBundle = new scope_bundle::ScopeBundle { value: 14 };

    if scope_bundle::SCOPE_ROOT_VALUE != 13 { return 1; }
    if bundle->value != 14 { return 2; }
    if sizeOf(scope_bundle::ScopeBundle) < sizeOf(s32) { return 3; }

    return 0;
}
