importC "ctype.h" as ctypeh;
importC "stdlib.h" as cstdlib;
importC "string.h" as cstring;

fn main() s32 @public {
    var parsed: s32 = cstdlib::atoi("12" as const ptr[char]);
    var total: s32 = parsed + cstring::strlen("abc" as const ptr[char]) as s32;

    if total != 15 { return 1; }
    if ctypeh::toupper('b' as s32) != 'B' as s32 { return 2; }
    if ctypeh::isdigit('4' as s32) == 0 { return 3; }

    return 0;
}
