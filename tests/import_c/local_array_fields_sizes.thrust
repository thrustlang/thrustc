directive "--import-c-include=tests/import_c/helpers/local";

importC "array_fields.h";

fn main() s32 @public {
    if array_fields::LOCAL_ARRAY_FIELDS_TAG_LEN + array_fields::LOCAL_ARRAY_FIELDS_PAYLOAD_LEN != 12 {
        return 1;
    }

    if sizeOf(array_fields::LocalArrayFields) < array_fields::LOCAL_ARRAY_FIELDS_TAG_LEN +
        array_fields::LOCAL_ARRAY_FIELDS_PAYLOAD_LEN {
        return 2;
    }

    return 0;
}
