importC "string.h" as cstring;

fn main() s32 @public {
    if cstring::strncmp("alpha" as const ptr[char], "alphabet" as const ptr[char], 5) != 0 {
        return 1;
    }

    if cstring::strncmp("alpha" as const ptr[char], "alphabet" as const ptr[char], 6) >= 0 {
        return 2;
    }

    return 0;
}
