directive "--import-c-include=tests/import_c/helpers/local";

importC "numeric_macros.h";

fn main() s32 @public {
    if numeric_macros::LOCAL_NEGATIVE != -5 { return 1; }
    if numeric_macros::LOCAL_HEX != 42 { return 2; }
    if numeric_macros::LOCAL_UNSIGNED != 15 { return 3; }
    if numeric_macros::LOCAL_FLOAT <= 0.0 { return 4; }
    if numeric_macros::LOCAL_DOUBLE <= 1.0 { return 5; }

    return 0;
}
