
directive "--import-c-include=tests/import_c/helpers/local";

importC "macros/local_macro_struct_nested_array.h";

fn main() s32 @public {
    var item: local_macro_struct_nested_array::MacroNestedOuter =
        new local_macro_struct_nested_array::MacroNestedOuter {
            inner: new local_macro_struct_nested_array::MacroNestedInner { value: 20 },
            cells: fixed[10, 12],
        };

    if local_macro_struct_nested_array::MACRO_NESTED_TOTAL(ref item) != 42 { return 1; }

    return 0;
}
