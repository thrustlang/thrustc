directive "--import-c-include=tests/import_c/helpers/local";

importC "pointer_types.h" as ptrs;

fn main() s32 @public {
    var item: ptrs::LocalPointerInner = new ptrs::LocalPointerInner { value: 12 };

    var p: ptrs::LocalPointerInnerPtr = ref item;
    var cp: ptrs::LocalPointerInnerConstPtr = ref item;

    if p->value != 12 { return 1; }
    if cp->value != 12 { return 2; }

    return 0;
}
