importC "string.h" as cstring;

fn main() s32 @public {
    if cstring::strlen("alpha" as const ptr[char]) != 5 { return 1; }
    if cstring::strcmp("alpha" as const ptr[char], "alpha" as const ptr[char]) != 0 { return 2; }
    if cstring::strcmp("alpha" as const ptr[char], "beta" as const ptr[char]) >= 0 { return 3; }

    return 0;
}
