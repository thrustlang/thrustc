/*
 * Fixed array size in a global static declared before the constant.
 * Global constants are resolved regardless of declaration order.
 */

static buffer: array[u8; BUFFER_SIZE];

const BUFFER_SIZE: u32 = 64;

fn main() s32 @public {
    if sizeOf(array[u8; BUFFER_SIZE]) != 64 { return 1; }

    return 0;
}