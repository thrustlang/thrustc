/*
 * Assembler value used as a typed expression without arguments.
 */

fn main() s32 @public {
    @if(isLinux() && isX8664()) {
        var value: s32 = asm () s32 #asm{
            mov $0, 31,
            add $0, 11,
            ret
        };

        if value != 42 { return 1; }
    } @else {
        return 0;
    }

    return 0;
}
