/*
 * Verifies property->name[i] (index simple): deref del campo (array/puntero) y
 * luego indexación normal, leyendo el elemento con 'deref'.
 */

struct Wrapper {
    data: ptr[array[s32; 4]],
}

fn main() s32 @public {
    var arr: array[s32; 4] = fixed[10, 20, 30, 40];
    var v := new Wrapper { data: ref arr };

    var element: s32 = deref v->data[2];

    if element != 30 { return 1; }

    return 0;
}
