import std::tstring;
import std::collections::vector;
import std::io;

fn iterate(str: ptr[tstring::TString]) void {
    io::print("%s\n", tstring::toCString(str));
}

fn dropAllTstring(str: ptr[tstring::TString]) void {
    tstring::dropTString(str);
}

fn main() s32 @public {
    var tstr: tstring::TString = tstring::fromCString("hello");
    var tstr_splitted: vector::Vector[tstring::TString] = tstring::split(ref tstr, "");

    vector::forEachPtr(ref tstr_splitted, iterate);
    tstring::dropTString(ref tstr);
    
    return 0;
}