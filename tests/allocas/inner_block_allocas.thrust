directive "--disable-warnings=W0005";
directive "--disable-warnings=W0020";
directive "--disable-warnings=W0030";
directive "--disable-warnings=W0021";

fn innerBlock(seed: s32) s32 @public {
    var value: s32 = seed;

    {
        var doubled: s32 = value * 2;
        value = doubled + 1;
    }

    {
        var tripled: s32 = value * 3;
        value = tripled - 2;
    }

    return value;
}

fn main() s32 @public {
    if innerBlock(2) != 13 { return 1; }
    return 0;
}