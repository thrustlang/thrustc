directive "--disable-warnings=W0005";
directive "--disable-warnings=W0020";
directive "--disable-warnings=W0030";
directive "--disable-warnings=W0021";

struct Point {
    x: s32,
    y: s32
}

fn structLocals() s32 @public {
    var p := new Point { x: 2, y: 3 };
    var q := new Point { x: p->x + 1, y: p->y + 1 };

    return q->x + q->y;
}

fn main() s32 @public {
    if structLocals() != 7 { return 1; }
    return 0;
}