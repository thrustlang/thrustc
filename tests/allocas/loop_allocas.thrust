directive "--disable-warnings=W0005";
directive "--disable-warnings=W0020";
directive "--disable-warnings=W0030";
directive "--disable-warnings=W0021";

fn sumRange(limit: s32) s32 @public {
    var total: s32 = 0;
    var i: s32 = 0;

    while i < limit {
        var step: s32 = i * 2;
        total = total + step;
        i++;
    }

    return total;
}

fn main() s32 @public {
    if sumRange(5) != 20 { return 1; }
    return 0;
}