/*
 * Write to a fixed array element through a deref arrow (`->[i]`) and read it
 * back. Returns 0 on success, non-zero on failure.
 */

fn fill() s32 {
    var buffer: array[s32; 4];
    var total: s32 = 0;
    var i: s32 = 0;

    while i < 4 {
        buffer->[i] = i * 2;
        i += 1;
    }

    while i > 0 {
        i -= 1;
        total += buffer->[i];
    }

    return total;
}

fn main() s32 @public {
    if fill() != 12 { return 1; }
    return 0;
}