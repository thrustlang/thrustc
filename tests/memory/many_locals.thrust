directive "--disable-warnings=W0005";
directive "--disable-warnings=W0020";
directive "--disable-warnings=W0030";
directive "--disable-warnings=W0021";

fn manyLocals() s32 @public {
    var a: s32 = 1;
    var b: s32 = a + 1;
    var c: s32 = b + 1;
    var d: s32 = c + 1;
    var e: s32 = d + 1;
    var f: s32 = e + 1;
    var g: s32 = f + 1;

    return a + b + c + d + e + f + g;
}

fn main() s32 @public {
    if manyLocals() != 28 { return 1; }
    return 0;
}