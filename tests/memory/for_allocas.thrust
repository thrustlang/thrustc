directive "--disable-warnings=W0005";
directive "--disable-warnings=W0020";
directive "--disable-warnings=W0030";
directive "--disable-warnings=W0021";

fn forLocals() s32 @public {
    var total: s32 = 0;

    for var i: s32 = 0; i < 4; i += 1; {
        var square: s32 = i * i;
        var cube: s32 = square * i;
        total = total + cube;
    }

    return total;
}

fn main() s32 @public {
    if forLocals() != 36 { return 1; }
    return 0;
}