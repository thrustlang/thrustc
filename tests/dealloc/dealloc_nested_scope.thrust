/*
 * Exercises @dealloc inside nested scopes: the deallocator must run at the
 * end of the enclosing scope.
 * Returns 0 on success, non-zero on failure.
 */

import "dealloc_module.thrust" as d;

directive "--disable-warnings=W0005";
directive "--disable-warnings=W0020";

static mut observed: s32 = 0;

fn main() s32 @public {
    {
        var holder @dealloc: d::ExternalHolder = d::newExternalHolder(5);
        observed = 0;
    }

    if observed != 0 { return 1; }

    return 0;
}