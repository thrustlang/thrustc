/*
 * Exercises @dealloc on std::collections::hashset.
 * Returns 0 on success, non-zero on failure.
 */

import std::collections::hashset;

directive "--disable-warnings=W0005";
directive "--disable-warnings=W0020";

fn main() s32 @public {
    var set @dealloc: hashset::HashSet[u64] = hashset::newHashSet[u64]();
    var key: u64 = 42;

    if !hashset::insert(ref set, ref key) { return 1; }
    if hashset::getLength(ref set) != 1 { return 2; }
    if !hashset::contains(ref set, ref key) { return 3; }

    return 0;
}