directive "--disable-warnings=W0005";
directive "--disable-warnings=W0020";

static mut dropped: s32 = 0;

struct Box [T] {
    value: T
}

fn dropBox [T] (box: ptr[Box[T]]) void @deallocator {
    dropped += 1;
}

fn createSigned() void {
    var box @dealloc: Box[s32] = new Box[s32] { value: 1 };
}

fn createWide() void {
    var box @dealloc(dropBox): Box[u64] = new Box[u64] { value: 2 };
}

fn main() s32 @public {
    createSigned();
    createWide();

    if dropped != 2 { return 1; }

    return 0;
}
