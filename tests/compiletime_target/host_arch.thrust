/*
 * Compile-time host builtins.
 *
 * Uses hostArch, hostOsName and hostEndian inside @if/@elif/@else if/@else
 * chains. These are resolved from the host where the compiler runs.
 * The expectation assumes a little-endian Linux host.
 */

fn main() s32 @public {
    var count: s32 = 0;

    @if(hostArch() == "x86_64") {
        count += 1;
    } @elif(hostArch() == "aarch64") {
        count += 100;
    } @else {
        count += 1000;
    }

    @if(hostOsName() == "linux") {
        count += 2;
    } @else if(hostOsName() == "macos") {
        count += 1000;
    } @else {
        count += 1000;
    }

    @if(hostEndian() == "little") {
        count += 3;
    } @else {
        count += 10000;
    }

    if count != 6 { return 1; }

    return 0;
}
