/*
 * Compile-time builtin chains.
 *
 * Combines target and host builtins inside @if/@elif/@else if/@else
 * chains. The expectation assumes a 64-bit Linux x86_64 host.
 */

fn main() s32 @public {
    var count: s32 = 0;

    @if(isWindows()) {
        count += 1000;
    } @elif(isLinux() && is64Bit()) {
        count += 1;
    } @else if(isDarwin()) {
        count += 1000;
    } @else {
        count += 100000;
    }

    @if(hostOsName() == "linux" && pointerWidth() >= 64) {
        count += 2;
    } @else {
        count += 1000;
    }

    @if(sizeOf(u64) == 8 && alignOf(u64) >= 8) {
        count += 3;
    } @else {
        count += 1000;
    }

    @if(isBigEndian()) {
        count += 1000;
    } @elif(isLittleEndian()) {
        count += 4;
    } @else {
        count += 100000;
    }

    if count != 10 { return 1; }

    return 0;
}
