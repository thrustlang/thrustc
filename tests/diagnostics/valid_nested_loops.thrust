/*
 * Positive diagnostic: nested loops and labels compile cleanly.
 */

fn main() s32 @public {
    var total: s32 = 0;

    for var i: s32 = 0; i < 3; i += 1; {
        for var j: s32 = 0; j < 3; j += 1; {
            if j == 1 {
                continue;
            }
            total = total + i * 3 + j;
        }
    }

    if total != 24 { return 1; }

    return 0;
}