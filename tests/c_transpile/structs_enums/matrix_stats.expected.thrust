enum ReduceOp {
    OP_SUM: u32 = 0;
    OP_MIN: u32 = 1;
    OP_MAX: u32 = 2;
}

struct Matrix {
    rows: s32,
    cols: s32,
    cells: array[array[s32; 4]; 4],
}

fn matrix_fill(m: ptr[Matrix], value: s32) void {
    for var r: s32 = 0; r < m->rows; r += 1; {
        for var c: s32 = 0; c < m->cols; c += 1; {
            (m->cells[0][0])->[((r) * 4) + (c)] = value + r * m->cols + c;
        }
    }
}
fn matrix_get(m_param: Matrix, r: s32, c: s32) s32 {
    var m: Matrix = m_param;

    if (((r < 0) || (c < 0)) || (r >= m->rows)) || (c >= m->cols) {
        return ((-1) as s32) as s32;
    }
    return ((m->cells[0][0])->[((r) * 4) + (c)]) as s32;
}
fn matrix_reduce(m: const ptr[Matrix], op: u32) s32 {
    var thrust_temporary_0: s32;
    if (op == ReduceOp=>OP_SUM) {
        thrust_temporary_0 = 0;
    } else {
        thrust_temporary_0 = (m->cells[0][0])->[((0) * 4) + (0)];
    }
    var acc: s32 = (thrust_temporary_0) as s32;
    for var r: s32 = 0; r < m->rows; r += 1; {
        for var c: s32 = 0; c < m->cols; c += 1; {
            var v: s32 = (m->cells[0][0])->[((r) * 4) + (c)];
            if op == ReduceOp=>OP_SUM {
                acc += v;
            } else if op == ReduceOp=>OP_MIN {
                if v < acc {
                    acc = v;
                }
            } else if op == ReduceOp=>OP_MAX {
                if v > acc {
                    acc = v;
                }
            } else {
            }
        }
    }
    return (acc) as s32;
}
fn matrix_stats_check() s32 {
    var m: Matrix = new Matrix { rows: 2, cols: 3, cells: fixed[fixed[0, 0, 0, 0], fixed[0, 0, 0, 0], fixed[0, 0, 0, 0], fixed[0, 0, 0, 0]] };
    matrix_fill(ref (m), 1);
    if matrix_get(m, 0, 0) != 1 {
        return (1) as s32;
    }
    if matrix_get(m, 1, 2) != 6 {
        return (2) as s32;
    }
    if matrix_get(m, 2, 0) != (-1) as s32 {
        return (3) as s32;
    }
    if matrix_reduce(ref (m), (ReduceOp=>OP_SUM) as u32) != (21) as s32 {
        return (4) as s32;
    }
    if matrix_reduce(ref (m), (ReduceOp=>OP_MAX) as u32) != 6 {
        return (5) as s32;
    }
    if matrix_reduce(ref (m), (ReduceOp=>OP_MIN) as u32) != 1 {
        return (6) as s32;
    }
    var t: Matrix = matrix_transpose(m);
    if (t->rows != 2) || (t->cols != 3) {
        return (7) as s32;
    }
    if (t->cells[0][0])->[((0) * 4) + (1)] != (m->cells[0][0])->[((1) * 4) + (0)] {
        return (8) as s32;
    }
    return (0) as s32;
}
fn matrix_transpose(m_param: Matrix) Matrix {
    var m: Matrix = m_param;

    var out: Matrix = m;
    for var r: s32 = 0; r < m->rows; r += 1; {
        for var c: s32 = 0; c < m->cols; c += 1; {
            (out->cells[0][0])->[((c) * 4) + (r)] = (m->cells[0][0])->[((r) * 4) + (c)];
        }
    }
    return out;
}
