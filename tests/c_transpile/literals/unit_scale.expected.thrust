    flags |= ((8) as ssize) as u32;
    if (flags != ((11) as u32)) && (fail == 0) {
        fail = 2;
    }
    var span: ssize = (2500000) as ssize;
    var cap: usize = (4000000000) as usize;
    if (span / (1000) as ssize != (2500) as ssize) && (fail == 0) {
