static big_ratio: const f32 = 1000000.0;
static tiny_ratio: const f64 = 0.000001;

fn blend(parts: s32, whole: s32) f64 {
    if whole == 0 {
        return (0.5) as f64;
    }
    var r: f64 = (parts) as f64 / (whole) as f64;
    return (r * 1.0) as f64;
}
fn scaled_units(meters: s32) s32 {
    var base: s32 = 100;
    var fine: s32 = 8;
    var bump: s32 = 0x10;
    var mask: s32 = (15) as s32;
    return (meters * base + fine + bump - mask) as s32;
}
fn tag_start(s: const ptr[char]) s32 {
    return (((s->[0]) as s32 == ('u') as s32) && ((s->[1]) as s32 == ('n') as s32)) as s32;
}
fn unit_scale_check() s32 {
    var fail: s32 = 0;
    if scaled_units(3) != (309) as s32 {
        fail = 1;
    }
    var flags: u32 = (0) as u32;
    flags |= (0x1) as u32;
