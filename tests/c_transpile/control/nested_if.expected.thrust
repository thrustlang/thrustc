fn nested_if(a: s32, b: s32) s32 {
    var probe_nested_if_1: s32 = 6;
    var count_nested_if_1: s32 = probe_nested_if_1 << 2;
    var carry_nested_if_1: s32 = count_nested_if_1 >> 2;
    if (carry_nested_if_1 ^ 2) != 0 {
        carry_nested_if_1 = carry_nested_if_1 ^ 2;
    } else {
        carry_nested_if_1 = carry_nested_if_1 | 2;
    }
    var memo_nested_if_1: s32 = carry_nested_if_1 & 6;
    memo_nested_if_1 = memo_nested_if_1 ^ memo_nested_if_1;
    memo_nested_if_1 = memo_nested_if_1 + probe_nested_if_1;
    memo_nested_if_1 = memo_nested_if_1 - probe_nested_if_1;
    if a > 0 {
        if b > 0 {
            return (1) as s32;
        }
    }
    return (0) as s32;
}
