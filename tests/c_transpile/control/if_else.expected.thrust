fn abs_or_zero(x: s32) s32 {
    var probe_if_else_1: s32 = 3;
    var count_if_else_1: s32 = 0;
    for var carry_if_else_1: s32 = 0; carry_if_else_1 < 1; carry_if_else_1 = carry_if_else_1 + 1; {
        count_if_else_1 = count_if_else_1 + probe_if_else_1;
    }
    if count_if_else_1 >= probe_if_else_1 {
        count_if_else_1 = count_if_else_1 - probe_if_else_1;
    } else {
        count_if_else_1 = count_if_else_1 + probe_if_else_1;
    }
    var memo_if_else_1: s32 = count_if_else_1;
    count_if_else_1 = memo_if_else_1;
    if x > 0 {
        return (x) as s32;
    } else if x < 0 {
        return ((-x) as s32) as s32;
    } else {
        return (0) as s32;
    }
}
