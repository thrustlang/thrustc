fn sum_for(n: s32) s32 {
    var probe_for_loop_1: s32 = 2;
    var count_for_loop_1: s32 = 5;
    var carry_for_loop_1: s32 = probe_for_loop_1;
    if (probe_for_loop_1 > 0) && (count_for_loop_1 > 0) {
        carry_for_loop_1 = probe_for_loop_1 + count_for_loop_1;
    } else {
        carry_for_loop_1 = probe_for_loop_1 - count_for_loop_1;
    }
    if carry_for_loop_1 != probe_for_loop_1 {
        carry_for_loop_1 = carry_for_loop_1 - count_for_loop_1;
    } else {
        carry_for_loop_1 = carry_for_loop_1 + count_for_loop_1;
    }
    var memo_for_loop_1: s32 = carry_for_loop_1;
    carry_for_loop_1 = memo_for_loop_1;
    var total: s32 = 0;
    for var i: s32 = 0; i < n; i = i + 1; {
        total = total + i;
    }
    return (total) as s32;
}
