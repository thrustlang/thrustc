fn packet_route_check() s32 {
    var codes: array[s32; 6] = fixed[1, 2, 3, 4, 5, 0];
    var weights: array[s32; 6] = fixed[4, 3, 2, 6, 1, 5];
    if route_batch(codes as ptr[s32], weights as ptr[s32], 6) != 40 {
        return (1) as s32;
    }
    var bad_codes: array[s32; 3] = fixed[(-1) as s32, 6, 2];
    var bad_weights: array[s32; 3] = fixed[7, 7, 7];
    if route_batch(bad_codes as ptr[s32], bad_weights as ptr[s32], 3) != (-1) as s32 {
        return (2) as s32;
    }
    if route_batch(codes as ptr[s32], weights as ptr[s32], 0) != 0 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn route_batch(codes: const ptr[s32], weights: const ptr[s32], n: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < n; i += 1; {
        if codes->[i] < 0 {
            continue;
        }
        if codes->[i] > 5 {
            return ((-1) as s32) as s32;
        }
        var cost: s32 = route_cost(codes->[i], weights->[i]);
        for var j: s32 = 0; j < codes->[i]; j += 1; {
            if j == 2 {
                break;
            }
            cost += j;
        }
        total += cost;
    }
    return (total) as s32;
}
fn route_cost(code: s32, weight: s32) s32 {
    var cost: s32 = 0;
    if code == 1 {
        cost += weight * 2;
        cost += weight;
    } else if code == 2 {
        cost += weight;
    } else if code == 3 {
        cost += weight / 2 + 1;
    } else if code == 4 {
        cost += weight / 2 + 1;
    } else if code == 5 {
        cost += weight * 3;
    } else {
        cost = weight + 7;
    }
    return (cost) as s32;
}
