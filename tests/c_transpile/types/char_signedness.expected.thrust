importC "stdbool.h";

type block_t = array[char; 8];
type byte_t = char;
type schar_t = s8;
type uchar_t = u8;

fn char_signedness_check() s32 {
    var text: array[char; 8] = fixed[('T') as char, ('h') as char, ('r') as char, ('u') as char, ('s') as char, ('t') as char, ('!') as char, (0) as char];
    if digit_value(('7') as char) != 7 {
        return (1) as s32;
    }
    if digit_value(('x') as char) != (-1) as s32 {
        return (2) as s32;
    }
    if !(is_alpha(('Q') as char)) {
        return (3) as s32;
    }
    if is_alpha(('3') as char) {
        return (4) as s32;
    }
    if checksum_block(text as ptr[char], 7) != (((171) as s32)) as s32 {
        return (5) as s32;
    }
    var raw: array[u8; 5] = fixed[((0) as u32) as u8, ((255) as u32) as u8, ((255) as u32) as u8, ((1) as u32) as u8, ((255) as u32) as u8];
    if count_bytes(raw as ptr[u8], 5, (255) as u8) != 3 {
        return (6) as s32;
    }
    if count_bytes(raw as ptr[u8], 5, ((0) as u32) as u8) != 1 {
        return (7) as s32;
    }
    var high: u8 = (200) as u8;
    var as_int: s32 = (high) as s32;
    if as_int != 200 {
        return (8) as s32;
    }
    var neg: s8 = ((-1) as s32) as s8;
    if neg >= 0 {
        return (9) as s32;
    }
    var msg: const ptr[char] = ("thrust") as const ptr[char];
    var len: s32 = 0;
    while (msg->[len]) as s32 != ('\0') as s32 {
        len++;
    }
    if len != 6 {
        return (10) as s32;
    }
    return (0) as s32;
}
fn checksum_block(block: const ptr[char], n: s32) s32 {
    var acc: s32 = 0;
    for var i: s32 = 0; i < n; i = i + 1; {
        var u: u8 = (block->[i]) as u8;
        acc = (acc + (u) as s32) & 0xFF;
    }
    return (acc) as s32;
}
fn count_bytes(data: const ptr[u8], n: s32, target: u8) s32 {
    var hits: s32 = 0;
    for var i: s32 = 0; i < n; i += 1; {
        if data->[i] == target {
            hits++;
        }
    }
    return (hits) as s32;
}
fn digit_value(c: char) s32 {
    if ((c) as s32 >= ('0') as s32) && ((c) as s32 <= ('9') as s32) {
        return ((c) as s32 - ('0') as s32) as s32;
    }
    return ((-1) as s32) as s32;
}
fn is_alpha(c: char) bool {
    return ((((c) as s32 >= ('a') as s32) && ((c) as s32 <= ('z') as s32))) || ((((c) as s32 >= ('A') as s32) && ((c) as s32 <= ('Z') as s32)));
}
