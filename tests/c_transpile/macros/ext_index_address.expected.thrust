fn main() s32 @public {
    var value: s32 = 0;
    __c_macro_ADDRESS_TEST[s32](ref (value));
    if value != 915 {
        return (1) as s32;
    }
    return (0) as s32;
}
fn __c_macro_ADDRESS_TEST[T1](out: ptr[T1]) void @alwaysInline {
    var matrix: array[array[s32; 3]; 2] = fixed[fixed[1, 2, 3], fixed[4, 5, 6]];
    var cell: ptr[s32] = matrix[0][1];
    cell->[0] = 9;
    out->[0] =  ((deref matrix[0][1]) * 100 + (deref matrix[1][0]) + (deref matrix[1][1]) + (deref matrix[1][2])) as T1;
}

