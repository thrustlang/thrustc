fn main() s32 @public {
    var thrust_temporary_0: s32;
    if 2 > 6 {
        thrust_temporary_0 = 3;
    } else {
        thrust_temporary_0 = 2;
    }
    if test_return_3(2) != (thrust_temporary_0) {
