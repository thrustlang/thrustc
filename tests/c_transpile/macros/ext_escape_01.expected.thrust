fn main() s32 @public {
    var thrust_temporary_0: s32;
    if 3 > 5 {
        thrust_temporary_0 = 1;
    } else {
        thrust_temporary_0 = 3;
    }
    if test_return_1(3) != (thrust_temporary_0) {
        return (1) as s32;
    }
    var thrust_temporary_1: s32;
    if (6) as s32 < 10 {
        thrust_temporary_1 = (6) as s32;
    } else {
        thrust_temporary_1 = 10;
    }
    if test_break_1() != (thrust_temporary_1) {
        return (2) as s32;
    }
    if test_continue_1() != 16 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn test_break_1() s32 {
    var i: s32;
    i = 0;
    while i < 10 {
        if i > 5 {
            break;
        }
        i += 1;
    }
    return (i) as s32;
}
fn test_continue_1() s32 {
    var i: s32;
    var total: s32 = 0;
    i = 0;
    while i < 8 {
        if i % 2 == 0 {
            i += 1;
            continue;
        }
        total += i;
        i += 1;
    }
    return (total) as s32;
}
fn test_return_1(x: s32) s32 {
