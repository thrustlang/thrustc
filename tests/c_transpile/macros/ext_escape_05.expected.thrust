fn main() s32 @public {
    var thrust_temporary_0: s32;
    if 1 > 3 {
        thrust_temporary_0 = 5;
    } else {
        thrust_temporary_0 = 1;
    }
    if test_return_5(1) != (thrust_temporary_0) {
        return (1) as s32;
    }
    var thrust_temporary_1: s32;
    if (4) as s32 < 10 {
        thrust_temporary_1 = (4) as s32;
    } else {
        thrust_temporary_1 = 10;
    }
    if test_break_5() != (thrust_temporary_1) {
        return (2) as s32;
    }
    if test_continue_5() != 16 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn test_break_5() s32 {
    var i: s32;
    i = 0;
    while i < 10 {
        if i > 3 {
            break;
        }
        i += 1;
    }
    return (i) as s32;
}
fn test_continue_5() s32 {
    var i: s32;
    var total: s32 = 0;
    i = 0;
    while i < 8 {
        if i % 2 == 0 {
            i += 1;
            continue;
        }
        total += i;
