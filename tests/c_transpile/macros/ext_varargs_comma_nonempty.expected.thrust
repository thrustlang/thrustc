fn printf(fmt: const ptr[char]) s32 @public @extern("printf") @convention("C") @arbitraryArgs @noArgCount;

fn ext_varargs_comma_nonempty_value() s32 {
    var total: s32 = 0;
    var i: s32;
    i = 1;
    while i <= 4 {
        printf((("%d\n")) as ptr[char], weight(i));
        total = total + i;
        i += 1;
    }
    printf((("%s %d\n")) as ptr[char], "sum", total);
    i = 0;
    while i < 3 {
        printf((("%d\n")) as ptr[char], weight(i + 1));
        total = total + 1;
        i += 1;
    }
    return (total + 10) as s32;
}
fn weight(value: s32) s32 {
    return (value * 2) as s32;
}
