fn bump(value: s32) s32 {
    return (value + 1) as s32;
}
fn ext_varargs_zero_value() s32 {
    var total: s32 = 0;
    var i: s32;
    total = total + (9);
    total = total + (4);
    total = total + (bump(10));
    total = total + (bump(20));
    i = 0;
    while i < 4 {
        total = total + (i);
        i += 1;
    }
    return (total) as s32;
}
