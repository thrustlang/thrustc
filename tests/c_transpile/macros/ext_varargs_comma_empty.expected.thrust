fn printf(fmt: const ptr[char]) s32 @public @extern("printf") @convention("C") @arbitraryArgs @noArgCount;

fn ext_varargs_comma_empty_value() s32 {
    var i: s32;
    var total: s32 = 0;
    i = 0;
    while i < 3 {
        printf((("ok\n")) as ptr[char]);
        total = total + marker(i);
        i += 1;
    }
    printf((("done\n")) as ptr[char]);
    return (finish(total + 17)) as s32;
}
fn finish(value: s32) s32 {
    return (value + 3) as s32;
}
fn marker(value: s32) s32 {
    return (value + 2) as s32;
}
