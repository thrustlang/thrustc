struct Grid {
    cells: array[array[s32; 3]; 2],
    size: s32,
}

fn main() s32 @public {
    var grid: Grid = new Grid { cells: fixed[fixed[0, 0, 0], fixed[0, 0, 0]], size: 0 };
    __c_macro_SET_GRID[Grid, s32, s32, s32](ref (grid), 0, 2, 8);
    __c_macro_SET_GRID[Grid, s32, s32, s32](ref (grid), 1, 1, 3);
    __c_macro_ADD_GRID[Grid, s32, s32, s32](ref (grid), 0, 2, 4);
    if (grid->cells[0][0])->[((0) * 3) + (2)] != 12 {
        return (1) as s32;
    }
    if (grid->cells[0][0])->[((1) * 3) + (1)] != 3 {
        return (2) as s32;
    }
    var cell: ptr[s32] = grid.cells[1][1];
    if cell->[0] != 3 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn __c_macro_SET_GRID[T1, T2, T3, T4](grid: ptr[T1], row: T2, col: T3, value: T4) void @alwaysInline {
    var target: ptr[Grid] = (grid);
    target->cells[row][col] = (value);
}

fn __c_macro_ADD_GRID[T1, T2, T3, T4](grid: ptr[T1], row: T2, col: T3, value: T4) void @alwaysInline {
    var target: ptr[Grid] = (grid);
    var old: s32 = (deref target->cells[row][col]);
    target->cells[row][col] = old + (value);
}

