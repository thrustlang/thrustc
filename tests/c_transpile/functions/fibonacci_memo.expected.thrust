fn fib(n: s32) s32 {
    if n < 2 {
        return (n) as s32;
    }
    return (fib(n - 1) + fib(n - 2)) as s32;
}
fn fib_index_of(target: s64) s32 {
    var i: s32 = 0;
    while fib_iter(i) < target {
        i = i + 1;
    }
    return (i) as s32;
}
fn fib_iter(n: s32) s64 {
    var a: s64 = (0) as s64;
    var b: s64 = (1) as s64;
    for var i: s32 = 0; i < n; i = i + 1; {
        var next: s64 = a + b;
        a = b;
        b = next;
    }
    return (a) as s64;
}
fn fib_sum(limit: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i <= limit; i = i + 1; {
        total = total + fib(i);
    }
    return (total) as s32;
}
fn fibonacci_memo_check() s32 {
    if fib(0) != 0 {
        return (1) as s32;
    }
    if fib(10) != 55 {
        return (2) as s32;
    }
    if fib(15) != 610 {
        return (3) as s32;
    }
    if fib_iter(20) != 6765 {
        return (4) as s32;
    }
    if fib_sum(6) != 20 {
        return (5) as s32;
    }
    if fib_index_of((34) as s64) != 9 {
        return (6) as s32;
    }
    return (0) as s32;
}
