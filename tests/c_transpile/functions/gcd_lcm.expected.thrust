fn add_fractions(n1: s32, d1: s32, n2: s32, d2: s32, out_num: ptr[s32], out_den: ptr[s32]) s32 {
    var common: s32 = lcm(d1, d2);
    var left: s32 = n1 * (common / d1);
    var right: s32 = n2 * (common / d2);
    out_num->[0] = left + right;
    out_den->[0] = common;
    reduce_fraction(out_num, out_den);
    return (common) as s32;
}
fn gcd(a: s32, b: s32) s32 {
    if b == 0 {
        return (a) as s32;
    }
    return (gcd(b, a % b)) as s32;
}
fn gcd_lcm_check() s32 {
    if gcd(48, 36) != 12 {
        return (1) as s32;
    }
    if gcd(270, 192) != 6 {
        return (2) as s32;
    }
    if lcm(4, 6) != 12 {
        return (3) as s32;
    }
    if lcm(21, 6) != 42 {
        return (4) as s32;
    }
    if gcd_three(24, 36, 60) != 12 {
        return (5) as s32;
    }
    var num: s32 = 0;
    var den: s32 = 0;
    var common: s32 = add_fractions(1, 2, 1, 3, ref (num), ref (den));
    if common != 6 {
        return (6) as s32;
    }
    if num != 5 {
        return (7) as s32;
    }
    if den != 6 {
        return (8) as s32;
    }
    reduce_fraction(ref (num), ref (den));
    if num != 5 {
        return (9) as s32;
    }
    if den != 6 {
        return (10) as s32;
    }
    return (0) as s32;
}
fn gcd_three(a: s32, b: s32, c: s32) s32 {
    return (gcd(gcd(a, b), c)) as s32;
}
fn lcm(a: s32, b: s32) s32 {
    return ((a / gcd(a, b)) * b) as s32;
}
fn reduce_fraction(num: ptr[s32], den: ptr[s32]) void {
    var g: s32 = gcd(num->[0], den->[0]);
    num->[0] = num->[0] / g;
    den->[0] = den->[0] / g;
}
