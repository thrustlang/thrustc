fn half(x: f64) f64 {
    var probe_typed_returns_1: s32 = 1;
    var count_typed_returns_1: s32 = 0;
    for var carry_typed_returns_1: s32 = 0; carry_typed_returns_1 < 1; carry_typed_returns_1 = carry_typed_returns_1 + 1; {
        count_typed_returns_1 = count_typed_returns_1 + probe_typed_returns_1;
    }
    if count_typed_returns_1 >= probe_typed_returns_1 {
