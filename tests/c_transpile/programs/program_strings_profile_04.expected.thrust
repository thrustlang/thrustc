static global_limit_04: const s32 @public @extern("global_limit_04") = 15;
static mut scanned_lines_04: s32 = 0;

fn count_words_04(text: const ptr[char]) s32 {
    var words: s32 = 0;
    var length: s32 = 0;
    for var i: s32 = 0; text->[i] != '\0'; i += 1; {
        if (is_letter_04(text->[i])) != 0 {
            length += 1;
        } else {
            if length >= 5 {
                words += 1;
            }
            length = 0;
        }
    }
    if length >= 5 {
        words += 1;
    }
    return (words) as s32;
}
fn is_digit_04(c: char) s32 {
    return ((c >= '0') && (c <= '9')) as s32;
}
fn is_letter_04(c: char) s32 {
    return ((((c >= 'a') && (c <= 'z'))) || (((c >= 'A') && (c <= 'Z')))) as s32;
}
fn main() s32 @public {
    var items: array[const ptr[char]; 4] = fixed[("PATH/99 vector field") as const ptr[char], ("OMEGA relay 123") as const ptr[char], ("delta route marker_5") as const ptr[char], ("STACK/MODE 204") as const ptr[char]];
    var total: s32 = 0;
    for var i: s32 = 0; i < 4; i += 1; {
        total += profile_line_04(items->[i]);
    }
    if scanned_lines_04 != 4 {
        return (1) as s32;
    }
    if total <= global_limit_04 {
        return (2) as s32;
    }
    if count_words_04(items->[0]) < 2 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn profile_line_04(text: const ptr[char]) s32 {
    var score: s32 = 0;
    for var i: s32 = 0; (text->[i] != '\0') && (i < 80); i += 1; {
        if (is_digit_04(text->[i])) != 0 {
            score += 1;
        } else if (text->[i] >= 'A') && (text->[i] <= 'Z') {
            score += 3;
        } else if text->[i] == '/' {
            score += 1;
        }
    }
    scanned_lines_04 += 1;
    return (score + count_words_04(text)) as s32;
}
