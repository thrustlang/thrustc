static matrix_bias_01: const s32 @public @extern("matrix_bias_01") = 2;
static mut visited_cells_01: s32 = 0;

fn fill_matrix_01(matrix: ptr[s32]) void {
    for var r: s32 = 0; r < 4; r += 1; {
        for var c: s32 = 0; c < 5; c += 1; {
            matrix->[((r) * 5) + (c)] = (r + 1) * (c + 2) + matrix_bias_01;
        }
    }
}
fn main() s32 @public {
    var matrix: array[array[s32; 5]; 4];
    fill_matrix_01(matrix[0][0]);
    var total: s32 = trace_band_01(matrix[0][0]);
    if visited_cells_01 != (20) as s32 {
        return (1) as s32;
    }
    if total <= 40 {
        return (2) as s32;
    }
    if (matrix[0][0])->[((0) * 5) + (0)] <= matrix_bias_01 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn trace_band_01(matrix: ptr[s32]) s32 {
    var total: s32 = 0;
    for var r: s32 = 0; r < 4; r += 1; {
        for var c: s32 = 0; c < 5; c += 1; {
            if (r + c) <= 10 {
                total += matrix->[((r) * 5) + (c)];
            }
            visited_cells_01 += 1;
        }
    }
    return (total) as s32;
}
