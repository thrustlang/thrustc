static guard_base_02: const s32 @public @extern("guard_base_02") = 6;
static mut guard_turns_02: s32 = 0;

fn main() s32 @public {
    var seq: array[s32; 9] = fixed[(-9) as s32, 7, 1, 11, 9, (-6) as s32, (-1) as s32, 0, 10];
    var state: s32 = 1;
    var score: s32 = 0;
    for var i: s32 = 0; i < 9; i += 1; {
        state = route_guard_02(state, seq->[i]);
        if state > 3 {
            score += state;
        } else {
            score += i;
        }
    }
    if guard_turns_02 != 9 {
        return (1) as s32;
    }
    if score != 34 {
        return (2) as s32;
    }
    return (0) as s32;
}
fn route_guard_02(state_param: s32, token: s32) s32 {
    var state: s32 = state_param;

    if state < 2 {
        if token > guard_base_02 {
            state += 2;
        } else if token < 0 {
            state += 1;
        } else {
            state += 3;
        }
    } else if state == 2 {
        state += token % 3;
    } else {
        state -= 1;
    }
    guard_turns_02 += 1;
    return (state) as s32;
}
