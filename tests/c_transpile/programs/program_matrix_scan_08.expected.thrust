static matrix_bias_08: const s32 @public @extern("matrix_bias_08") = 4;
static mut visited_cells_08: s32 = 0;

fn fill_matrix_08(matrix: ptr[s32]) void {
    for var r: s32 = 0; r < 3; r += 1; {
        for var c: s32 = 0; c < 7; c += 1; {
            matrix->[((r) * 7) + (c)] = (r + 4) * (c + 1) + matrix_bias_08;
        }
    }
}
fn main() s32 @public {
    var matrix: array[array[s32; 7]; 3];
    fill_matrix_08(ref matrix[0][0]);
    var total: s32 = trace_band_08(ref matrix[0][0]);
    if visited_cells_08 != 3 * 7 {
        return (1) as s32;
    }
    if total <= 65 {
        return (2) as s32;
    }
    if (ref matrix[0][0])->[((2) * 7) + (6)] <= matrix_bias_08 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn trace_band_08(matrix: ptr[s32]) s32 {
    var total: s32 = 0;
    for var r: s32 = 0; r < 3; r += 1; {
        for var c: s32 = 0; c < 7; c += 1; {
            if (r + c) <= 6 {
                total += matrix->[((r) * 7) + (c)];
            }
            visited_cells_08 += 1;
        }
    }
    return (total) as s32;
}
