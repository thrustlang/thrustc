static mut rejected_06: s32 = 0;
static required_mask_06: const s32 @public @extern("required_mask_06") = 4;

fn apply_flags_06(current: s32, extra: s32) s32 {
    var merged: s32 = current | extra;
    if (merged & 2) != 0 {
        merged ^= 2;
        merged |= 4;
    }
    return (merged) as s32;
}
fn main() s32 @public {
    var entries: array[s32; 6] = fixed[2, (3) as s32, 4, 0, 1, (5) as s32];
    var accepted: s32 = validate_flags_06(entries as ptr[s32]);
    if accepted < 4 {
        return (1) as s32;
    }
    if rejected_06 <= 0 {
        return (2) as s32;
    }
    if (apply_flags_06(2, 0) & 4) == 0 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn validate_flags_06(entries: const ptr[s32]) s32 {
    var accepted: s32 = 0;
    for var i: s32 = 0; i < 6; i += 1; {
        var merged: s32 = apply_flags_06(entries->[i], 0);
        if (merged & required_mask_06) == required_mask_06 {
            accepted += 1;
        } else {
            rejected_06 += 1;
        }
    }
    return (accepted) as s32;
}
