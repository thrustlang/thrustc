static mut stride_steps_01: s32 = 0;

fn main() s32 @public {
    var left: array[s32; 7] = fixed[2, -7, -6, 4, 9, 4, 11];
    var right: array[s32; 7] = fixed[-2, 11, -2, 6, 7, -6, 2];
    var out: array[s32; 7] = fixed[0, 0, 0, 0, 0, 0, 0];
    var total: s32 = stride_merge_01(out as ptr[s32], left as ptr[s32], right as ptr[s32], 7);
    if stride_steps_01 != 7 {
        return (1) as s32;
    }
    if out->[3] != 1 {
        return (2) as s32;
    }
    if total != 22 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn stride_merge_01(dst: ptr[s32], left: const ptr[s32], right: const ptr[s32], n: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < n; i += 1; {
        var lv: s32 = left->[i];
        var rv: s32 = right->[(n - 1 - i)];
        dst->[i] = lv - rv + i;
        total += dst->[i];
        stride_steps_01 += 1;
    }
    return (total) as s32;
}
