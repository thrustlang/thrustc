static base_bias_04: const s32 @public @extern("base_bias_04") = 4;
static mut reductions_04: s32 = 0;

fn fold_all_04(pairs: ptr[s32]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 8; i += 1; {
        var local: s32 = fold_pair_04(pairs->[((i) * 2) + (0)], pairs->[((i) * 2) + (1)]);
        if (local % 4) == 0 {
            total += local / 2;
        } else {
            total += local + 1;
        }
    }
    return (total) as s32;
}
fn fold_pair_04(left: s32, right: s32) s32 {
    var common: s32 = gcd_04(left + 2, right + 2);
    var score: s32 = (left * 2) + right + base_bias_04;
    reductions_04 += 1;
    return (score - common) as s32;
}
fn gcd_04(a_param: s32, b_param: s32) s32 {
    var a: s32 = a_param;
    var b: s32 = b_param;

    while b != 0 {
        var next: s32 = a % b;
        a = b;
        b = next;
    }
    if a < 0 {
        return ((-a) as s32) as s32;
    } else {
        return (a) as s32;
    }
}
fn main() s32 @public {
    var pairs: array[array[s32; 2]; 8] = fixed[fixed[2, 9], fixed[5, 8], fixed[7, 4], fixed[11, 6], fixed[4, 10], fixed[8, 3], fixed[6, 12], fixed[9, 5]];
    var total: s32 = fold_all_04(pairs[0][0]);
    var guard: s32 = gcd_04(total, (57) as s32);
    if reductions_04 != 8 {
        return (1) as s32;
    }
    if total <= 44 {
        return (2) as s32;
    }
    if guard <= 0 {
        return (3) as s32;
    }
    return (0) as s32;
}
