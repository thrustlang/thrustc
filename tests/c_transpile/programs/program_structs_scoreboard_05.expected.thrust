struct Player05 {
    id: s32,
    score: s32,
    bonus: s32,
}

static base_reward_05: const s32 @public @extern("base_reward_05") = 5;
static mut updates_05: s32 = 0;

fn apply_round_05(player: ptr[Player05], delta: s32) void {
    player->bonus = clamp_bonus_05(player->bonus + (delta % 3));
    player->score += delta + player->bonus + base_reward_05;
    updates_05 += 1;
}
fn clamp_bonus_05(value: s32) s32 {
    if value < 0 {
        return (0) as s32;
    }
    if value > 6 {
        return (6) as s32;
    }
    return (value) as s32;
}
fn main() s32 @public {
    var players: array[Player05; 5] = fixed[new Player05 { id: 1, score: 9, bonus: 2 }, new Player05 { id: 2, score: 11, bonus: 1 }, new Player05 { id: 3, score: 10, bonus: 0 }, new Player05 { id: 4, score: 8, bonus: 3 }, new Player05 { id: 5, score: 12, bonus: 2 }];
    var deltas: array[s32; 5] = fixed[6, 2, 5, 4, 3];
    var best: s32 = 0;
    for var i: s32 = 0; i < 5; i += 1; {
        apply_round_05(players[i], deltas->[i]);
        if players[i]->score > best {
            best = players[i]->score;
        }
    }
    if updates_05 != 5 {
        return (1) as s32;
    }
    if best <= 13 {
        return (2) as s32;
    }
    if total_score_05(players[0]) <= 78 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn total_score_05(players: ptr[Player05]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 5; i += 1; {
        total += players[i]->score;
    }
    return (total) as s32;
}
