static global_offset_04: const s32 @public @extern("global_offset_04") = 3;
static mut processed_windows_04: s32 = 0;

fn count_peaks_04(values: const ptr[s32]) s32 {
    var peaks: s32 = 0;
    for var i: s32 = 1; i + 1 < 14; i += 1; {
        if (values->[i] >= values->[i - 1]) && (values->[i] >= values->[i + 1]) {
            peaks += 1;
        }
    }
    return (peaks) as s32;
}
fn main() s32 @public {
    var raw: array[s32; 14] = fixed[4, (-5) as s32, 2, 7, 3, 8, (-2) as s32, 6, 1, 9, 5, (-1) as s32, 4, 7];
    var cooked: array[s32; 14];
    var best: s32 = 0;
    var score: s32 = 0;
    for var i: s32 = 0; i < 14; i += 1; {
        cooked->[i] = normalize_04(raw->[i]);
        if (i % 4) == 1 {
            cooked->[i] += 2;
        }
    }
    for var i: s32 = 0; i + 5 <= 14; i += 1; {
        var current: s32 = sliding_sum_04(cooked as ptr[s32], i);
        if current > best {
            best = current;
        }
        if current >= 26 {
            score += 2;
        }
    }
    score += count_peaks_04(cooked as ptr[s32]);
    if processed_windows_04 != (10) as s32 {
        return (1) as s32;
    }
    if best <= 26 {
        return (2) as s32;
    }
    if score < 8 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn normalize_04(value: s32) s32 {
    if value < 0 {
        return ((-value) as s32 + global_offset_04 + 1) as s32;
    }
    return (value + global_offset_04) as s32;
}
fn sliding_sum_04(values: const ptr[s32], start: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 5; i += 1; {
        total += values->[start + i];
    }
    processed_windows_04 += 1;
    return (total) as s32;
}
