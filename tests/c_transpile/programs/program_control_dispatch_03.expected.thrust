static mut branch_hits_03: s32 = 0;
static global_seed_03: const s32 @public @extern("global_seed_03") = 5;

fn dispatch_03(mode: s32, value: s32) s32 {
    if mode == 1 {
        branch_hits_03 += 1;
        return (value + global_seed_03) as s32;
    } else if mode == 2 {
        branch_hits_03 += 1;
        return (value - 1) as s32;
    } else if mode == 3 {
        branch_hits_03 += 1;
        return ((value * 2) + 1) as s32;
    } else {
        return (value) as s32;
    }
}
fn main() s32 @public {
    var modes: array[s32; 8] = fixed[1, 2, 3, 1, 2, 3, 1, 3];
    var values: array[s32; 8] = fixed[6, 4, 7, 5, 3, 8, 2, 9];
    var total: s32 = run_control_03(modes as ptr[s32], values as ptr[s32]);
    if branch_hits_03 != 8 {
        return (1) as s32;
    }
    if total <= 25 {
        return (2) as s32;
    }
    if dispatch_03(3, 2) <= 2 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn run_control_03(modes: const ptr[s32], values: const ptr[s32]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 8; i += 1; {
        var current: s32 = dispatch_03(modes->[i], values->[i]);
        if (current & 1) == 0 {
            total += current / 2;
        } else {
            total += current;
        }
        if total > 45 {
            total -= 4;
        }
    }
    return (total) as s32;
}
