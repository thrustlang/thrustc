static flux_anchor_02: const s32 @public @extern("flux_anchor_02") = 5;
static mut flux_visits_02: s32 = 0;

fn fold_flux_02(values: const ptr[s32], start: s32, count: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = start; i < start + count; i += 1; {
        var sample: s32 = values->[i];
        if (i % 2) == 0 {
            total += sample + flux_anchor_02;
        } else {
            total += sample - 4;
        }
        flux_visits_02 += 1;
    }
    return (total) as s32;
}
fn main() s32 @public {
    var data: array[s32; 10] = fixed[7, 10, 4, -2, -5, -5, -1, 6, -5, 11];
    var left: s32 = fold_flux_02(data as ptr[s32], 0, 6);
    var right: s32 = fold_flux_02(data as ptr[s32], 3, 7);
    var mixed: s32 = left + right;
    if flux_visits_02 != 13 {
        return (1) as s32;
    }
    if mixed != 10 {
        return (2) as s32;
    }
    return (0) as s32;
}
