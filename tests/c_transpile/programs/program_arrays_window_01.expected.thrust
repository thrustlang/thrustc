static global_offset_01: const s32 @public @extern("global_offset_01") = 5;
static mut processed_windows_01: s32 = 0;

fn count_peaks_01(values: const ptr[s32]) s32 {
    var peaks: s32 = 0;
    for var i: s32 = 1; i + 1 < 12; i += 1; {
        if (values->[i] > values->[i - 1]) && (values->[i] >= values->[i + 1]) {
            peaks += 1;
        }
    }
    return (peaks) as s32;
}
fn main() s32 @public {
    var raw: array[s32; 12] = fixed[2, -3, 5, 7, 1, 4, -2, 6, 3, 8, -1, 5];
    var cooked: array[s32; 12];
    var best: s32 = 0;
    var score: s32 = 0;
    for var i: s32 = 0; i < 12; i += 1; {
        cooked->[i] = normalize_01(raw->[i]);
        if (i % 2) == 0 {
            cooked->[i] += 2;
        }
    }
    for var i: s32 = 0; i + 3 <= 12; i += 1; {
        var current: s32 = sliding_sum_01(cooked as ptr[s32], i);
        if current > best {
            best = current;
        }
        if current >= 14 {
            score += 1;
        }
    }
    score += count_peaks_01(cooked as ptr[s32]);
    if processed_windows_01 != 12 - 3 + 1 {
        return (1) as s32;
    }
    if best <= 14 {
        return (2) as s32;
    }
    if score < 5 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn normalize_01(value: s32) s32 {
    if value < 0 {
        return (-value + global_offset_01) as s32;
    }
    return (value + global_offset_01) as s32;
}
fn sliding_sum_01(values: const ptr[s32], start: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 3; i += 1; {
        total += values->[start + i];
    }
    processed_windows_01 += 1;
    return (total) as s32;
}
