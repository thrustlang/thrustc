static mut branch_hits_06: s32 = 0;
static global_seed_06: const s32 @public @extern("global_seed_06") = 4;

fn dispatch_06(mode: s32, value: s32) s32 {
    if mode == 1 {
        branch_hits_06 += 1;
        return (value + global_seed_06) as s32;
    } else if mode == 2 {
        branch_hits_06 += 1;
        return (value - 1) as s32;
    } else if mode == 3 {
        branch_hits_06 += 1;
        return ((value * 3) - 2) as s32;
    } else {
        return (value) as s32;
    }
}
fn main() s32 @public {
    var modes: array[s32; 7] = fixed[2, 1, 3, 2, 1, 3, 1];
    var values: array[s32; 7] = fixed[8, 2, 6, 7, 3, 9, 4];
    var total: s32 = run_control_06(modes as ptr[s32], values as ptr[s32]);
    if branch_hits_06 != 7 {
        return (1) as s32;
    }
    if total <= 17 {
        return (2) as s32;
    }
    if dispatch_06(1, 0) != global_seed_06 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn run_control_06(modes: const ptr[s32], values: const ptr[s32]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 7; i += 1; {
        var current: s32 = dispatch_06(modes->[i], values->[i]);
        if (current % 3) == 0 {
            total += current / 3;
        } else {
            total += current;
        }
        if total > 32 {
            total -= 2;
        }
    }
    return (total) as s32;
}
