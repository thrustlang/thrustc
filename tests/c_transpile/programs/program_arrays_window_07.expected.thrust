static global_offset_07: const s32 @public @extern("global_offset_07") = 2;
static mut processed_windows_07: s32 = 0;

fn count_peaks_07(values: const ptr[s32]) s32 {
    var peaks: s32 = 0;
    for var i: s32 = 1; i + 1 < 12; i += 1; {
        if (values->[i] > values->[i - 1]) && (values->[i] > values->[i + 1]) {
            peaks += 1;
        }
    }
    return (peaks) as s32;
}
fn main() s32 @public {
    var raw: array[s32; 12] = fixed[7, -2, 5, 1, 8, -4, 6, 3, 9, -1, 4, 2];
    var cooked: array[s32; 12];
    var best: s32 = 0;
    var score: s32 = 0;
    for var i: s32 = 0; i < 12; i += 1; {
        cooked->[i] = normalize_07(raw->[i]);
        if (i & 1) == 0 {
            cooked->[i] += 3;
        }
    }
    for var i: s32 = 0; i + 4 <= 12; i += 1; {
        var current: s32 = sliding_sum_07(cooked as ptr[s32], i);
        if current > best {
            best = current;
        }
        if current >= 20 {
            score += 1;
        }
    }
    score += count_peaks_07(cooked as ptr[s32]);
    if processed_windows_07 != 12 - 4 + 1 {
        return (1) as s32;
    }
    if best <= 20 {
        return (2) as s32;
    }
    if score < 6 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn normalize_07(value: s32) s32 {
    if value < 0 {
        return (-value + global_offset_07 + 3) as s32;
    }
    return (value + global_offset_07) as s32;
}
fn sliding_sum_07(values: const ptr[s32], start: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 4; i += 1; {
        total += values->[start + i];
    }
    processed_windows_07 += 1;
    return (total) as s32;
}
