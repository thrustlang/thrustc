struct Record03 {
    key: s32,
    value: s32,
    active: s32,
}

static checksum_bias_03: const s32 @public @extern("checksum_bias_03") = 4;
static mut kept_records_03: s32 = 0;

fn filter_records_03(records: ptr[Record03]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 5; i += 1; {
        if ((records[i]->active) != 0) && (records[i]->value >= 8) {
            total += records[i]->key + records[i]->value + checksum_bias_03;
            kept_records_03 += 1;
        }
    }
    return (total) as s32;
}
fn main() s32 @public {
    var records: array[Record03; 5] = fixed[new Record03 { key: 1, value: 9, active: 1 }, new Record03 { key: 2, value: 12, active: 1 }, new Record03 { key: 3, value: 7, active: 0 }, new Record03 { key: 4, value: 8, active: 1 }, new Record03 { key: 5, value: 6, active: 1 }];
    var total: s32 = filter_records_03(records[0]);
    if kept_records_03 < 3 {
        return (1) as s32;
    }
    if total <= 20 {
        return (2) as s32;
    }
    if records[1]->value != 12 {
        return (3) as s32;
    }
    return (0) as s32;
}
