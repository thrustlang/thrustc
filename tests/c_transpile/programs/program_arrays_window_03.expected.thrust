static global_offset_03: const s32 @public @extern("global_offset_03") = 6;
static mut processed_windows_03: s32 = 0;

fn count_peaks_03(values: const ptr[s32]) s32 {
    var peaks: s32 = 0;
    for var i: s32 = 1; i + 1 < 11; i += 1; {
        if (values->[i] > values->[i - 1]) && (values->[i] > values->[i + 1]) {
            peaks += 1;
        }
    }
    return (peaks) as s32;
}
fn main() s32 @public {
    var raw: array[s32; 11] = fixed[3, (-2) as s32, 9, 1, 5, (-4) as s32, 7, 2, 6, (-1) as s32, 8];
    var cooked: array[s32; 11];
    var best: s32 = 0;
    var score: s32 = 0;
    for var i: s32 = 0; i < 11; i += 1; {
        cooked->[i] = normalize_03(raw->[i]);
        if (i & 1) != 0 {
            cooked->[i] += 3;
        }
    }
    for var i: s32 = 0; i + 3 <= 11; i += 1; {
        var current: s32 = sliding_sum_03(cooked as ptr[s32], i);
        if current > best {
            best = current;
        }
        if current >= 16 {
            score += 1;
        }
    }
    score += count_peaks_03(cooked as ptr[s32]);
    if processed_windows_03 != (9) as s32 {
        return (1) as s32;
    }
    if best <= 16 {
        return (2) as s32;
    }
    if score < 6 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn normalize_03(value: s32) s32 {
    if value < 0 {
        return (((-value) as s32 * 2) + global_offset_03) as s32;
    }
    return (value + global_offset_03) as s32;
}
fn sliding_sum_03(values: const ptr[s32], start: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 3; i += 1; {
        total += values->[start + i];
    }
    processed_windows_03 += 1;
    return (total) as s32;
}
