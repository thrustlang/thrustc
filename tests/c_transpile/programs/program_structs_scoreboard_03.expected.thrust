struct Player03 {
    id: s32,
    score: s32,
    bonus: s32,
}

static base_reward_03: const s32 @public @extern("base_reward_03") = 4;
static mut updates_03: s32 = 0;

fn apply_round_03(player: ptr[Player03], delta: s32) void {
    player->bonus = clamp_bonus_03(player->bonus + (delta % 5));
    player->score += delta + player->bonus + base_reward_03;
    updates_03 += 1;
}
fn clamp_bonus_03(value: s32) s32 {
    if value < 0 {
        return (0) as s32;
    }
    if value > 7 {
        return (7) as s32;
    }
    return (value) as s32;
}
fn main() s32 @public {
    var players: array[Player03; 5] = fixed[new Player03 { id: 1, score: 12, bonus: 1 }, new Player03 { id: 2, score: 10, bonus: 0 }, new Player03 { id: 3, score: 8, bonus: 2 }, new Player03 { id: 4, score: 14, bonus: 3 }, new Player03 { id: 5, score: 9, bonus: 1 }];
    var deltas: array[s32; 5] = fixed[5, 4, 3, 6, 2];
    var best: s32 = 0;
    for var i: s32 = 0; i < 5; i += 1; {
        apply_round_03(players[i], deltas->[i]);
        if players[i]->score > best {
            best = players[i]->score;
        }
    }
    if updates_03 != 5 {
        return (1) as s32;
    }
    if best <= 14 {
        return (2) as s32;
    }
    if total_score_03(players[0]) <= 80 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn total_score_03(players: ptr[Player03]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 5; i += 1; {
        total += players[i]->score;
    }
    return (total) as s32;
}
