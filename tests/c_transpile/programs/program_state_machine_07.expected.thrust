static finish_bonus_07: const s32 @public @extern("finish_bonus_07") = 6;
static mut transitions_07: s32 = 0;

fn advance_state_07(state: s32, token: s32) s32 {
    if state == 0 {
        transitions_07 += 1;
        if token > 1 {
            return (1) as s32;
        } else {
            return (0) as s32;
        }
    }
    if state == 1 {
        transitions_07 += 1;
        if token <= 1 {
            return (2) as s32;
        } else {
            return (1) as s32;
        }
    }
    transitions_07 += 1;
    if token >= 4 {
        return (1) as s32;
    } else {
        return (2) as s32;
    }
}
fn main() s32 @public {
    var inputs: array[s32; 9] = fixed[1, 3, 4, 1, 5, 0, 2, 4, 1];
    var state: s32 = 0;
    var score: s32 = 0;
    for var i: s32 = 0; i < 9; i += 1; {
        state = advance_state_07(state, inputs->[i]);
        score += state + inputs->[i];
        if state == 2 {
            score += finish_bonus_07;
        }
    }
    if transitions_07 != 9 {
        return (1) as s32;
    }
    if score <= 24 {
        return (2) as s32;
    }
    if state == 0 {
        return (3) as s32;
    }
    return (0) as s32;
}
