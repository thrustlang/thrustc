struct Player02 {
    id: s32,
    score: s32,
    bonus: s32,
}

static base_reward_02: const s32 @public @extern("base_reward_02") = 2;
static mut updates_02: s32 = 0;

fn apply_round_02(player: ptr[Player02], delta: s32) void {
    player->bonus = clamp_bonus_02(player->bonus + (delta % 3));
    player->score += delta + player->bonus + base_reward_02;
    updates_02 += 1;
}
fn clamp_bonus_02(value: s32) s32 {
    if value < 0 {
        return (0) as s32;
    }
    if value > 5 {
        return (5) as s32;
    }
    return (value) as s32;
}
fn main() s32 @public {
    var players: array[Player02; 6] = fixed[new Player02 { id: 1, score: 9, bonus: 0 }, new Player02 { id: 2, score: 13, bonus: 1 }, new Player02 { id: 3, score: 7, bonus: 2 }, new Player02 { id: 4, score: 11, bonus: 1 }, new Player02 { id: 5, score: 10, bonus: 3 }, new Player02 { id: 6, score: 8, bonus: 0 }];
    var deltas: array[s32; 6] = fixed[3, 5, 2, 4, 6, 1];
    var best: s32 = 0;
    for var i: s32 = 0; i < 6; i += 1; {
        apply_round_02(players[i], deltas->[i]);
        if players[i]->score > best {
            best = players[i]->score;
        }
    }
    if updates_02 != 6 {
        return (1) as s32;
    }
    if best <= 12 {
        return (2) as s32;
    }
    if total_score_02(players[0]) <= 75 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn total_score_02(players: ptr[Player02]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 6; i += 1; {
        total += players[i]->score;
    }
    return (total) as s32;
}
