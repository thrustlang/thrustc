static mut branch_hits_04: s32 = 0;
static global_seed_04: const s32 @public @extern("global_seed_04") = 2;

fn dispatch_04(mode: s32, value: s32) s32 {
    if mode == 1 {
        branch_hits_04 += 1;
        return (value + global_seed_04) as s32;
    } else if mode == 2 {
        branch_hits_04 += 1;
        return (value - 3) as s32;
    } else if mode == 3 {
        branch_hits_04 += 1;
        return ((value * 4) - global_seed_04) as s32;
    } else {
        return (value) as s32;
    }
}
fn main() s32 @public {
    var modes: array[s32; 6] = fixed[3, 2, 1, 3, 2, 1];
    var values: array[s32; 6] = fixed[5, 9, 2, 6, 7, 4];
    var total: s32 = run_control_04(modes as ptr[s32], values as ptr[s32]);
    if branch_hits_04 != 6 {
        return (1) as s32;
    }
    if total <= 18 {
        return (2) as s32;
    }
    if dispatch_04(1, 1) <= 1 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn run_control_04(modes: const ptr[s32], values: const ptr[s32]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 6; i += 1; {
        var current: s32 = dispatch_04(modes->[i], values->[i]);
        if (current % 4) == 0 {
            total += current / 2;
        } else {
            total += current;
        }
        if total > 30 {
            total -= 1;
        }
    }
    return (total) as s32;
}
