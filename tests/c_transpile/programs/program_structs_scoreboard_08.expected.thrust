struct Player08 {
    id: s32,
    score: s32,
    bonus: s32,
}

static base_reward_08: const s32 @public @extern("base_reward_08") = 2;
static mut updates_08: s32 = 0;

fn apply_round_08(player: ptr[Player08], delta: s32) void {
    player->bonus = clamp_bonus_08(player->bonus + (delta % 2));
    player->score += delta + player->bonus + base_reward_08;
    updates_08 += 1;
}
fn clamp_bonus_08(value: s32) s32 {
    if value < 0 {
        return (0) as s32;
    }
    if value > 4 {
        return (4) as s32;
    }
    return (value) as s32;
}
fn main() s32 @public {
    var players: array[Player08; 6] = fixed[new Player08 { id: 1, score: 7, bonus: 0 }, new Player08 { id: 2, score: 10, bonus: 1 }, new Player08 { id: 3, score: 12, bonus: 2 }, new Player08 { id: 4, score: 8, bonus: 1 }, new Player08 { id: 5, score: 11, bonus: 0 }, new Player08 { id: 6, score: 9, bonus: 3 }];
    var deltas: array[s32; 6] = fixed[2, 4, 5, 3, 6, 1];
    var best: s32 = 0;
    for var i: s32 = 0; i < 6; i += 1; {
        apply_round_08(players[i], deltas->[i]);
        if players[i]->score > best {
            best = players[i]->score;
        }
    }
    if updates_08 != 6 {
        return (1) as s32;
    }
    if best <= 11 {
        return (2) as s32;
    }
    if total_score_08(players[0]) <= 68 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn total_score_08(players: ptr[Player08]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 6; i += 1; {
        total += players[i]->score;
    }
    return (total) as s32;
}
