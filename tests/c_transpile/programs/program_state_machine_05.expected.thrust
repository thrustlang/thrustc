static finish_bonus_05: const s32 @public @extern("finish_bonus_05") = 5;
static mut transitions_05: s32 = 0;

fn advance_state_05(state: s32, token: s32) s32 {
    if state == 0 {
        transitions_05 += 1;
        if token > 2 {
            return (1) as s32;
        } else {
            return (0) as s32;
        }
    }
    if state == 1 {
        transitions_05 += 1;
        if token <= 1 {
            return (2) as s32;
        } else {
            return (1) as s32;
        }
    }
    transitions_05 += 1;
    if token > 4 {
        return (1) as s32;
    } else {
        return (2) as s32;
    }
}
fn main() s32 @public {
    var inputs: array[s32; 7] = fixed[3, 5, 2, 1, 6, 0, 4];
    var state: s32 = 0;
    var score: s32 = 0;
    for var i: s32 = 0; i < 7; i += 1; {
        state = advance_state_05(state, inputs->[i]);
        score += state + inputs->[i];
        if state == 2 {
            score += finish_bonus_05;
        }
    }
    if transitions_05 != 7 {
        return (1) as s32;
    }
    if score <= 19 {
        return (2) as s32;
    }
    if state == 0 {
        return (3) as s32;
    }
    return (0) as s32;
}
