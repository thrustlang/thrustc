static MODE_HALT_08: const s32 @public @extern("MODE_HALT_08") = 2;
static MODE_IDLE_08: const s32 @public @extern("MODE_IDLE_08") = 0;
static MODE_RUN_08: const s32 @public @extern("MODE_RUN_08") = 1;
static mut enum_turns_08: s32 = 0;

fn main() s32 @public {
    var tokens: array[s32; 8] = fixed[-9, 9, -4, 0, -2, 1, -9, 10];
    var mode: s32 = MODE_IDLE_08;
    var score: s32 = 0;
    for var i: s32 = 0; i < 8; i += 1; {
        mode = step_mode_08(mode, tokens->[i]);
        score += mode + tokens->[i];
    }
    if enum_turns_08 != 8 {
        return (1) as s32;
    }
    if score < -120 {
        return (2) as s32;
    }
    return (0) as s32;
}
fn step_mode_08(mode_param: s32, token: s32) s32 {
    var mode: s32 = mode_param;

    if mode == MODE_IDLE_08 {
        var thrust_temporary_0: s32;
        if (token > 0) {
            thrust_temporary_0 = MODE_RUN_08;
        } else {
            thrust_temporary_0 = MODE_HALT_08;
        }
        mode = thrust_temporary_0;
    } else if mode == MODE_RUN_08 {
        var thrust_temporary_1: s32;
        if (token % 3 == 0) {
            thrust_temporary_1 = MODE_HALT_08;
        } else {
            thrust_temporary_1 = MODE_RUN_08;
        }
        mode = thrust_temporary_1;
    } else {
        var thrust_temporary_2: s32;
        if (token < 0) {
            thrust_temporary_2 = MODE_IDLE_08;
        } else {
            thrust_temporary_2 = MODE_RUN_08;
        }
        mode = thrust_temporary_2;
    }
    enum_turns_08 += 1;
    return (mode) as s32;
}
