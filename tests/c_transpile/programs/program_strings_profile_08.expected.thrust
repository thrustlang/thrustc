static global_limit_08: const s32 @public @extern("global_limit_08") = 14;
static mut scanned_lines_08: s32 = 0;

fn count_words_08(text: const ptr[char]) s32 {
    var words: s32 = 0;
    var length: s32 = 0;
    for var i: s32 = 0; text->[i] != '\0'; i += 1; {
        if (is_letter_08(text->[i])) != 0 {
            length += 1;
        } else {
            if length >= 5 {
                words += 1;
            }
            length = 0;
        }
    }
    if length >= 5 {
        words += 1;
    }
    return (words) as s32;
}
fn is_digit_08(c: char) s32 {
    return ((c >= '0') && (c <= '9')) as s32;
}
fn is_letter_08(c: char) s32 {
    return ((((c >= 'a') && (c <= 'z'))) || (((c >= 'A') && (c <= 'Z')))) as s32;
}
fn main() s32 @public {
    var items: array[const ptr[char]; 4] = fixed[("alpha=20 vector route") as const ptr[char], ("MODE graph 812") as const ptr[char], ("quiet relay field_5") as const ptr[char], ("FINAL=PORT 100") as const ptr[char]];
    var total: s32 = 0;
    for var i: s32 = 0; i < 4; i += 1; {
        total += profile_line_08(items->[i]);
    }
    if scanned_lines_08 != 4 {
        return (1) as s32;
    }
    if total <= global_limit_08 {
        return (2) as s32;
    }
    if count_words_08(items->[0]) < 2 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn profile_line_08(text: const ptr[char]) s32 {
    var score: s32 = 0;
    for var i: s32 = 0; (text->[i] != '\0') && (i < 78); i += 1; {
        if (is_digit_08(text->[i])) != 0 {
            score += 1;
        } else if (text->[i] >= 'A') && (text->[i] <= 'Z') {
            score += 3;
        } else if text->[i] == '=' {
            score += 1;
        }
    }
    scanned_lines_08 += 1;
    return (score + count_words_08(text)) as s32;
}
