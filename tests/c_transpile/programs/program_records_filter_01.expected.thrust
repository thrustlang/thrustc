struct Record01 {
    key: s32,
    value: s32,
    active: s32,
}

static checksum_bias_01: const s32 @public @extern("checksum_bias_01") = 3;
static mut kept_records_01: s32 = 0;

fn filter_records_01(records: ptr[Record01]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 6; i += 1; {
        if ((records[i]->active) != 0) && (records[i]->value >= 7) {
            total += records[i]->key + records[i]->value + checksum_bias_01;
            kept_records_01 += 1;
        }
    }
    return (total) as s32;
}
fn main() s32 @public {
    var records: array[Record01; 6] = fixed[new Record01 { key: 1, value: 8, active: 1 }, new Record01 { key: 2, value: 5, active: 1 }, new Record01 { key: 3, value: 10, active: 0 }, new Record01 { key: 4, value: 9, active: 1 }, new Record01 { key: 5, value: 7, active: 1 }, new Record01 { key: 6, value: 6, active: 0 }];
    var total: s32 = filter_records_01(ref records[0]);
    if kept_records_01 < 3 {
        return (1) as s32;
    }
    if total <= 20 {
        return (2) as s32;
    }
    if records[0]->key != 1 {
        return (3) as s32;
    }
    return (0) as s32;
}
