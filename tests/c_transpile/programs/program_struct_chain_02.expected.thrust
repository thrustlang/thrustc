struct Chain_02 {
    left: s32,
    right: s32,
}

static mut chain_steps_02: s32 = 0;

fn eval_chain_02(items: ptr[Chain_02], n: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < n; i += 1; {
        items[i]->right += i;
        if items[i]->left > items[i]->right {
            total += items[i]->left - items[i]->right;
        } else {
            total += items[i]->right - items[i]->left;
        }
        chain_steps_02 += 1;
    }
    return (total) as s32;
}
fn main() s32 @public {
    var items: array[Chain_02; 6] = fixed[new Chain_02 { left: 11, right: 14 }, new Chain_02 { left: 4, right: 7 }, new Chain_02 { left: 5, right: 8 }, new Chain_02 { left: -7, right: -4 }, new Chain_02 { left: -9, right: -6 }, new Chain_02 { left: -2, right: 1 }];
    var score: s32 = eval_chain_02(ref items[0], 6);
    if chain_steps_02 != 6 {
        return (1) as s32;
    }
    if score != 33 {
        return (2) as s32;
    }
    return (0) as s32;
}
