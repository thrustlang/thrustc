static mut churn_moves_08: s32 = 0;

fn churn_once_08(data: ptr[s32], n: s32) s32 {
    var first: s32 = data->[0];
    for var i: s32 = 0; i + 1 < n; i += 1; {
        data->[i] = data->[i + 1] + (i % 2);
        churn_moves_08 += 1;
    }
    data->[n - 1] = first;
    return (data->[0] + data->[n - 1]) as s32;
}
fn main() s32 @public {
    var data: array[s32; 9] = fixed[(-1) as s32, 0, 7, 0, 12, 5, (-6) as s32, (-5) as s32, (-3) as s32];
    var score: s32 = 0;
    score += churn_once_08(data as ptr[s32], 9);
    score += churn_once_08(data as ptr[s32], 9);
    if churn_moves_08 != 16 {
        return (1) as s32;
    }
    if score != 7 {
        return (2) as s32;
    }
    return (0) as s32;
}
