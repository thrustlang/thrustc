struct Record08 {
    key: s32,
    value: s32,
    active: s32,
}

static checksum_bias_08: const s32 @public @extern("checksum_bias_08") = 4;
static mut kept_records_08: s32 = 0;

fn filter_records_08(records: ptr[Record08]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 7; i += 1; {
        if ((records[i]->active) != 0) && (records[i]->value >= 5) {
            total += records[i]->key + records[i]->value + checksum_bias_08;
            kept_records_08 += 1;
        }
    }
    return (total) as s32;
}
fn main() s32 @public {
    var records: array[Record08; 7] = fixed[new Record08 { key: 1, value: 5, active: 1 }, new Record08 { key: 2, value: 7, active: 0 }, new Record08 { key: 3, value: 6, active: 1 }, new Record08 { key: 4, value: 8, active: 1 }, new Record08 { key: 5, value: 4, active: 1 }, new Record08 { key: 6, value: 9, active: 1 }, new Record08 { key: 7, value: 10, active: 1 }];
    var total: s32 = filter_records_08(ref records[0]);
    if kept_records_08 < 5 {
        return (1) as s32;
    }
    if total <= 35 {
        return (2) as s32;
    }
    if records[0]->active != 1 {
        return (3) as s32;
    }
    return (0) as s32;
}
