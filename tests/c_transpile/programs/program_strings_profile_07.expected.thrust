}
fn is_letter_07(c: char) s32 {
    return (((((c) as s32 >= ('a') as s32) && ((c) as s32 <= ('z') as s32))) || ((((c) as s32 >= ('A') as s32) && ((c) as s32 <= ('Z') as s32)))) as s32;
}
fn main() s32 @public {
    var items: array[const ptr[char]; 4] = fixed[("grid+11 alpha lane") as const ptr[char], ("TRACE plus 454") as const ptr[char], ("quiet cell token_4") as const ptr[char], ("FINAL+STATE 700") as const ptr[char]];
