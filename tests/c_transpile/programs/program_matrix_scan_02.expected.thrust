static matrix_bias_02: const s32 @public @extern("matrix_bias_02") = 3;
static mut visited_cells_02: s32 = 0;

fn fill_matrix_02(matrix: ptr[s32]) void {
    for var r: s32 = 0; r < 5; r += 1; {
        for var c: s32 = 0; c < 4; c += 1; {
            matrix->[((r) * 4) + (c)] = (r + 2) * (c + 1) + matrix_bias_02;
        }
    }
}
fn main() s32 @public {
    var matrix: array[array[s32; 4]; 5];
    fill_matrix_02(ref matrix[0][0]);
    var total: s32 = trace_band_02(ref matrix[0][0]);
    if visited_cells_02 != 5 * 4 {
        return (1) as s32;
    }
    if total <= 45 {
        return (2) as s32;
    }
    if (ref matrix[0][0])->[((1) * 4) + (1)] <= matrix_bias_02 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn trace_band_02(matrix: ptr[s32]) s32 {
    var total: s32 = 0;
    for var r: s32 = 0; r < 5; r += 1; {
        for var c: s32 = 0; c < 4; c += 1; {
            if (r + c) <= 6 {
                total += matrix->[((r) * 4) + (c)];
            }
            visited_cells_02 += 1;
        }
    }
    return (total) as s32;
}
