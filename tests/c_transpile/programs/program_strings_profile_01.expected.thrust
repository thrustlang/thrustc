static global_limit_01: const s32 @public @extern("global_limit_01") = 18;
static mut scanned_lines_01: s32 = 0;

fn count_words_01(text: const ptr[char]) s32 {
    var words: s32 = 0;
    var length: s32 = 0;
    for var i: s32 = 0; (text->[i]) as s32 != ('\0') as s32; i += 1; {
        if (is_letter_01(text->[i])) != 0 {
            length += 1;
        } else {
            if length >= 3 {
                words += 1;
            }
            length = 0;
        }
    }
    if length >= 3 {
        words += 1;
    }
    return (words) as s32;
}
fn is_digit_01(c: char) s32 {
    return (((c) as s32 >= ('0') as s32) && ((c) as s32 <= ('9') as s32)) as s32;
}
fn is_letter_01(c: char) s32 {
    return (((((c) as s32 >= ('a') as s32) && ((c) as s32 <= ('z') as s32))) || ((((c) as s32 >= ('A') as s32) && ((c) as s32 <= ('Z') as s32)))) as s32;
}
fn main() s32 @public {
    var items: array[const ptr[char]; 4] = fixed[("Alpha_17 beta runner") as const ptr[char], ("delta99 GAMMA path") as const ptr[char], ("mini map token_3") as const ptr[char], ("Final_STAGE 2048") as const ptr[char]];
    var total: s32 = 0;
    for var i: s32 = 0; i < 4; i += 1; {
        total += profile_line_01(items->[i]);
    }
    if scanned_lines_01 != 4 {
        return (1) as s32;
    }
    if total <= global_limit_01 {
        return (2) as s32;
    }
    if count_words_01(items->[0]) < 2 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn profile_line_01(text: const ptr[char]) s32 {
    var score: s32 = 0;
    for var i: s32 = 0; ((text->[i]) as s32 != ('\0') as s32) && (i < 64); i += 1; {
        if (is_digit_01(text->[i])) != 0 {
            score += 2;
        } else if ((text->[i]) as s32 >= ('A') as s32) && ((text->[i]) as s32 <= ('Z') as s32) {
            score += 1;
        } else if (text->[i]) as s32 == ('_') as s32 {
            score += 1;
        }
    }
    scanned_lines_01 += 1;
    return (score + count_words_01(text)) as s32;
}
