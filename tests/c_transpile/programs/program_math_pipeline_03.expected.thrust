static base_bias_03: const s32 @public @extern("base_bias_03") = 6;
static mut reductions_03: s32 = 0;

fn fold_all_03(pairs: ptr[s32]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 6; i += 1; {
        var local: s32 = fold_pair_03(pairs->[((i) * 2) + (0)], pairs->[((i) * 2) + (1)]);
        if (local & 1) != 0 {
            total += local + 1;
        } else {
            total += local / 2;
        }
    }
    return (total) as s32;
}
fn fold_pair_03(left: s32, right: s32) s32 {
    var common: s32 = gcd_03(left + 1, right + 1);
    var score: s32 = (left * 4) + right + base_bias_03;
    reductions_03 += 1;
    return (score - common) as s32;
}
fn gcd_03(a_param: s32, b_param: s32) s32 {
    var a: s32 = a_param;
    var b: s32 = b_param;

    while b != 0 {
        var next: s32 = a % b;
        a = b;
        b = next;
    }
    if a < 0 {
        return ((-a) as s32) as s32;
    } else {
        return (a) as s32;
    }
}
fn main() s32 @public {
    var pairs: array[array[s32; 2]; 6] = fixed[fixed[5, 11], fixed[7, 9], fixed[4, 13], fixed[8, 6], fixed[10, 3], fixed[6, 12]];
    var total: s32 = fold_all_03(pairs[0][0]);
    var guard: s32 = gcd_03(total, (57) as s32);
    if reductions_03 != 6 {
        return (1) as s32;
    }
    if total <= 52 {
        return (2) as s32;
    }
    if guard <= 0 {
        return (3) as s32;
    }
    return (0) as s32;
}
