static mut churn_moves_04: s32 = 0;

fn churn_once_04(data: ptr[s32], n: s32) s32 {
    var first: s32 = data->[0];
    for var i: s32 = 0; i + 1 < n; i += 1; {
        data->[i] = data->[i + 1] + (i % 2);
        churn_moves_04 += 1;
    }
    data->[n - 1] = first;
    return (data->[0] + data->[n - 1]) as s32;
}
fn main() s32 @public {
    var data: array[s32; 9] = fixed[(-5) as s32, 10, (-6) as s32, (-2) as s32, (-3) as s32, (-3) as s32, 2, (-7) as s32, 12];
    var score: s32 = 0;
    score += churn_once_04(data as ptr[s32], 9);
    score += churn_once_04(data as ptr[s32], 9);
    if churn_moves_04 != 16 {
        return (1) as s32;
    }
    if score != 10 {
        return (2) as s32;
    }
    return (0) as s32;
}
