static finish_bonus_06: const s32 @public @extern("finish_bonus_06") = 4;
static mut transitions_06: s32 = 0;

fn advance_state_06(state: s32, token: s32) s32 {
    if state == 0 {
        transitions_06 += 1;
        if token >= 2 {
            return (1) as s32;
        } else {
            return (0) as s32;
        }
    }
    if state == 1 {
        transitions_06 += 1;
        if token == 0 {
            return (2) as s32;
        } else {
            return (1) as s32;
        }
    }
    transitions_06 += 1;
    if token >= 5 {
        return (1) as s32;
    } else {
        return (2) as s32;
    }
}
fn main() s32 @public {
    var inputs: array[s32; 8] = fixed[2, 4, 6, 0, 3, 5, 0, 1];
    var state: s32 = 0;
    var score: s32 = 0;
    for var i: s32 = 0; i < 8; i += 1; {
        state = advance_state_06(state, inputs->[i]);
        score += state + inputs->[i];
        if state == 2 {
            score += finish_bonus_06;
        }
    }
    if transitions_06 != 8 {
        return (1) as s32;
    }
    if score <= 22 {
        return (2) as s32;
    }
    if state == 0 {
        return (3) as s32;
    }
    return (0) as s32;
}
