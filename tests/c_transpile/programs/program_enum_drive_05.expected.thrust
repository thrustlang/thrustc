static MODE_HALT_05: const s32 @public @extern("MODE_HALT_05") = 2;
static MODE_IDLE_05: const s32 @public @extern("MODE_IDLE_05") = 0;
static MODE_RUN_05: const s32 @public @extern("MODE_RUN_05") = 1;
static mut enum_turns_05: s32 = 0;

fn main() s32 @public {
    var tokens: array[s32; 8] = fixed[(-3) as s32, (-3) as s32, (-8) as s32, (-3) as s32, 5, 6, 1, (-1) as s32];
    var mode: s32 = MODE_IDLE_05;
    var score: s32 = 0;
    for var i: s32 = 0; i < 8; i += 1; {
        mode = step_mode_05(mode, tokens->[i]);
        score += mode + tokens->[i];
    }
    if enum_turns_05 != 8 {
        return (1) as s32;
    }
    if score < (-120) as s32 {
        return (2) as s32;
    }
    return (0) as s32;
}
fn step_mode_05(mode_param: s32, token: s32) s32 {
    var mode: s32 = mode_param;

    if mode == MODE_IDLE_05 {
        var thrust_temporary_0: s32;
        if (token > 0) {
            thrust_temporary_0 = MODE_RUN_05;
        } else {
            thrust_temporary_0 = MODE_HALT_05;
        }
        mode = thrust_temporary_0;
    } else if mode == MODE_RUN_05 {
        var thrust_temporary_1: s32;
        if (token % 3 == 0) {
            thrust_temporary_1 = MODE_HALT_05;
        } else {
            thrust_temporary_1 = MODE_RUN_05;
        }
        mode = thrust_temporary_1;
    } else {
        var thrust_temporary_2: s32;
        if (token < 0) {
            thrust_temporary_2 = MODE_IDLE_05;
        } else {
            thrust_temporary_2 = MODE_RUN_05;
        }
        mode = thrust_temporary_2;
    }
    enum_turns_05 += 1;
    return (mode) as s32;
}
