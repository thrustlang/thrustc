static mut rejected_02: s32 = 0;
static required_mask_02: const s32 @public @extern("required_mask_02") = (1 | 4) as const s32;

fn apply_flags_02(current: s32, extra: s32) s32 {
    var merged: s32 = current | extra;
    if (merged & 2) != 0 {
        merged ^= 2;
        merged |= 4;
    }
    return (merged) as s32;
}
fn main() s32 @public {
    var entries: array[s32; 5] = fixed[0, 2, 4, 1, 1 | 2];
    var accepted: s32 = validate_flags_02(entries as ptr[s32]);
    if accepted < 2 {
        return (1) as s32;
    }
    if rejected_02 <= 0 {
        return (2) as s32;
    }
    if (apply_flags_02(2, 0) & 4) == 0 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn validate_flags_02(entries: const ptr[s32]) s32 {
    var accepted: s32 = 0;
    for var i: s32 = 0; i < 5; i += 1; {
        var merged: s32 = apply_flags_02(entries->[i], 1);
        if (merged & required_mask_02) == required_mask_02 {
            accepted += 1;
        } else {
            rejected_02 += 1;
        }
    }
    return (accepted) as s32;
}
