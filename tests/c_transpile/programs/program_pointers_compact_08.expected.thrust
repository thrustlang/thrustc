static mut moved_items_08: s32 = 0;
static pointer_floor_08: const s32 @public @extern("pointer_floor_08") = 23;

fn compact_positive_08(input: const ptr[s32], output: ptr[s32]) s32 {
    var count: s32 = 0;
    for var i: s32 = 0; i < 9; i += 1; {
        if input->[i] >= 1 {
            output->[count] = input->[i] + 5;
            count += 1;
            moved_items_08 += 1;
        }
    }
    return (count) as s32;
}
fn main() s32 @public {
    var input: array[s32; 9] = fixed[1, 3, -1, 5, 7, 2, 6, 4, 8];
    var output: array[s32; 9] = fixed[0, 0, 0, 0, 0, 0, 0, 0, 0];
    var count: s32 = compact_positive_08(input as ptr[s32], output as ptr[s32]);
    var total: s32 = sum_items_08(output as ptr[s32], count);
    if count < 3 {
        return (1) as s32;
    }
    if moved_items_08 != count {
        return (2) as s32;
    }
    if total <= pointer_floor_08 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn sum_items_08(values: const ptr[s32], count: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < count; i += 1; {
        total += values->[i];
    }
    return (total) as s32;
}
