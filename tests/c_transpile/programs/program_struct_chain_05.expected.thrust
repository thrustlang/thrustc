struct Chain_05 {
    left: s32,
    right: s32,
}

static mut chain_steps_05: s32 = 0;

fn eval_chain_05(items: ptr[Chain_05], n: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < n; i += 1; {
        items[i]->right += i;
        if items[i]->left > items[i]->right {
            total += items[i]->left - items[i]->right;
        } else {
            total += items[i]->right - items[i]->left;
        }
        chain_steps_05 += 1;
    }
    return (total) as s32;
}
fn main() s32 @public {
    var items: array[Chain_05; 6] = fixed[new Chain_05 { left: -2, right: 0 }, new Chain_05 { left: 9, right: 11 }, new Chain_05 { left: 9, right: 11 }, new Chain_05 { left: -6, right: -4 }, new Chain_05 { left: -5, right: -3 }, new Chain_05 { left: 0, right: 2 }];
    var score: s32 = eval_chain_05(ref items[0], 6);
    if chain_steps_05 != 6 {
        return (1) as s32;
    }
    if score != 27 {
        return (2) as s32;
    }
    return (0) as s32;
}
