static mut rejected_03: s32 = 0;
static required_mask_03: const s32 @public @extern("required_mask_03") = 4;

fn apply_flags_03(current: s32, extra: s32) s32 {
    var merged: s32 = current | extra;
    if (merged & 2) != 0 {
        merged ^= 2;
        merged |= 4;
    }
    return (merged) as s32;
}
fn main() s32 @public {
    var entries: array[s32; 7] = fixed[2, 1, 4, 1 | 2, 0, 4, 2];
    var accepted: s32 = validate_flags_03(entries as ptr[s32]);
    if accepted < 4 {
        return (1) as s32;
    }
    if rejected_03 <= 0 {
        return (2) as s32;
    }
    if apply_flags_03(1, 4) != (1 | 4) {
        return (3) as s32;
    }
    return (0) as s32;
}
fn validate_flags_03(entries: const ptr[s32]) s32 {
    var accepted: s32 = 0;
    for var i: s32 = 0; i < 7; i += 1; {
        var merged: s32 = apply_flags_03(entries->[i], 0);
        if (merged & required_mask_03) == required_mask_03 {
            accepted += 1;
        } else {
            rejected_03 += 1;
        }
    }
    return (accepted) as s32;
}
