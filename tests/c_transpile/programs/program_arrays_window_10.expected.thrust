static global_offset_10: const s32 @public @extern("global_offset_10") = 6;
static mut processed_windows_10: s32 = 0;

fn count_peaks_10(values: const ptr[s32]) s32 {
    var peaks: s32 = 0;
    for var i: s32 = 1; i + 1 < 13; i += 1; {
        if (values->[i] >= values->[i - 1]) && (values->[i] > values->[i + 1]) {
            peaks += 1;
        }
    }
    return (peaks) as s32;
}
fn main() s32 @public {
    var raw: array[s32; 13] = fixed[6, (-2) as s32, 1, 8, 4, (-5) as s32, 7, 3, 9, (-1) as s32, 5, 2, 6];
    var cooked: array[s32; 13];
    var best: s32 = 0;
    var score: s32 = 0;
    for var i: s32 = 0; i < 13; i += 1; {
        cooked->[i] = normalize_10(raw->[i]);
        if (i % 2) == 0 {
            cooked->[i] += 2;
        }
    }
    for var i: s32 = 0; i + 4 <= 13; i += 1; {
        var current: s32 = sliding_sum_10(cooked as ptr[s32], i);
        if current > best {
            best = current;
        }
        if current >= 23 {
            score += 2;
        }
    }
    score += count_peaks_10(cooked as ptr[s32]);
    if processed_windows_10 != (10) as s32 {
        return (1) as s32;
    }
    if best <= 23 {
        return (2) as s32;
    }
    if score < 8 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn normalize_10(value: s32) s32 {
    if value < 0 {
        return (((-value) as s32 * 2) + global_offset_10) as s32;
    }
    return (value + global_offset_10) as s32;
}
fn sliding_sum_10(values: const ptr[s32], start: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 4; i += 1; {
        total += values->[start + i];
    }
    processed_windows_10 += 1;
    return (total) as s32;
}
