static base_bias_06: const s32 @public @extern("base_bias_06") = 5;
static mut reductions_06: s32 = 0;

fn fold_all_06(pairs: ptr[s32]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 6; i += 1; {
        var local: s32 = fold_pair_06(pairs->[((i) * 2) + (0)], pairs->[((i) * 2) + (1)]);
        if (local % 5) == 0 {
            total += local / 5;
        } else {
            total += local + 1;
        }
    }
    return (total) as s32;
}
fn fold_pair_06(left: s32, right: s32) s32 {
    var common: s32 = gcd_06(left + 4, right + 4);
    var score: s32 = (left * 3) + right + base_bias_06;
    reductions_06 += 1;
    return (score - common) as s32;
}
fn gcd_06(a_param: s32, b_param: s32) s32 {
    var a: s32 = a_param;
    var b: s32 = b_param;

    while b != 0 {
        var next: s32 = a % b;
        a = b;
        b = next;
    }
    if a < 0 {
        return ((-a) as s32) as s32;
    } else {
        return (a) as s32;
    }
}
fn main() s32 @public {
    var pairs: array[array[s32; 2]; 6] = fixed[fixed[7, 6], fixed[5, 12], fixed[9, 8], fixed[4, 11], fixed[10, 7], fixed[6, 13]];
    var total: s32 = fold_all_06(pairs[0][0]);
    var guard: s32 = gcd_06(total, (60) as s32);
    if reductions_06 != 6 {
        return (1) as s32;
    }
    if total <= 43 {
        return (2) as s32;
    }
    if guard <= 0 {
        return (3) as s32;
    }
    return (0) as s32;
}
