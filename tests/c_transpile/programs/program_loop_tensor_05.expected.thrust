static mut loop_hits_05: s32 = 0;

fn main() s32 @public {
    var data: array[s32; 12] = fixed[(-3) as s32, 0, 4, 6, (-2) as s32, 10, (-3) as s32, 8, 3, 8, 4, (-7) as s32];
    var total: s32 = walk_tensor_05(data as ptr[s32]);
    if loop_hits_05 != 12 {
        return (1) as s32;
    }
    if total != 60 {
        return (2) as s32;
    }
    return (0) as s32;
}
fn walk_tensor_05(flat: ptr[s32]) s32 {
    var total: s32 = 0;
    for var row: s32 = 0; row < 3; row += 1; {
        for var col: s32 = 0; col < 4; col += 1; {
            var k: s32 = row * 4 + col;
            var v: s32 = flat->[k];
            if (v % 2) == 0 {
                total += v + row;
            } else {
                total -= v - col;
            }
            loop_hits_05 += 1;
        }
    }
    return (total) as s32;
}
