struct Chain_08 {
    left: s32,
    right: s32,
}

static mut chain_steps_08: s32 = 0;

fn eval_chain_08(items: ptr[Chain_08], n: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < n; i += 1; {
        items[i]->right += i;
        if items[i]->left > items[i]->right {
            total += items[i]->left - items[i]->right;
        } else {
            total += items[i]->right - items[i]->left;
        }
        chain_steps_08 += 1;
    }
    return (total) as s32;
}
fn main() s32 @public {
    var items: array[Chain_08; 6] = fixed[new Chain_08 { left: 7, right: 8 }, new Chain_08 { left: (-6) as s32, right: (-5) as s32 }, new Chain_08 { left: (-1) as s32, right: 0 }, new Chain_08 { left: 1, right: 2 }, new Chain_08 { left: (-6) as s32, right: (-5) as s32 }, new Chain_08 { left: (-8) as s32, right: (-7) as s32 }];
    var score: s32 = eval_chain_08(items[0], 6);
    if chain_steps_08 != 6 {
        return (1) as s32;
    }
    if score != 21 {
        return (2) as s32;
    }
    return (0) as s32;
}
