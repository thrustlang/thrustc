static MODE_HALT_06: const s32 @public @extern("MODE_HALT_06") = 2;
static MODE_IDLE_06: const s32 @public @extern("MODE_IDLE_06") = 0;
static MODE_RUN_06: const s32 @public @extern("MODE_RUN_06") = 1;
static mut enum_turns_06: s32 = 0;

fn main() s32 @public {
    var tokens: array[s32; 8] = fixed[(-4) as s32, 12, 11, (-5) as s32, (-7) as s32, 7, (-4) as s32, (-4) as s32];
    var mode: s32 = MODE_IDLE_06;
    var score: s32 = 0;
    for var i: s32 = 0; i < 8; i += 1; {
        mode = step_mode_06(mode, tokens->[i]);
        score += mode + tokens->[i];
    }
    if enum_turns_06 != 8 {
        return (1) as s32;
    }
    if score < (-120) as s32 {
        return (2) as s32;
    }
    return (0) as s32;
}
fn step_mode_06(mode_param: s32, token: s32) s32 {
    var mode: s32 = mode_param;

    if mode == MODE_IDLE_06 {
        var thrust_temporary_0: s32;
        if (token > 0) {
            thrust_temporary_0 = MODE_RUN_06;
        } else {
            thrust_temporary_0 = MODE_HALT_06;
        }
        mode = thrust_temporary_0;
    } else if mode == MODE_RUN_06 {
        var thrust_temporary_1: s32;
        if (token % 3 == 0) {
            thrust_temporary_1 = MODE_HALT_06;
        } else {
            thrust_temporary_1 = MODE_RUN_06;
        }
        mode = thrust_temporary_1;
    } else {
        var thrust_temporary_2: s32;
        if (token < 0) {
            thrust_temporary_2 = MODE_IDLE_06;
        } else {
            thrust_temporary_2 = MODE_RUN_06;
        }
        mode = thrust_temporary_2;
    }
    enum_turns_06 += 1;
    return (mode) as s32;
}
