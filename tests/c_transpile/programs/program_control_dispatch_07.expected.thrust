static mut branch_hits_07: s32 = 0;
static global_seed_07: const s32 @public @extern("global_seed_07") = 3;

fn dispatch_07(mode: s32, value: s32) s32 {
    if mode == 1 {
        branch_hits_07 += 1;
        return (value + global_seed_07) as s32;
    } else if mode == 2 {
        branch_hits_07 += 1;
        return (value - 2) as s32;
    } else if mode == 3 {
        branch_hits_07 += 1;
        return ((value * 2) + global_seed_07) as s32;
    } else {
        return (value) as s32;
    }
}
fn main() s32 @public {
    var modes: array[s32; 8] = fixed[3, 1, 2, 3, 1, 2, 3, 1];
    var values: array[s32; 8] = fixed[4, 5, 7, 6, 2, 8, 3, 9];
    var total: s32 = run_control_07(modes as ptr[s32], values as ptr[s32]);
    if branch_hits_07 != 8 {
        return (1) as s32;
    }
    if total <= 19 {
        return (2) as s32;
    }
    if dispatch_07(3, 1) <= 1 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn run_control_07(modes: const ptr[s32], values: const ptr[s32]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 8; i += 1; {
        var current: s32 = dispatch_07(modes->[i], values->[i]);
        if (current % 5) == 0 {
            total += current / 5;
        } else {
            total += current;
        }
        if total > 44 {
            total -= 3;
        }
    }
    return (total) as s32;
}
