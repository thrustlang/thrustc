static base_bias_02: const s32 @public @extern("base_bias_02") = 5;
static mut reductions_02: s32 = 0;

fn fold_all_02(pairs: ptr[s32]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 7; i += 1; {
        var local: s32 = fold_pair_02(pairs->[((i) * 2) + (0)], pairs->[((i) * 2) + (1)]);
        if (local % 3) == 0 {
            total += local / 3;
        } else {
            total += local;
        }
    }
    return (total) as s32;
}
fn fold_pair_02(left: s32, right: s32) s32 {
    var common: s32 = gcd_02(left + 3, right + 3);
    var score: s32 = (left * 2) + right + base_bias_02;
    reductions_02 += 1;
    return (score - common) as s32;
}
fn gcd_02(a_param: s32, b_param: s32) s32 {
    var a: s32 = a_param;
    var b: s32 = b_param;

    while b != 0 {
        var next: s32 = a % b;
        a = b;
        b = next;
    }
    if a < 0 {
        return (-a) as s32;
    } else {
        return (a) as s32;
    }
}
fn main() s32 @public {
    var pairs: array[array[s32; 2]; 7] = fixed[fixed[3, 8], fixed[5, 7], fixed[9, 4], fixed[6, 10], fixed[8, 1], fixed[4, 12], fixed[7, 5]];
    var total: s32 = fold_all_02(ref pairs[0][0]);
    var guard: s32 = gcd_02(total, 36 + 11);
    if reductions_02 != 7 {
        return (1) as s32;
    }
    if total <= 36 {
        return (2) as s32;
    }
    if guard <= 0 {
        return (3) as s32;
    }
    return (0) as s32;
}
