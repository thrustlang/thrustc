}
fn is_digit_02(c: char) s32 {
    return (((c) as s32 >= ('0') as s32) && ((c) as s32 <= ('9') as s32)) as s32;
}
fn is_letter_02(c: char) s32 {
    return (((((c) as s32 >= ('a') as s32) && ((c) as s32 <= ('z') as s32))) || ((((c) as s32 >= ('A') as s32) && ((c) as s32 <= ('Z') as s32)))) as s32;
}
fn main() s32 @public {
    var items: array[const ptr[char]; 4] = fixed[("Render-88 signal route") as const ptr[char], ("MEGA lane alpha77") as const ptr[char], ("quiet branch field_9") as const ptr[char], ("Trace_MODE 512") as const ptr[char]];
