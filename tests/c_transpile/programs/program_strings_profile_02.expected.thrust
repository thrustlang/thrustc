static global_limit_02: const s32 @public @extern("global_limit_02") = 16;
static mut scanned_lines_02: s32 = 0;

fn count_words_02(text: const ptr[char]) s32 {
    var words: s32 = 0;
    var length: s32 = 0;
    for var i: s32 = 0; (text->[i]) as s32 != ('\0') as s32; i += 1; {
