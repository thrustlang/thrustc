struct Player09 {
    id: s32,
    score: s32,
    bonus: s32,
}

static base_reward_09: const s32 @public @extern("base_reward_09") = 4;
static mut updates_09: s32 = 0;

fn apply_round_09(player: ptr[Player09], delta: s32) void {
    player->bonus = clamp_bonus_09(player->bonus + (delta % 4));
    player->score += delta + player->bonus + base_reward_09;
    updates_09 += 1;
}
fn clamp_bonus_09(value: s32) s32 {
    if value < 0 {
        return (0) as s32;
    }
    if value > 6 {
        return (6) as s32;
    }
    return (value) as s32;
}
fn main() s32 @public {
    var players: array[Player09; 5] = fixed[new Player09 { id: 1, score: 10, bonus: 2 }, new Player09 { id: 2, score: 9, bonus: 1 }, new Player09 { id: 3, score: 13, bonus: 0 }, new Player09 { id: 4, score: 8, bonus: 3 }, new Player09 { id: 5, score: 12, bonus: 1 }];
    var deltas: array[s32; 5] = fixed[3, 6, 4, 2, 5];
    var best: s32 = 0;
    for var i: s32 = 0; i < 5; i += 1; {
        apply_round_09(ref players[i], deltas->[i]);
        if players[i]->score > best {
            best = players[i]->score;
        }
    }
    if updates_09 != 5 {
        return (1) as s32;
    }
    if best <= 13 {
        return (2) as s32;
    }
    if total_score_09(ref players[0]) <= 77 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn total_score_09(players: ptr[Player09]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 5; i += 1; {
        total += players[i]->score;
    }
    return (total) as s32;
}
