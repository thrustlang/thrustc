static global_limit_05: const s32 @public @extern("global_limit_05") = 19;
static mut scanned_lines_05: s32 = 0;

fn count_words_05(text: const ptr[char]) s32 {
    var words: s32 = 0;
    var length: s32 = 0;
    for var i: s32 = 0; (text->[i]) as s32 != ('\0') as s32; i += 1; {
        if (is_letter_05(text->[i])) != 0 {
            length += 1;
        } else {
            if length >= 4 {
                words += 1;
            }
            length = 0;
        }
    }
    if length >= 4 {
        words += 1;
    }
    return (words) as s32;
}
fn is_digit_05(c: char) s32 {
    return (((c) as s32 >= ('0') as s32) && ((c) as s32 <= ('9') as s32)) as s32;
}
fn is_letter_05(c: char) s32 {
    return (((((c) as s32 >= ('a') as s32) && ((c) as s32 <= ('z') as s32))) || ((((c) as s32 >= ('A') as s32) && ((c) as s32 <= ('Z') as s32)))) as s32;
}
fn main() s32 @public {
    var items: array[const ptr[char]; 4] = fixed[("node.31 alpha field") as const ptr[char], ("TRACE beam 222") as const ptr[char], ("inner path token_7") as const ptr[char], ("FINAL.LOG 600") as const ptr[char]];
    var total: s32 = 0;
