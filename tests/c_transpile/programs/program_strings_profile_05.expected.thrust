    return (0) as s32;
}
fn profile_line_05(text: const ptr[char]) s32 {
    var score: s32 = 0;
    for var i: s32 = 0; ((text->[i]) as s32 != ('\0') as s32) && (i < 66); i += 1; {
        if (is_digit_05(text->[i])) != 0 {
            score += 2;
        } else if ((text->[i]) as s32 >= ('A') as s32) && ((text->[i]) as s32 <= ('Z') as s32) {
            score += 1;
        } else if (text->[i]) as s32 == ('.') as s32 {
