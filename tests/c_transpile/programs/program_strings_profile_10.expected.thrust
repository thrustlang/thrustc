static global_limit_10: const s32 @public @extern("global_limit_10") = 18;
static mut scanned_lines_10: s32 = 0;

fn count_words_10(text: const ptr[char]) s32 {
    var words: s32 = 0;
    var length: s32 = 0;
    for var i: s32 = 0; text->[i] != '\0'; i += 1; {
        if (is_letter_10(text->[i])) != 0 {
            length += 1;
        } else {
            if length >= 4 {
                words += 1;
            }
            length = 0;
        }
    }
    if length >= 4 {
        words += 1;
    }
    return (words) as s32;
}
fn is_digit_10(c: char) s32 {
    return ((c >= '0') && (c <= '9')) as s32;
}
fn is_letter_10(c: char) s32 {
    return ((((c >= 'a') && (c <= 'z'))) || (((c >= 'A') && (c <= 'Z')))) as s32;
}
fn main() s32 @public {
    var items: array[const ptr[char]; 4] = fixed[("alpha%55 vector path") as const ptr[char], ("TRACE lane 404") as const ptr[char], ("minor route token_8") as const ptr[char], ("FINAL%GRID 808") as const ptr[char]];
    var total: s32 = 0;
    for var i: s32 = 0; i < 4; i += 1; {
        total += profile_line_10(items->[i]);
    }
    if scanned_lines_10 != 4 {
        return (1) as s32;
    }
    if total <= global_limit_10 {
        return (2) as s32;
    }
    if count_words_10(items->[2]) < 2 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn profile_line_10(text: const ptr[char]) s32 {
    var score: s32 = 0;
    for var i: s32 = 0; (text->[i] != '\0') && (i < 82); i += 1; {
        if (is_digit_10(text->[i])) != 0 {
            score += 1;
        } else if (text->[i] >= 'A') && (text->[i] <= 'Z') {
            score += 2;
        } else if text->[i] == '%' {
            score += 1;
        }
    }
    scanned_lines_10 += 1;
    return (score + count_words_10(text)) as s32;
}
