    }
    if total <= pointer_floor_09 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn sum_items_09(values: const ptr[s32], count: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < count; i += 1; {
        total += values->[i];
    }
    return (total) as s32;
}
