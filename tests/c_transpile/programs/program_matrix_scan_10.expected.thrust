static matrix_bias_10: const s32 @public @extern("matrix_bias_10") = 6;
static mut visited_cells_10: s32 = 0;

fn fill_matrix_10(matrix: ptr[s32]) void {
    for var r: s32 = 0; r < 4; r += 1; {
        for var c: s32 = 0; c < 5; c += 1; {
            matrix->[((r) * 5) + (c)] = (r + 1) * (c + 5) + matrix_bias_10;
        }
    }
}
fn main() s32 @public {
    var matrix: array[array[s32; 5]; 4];
    fill_matrix_10(ref matrix[0][0]);
    var total: s32 = trace_band_10(ref matrix[0][0]);
    if visited_cells_10 != 4 * 5 {
        return (1) as s32;
    }
    if total <= 80 {
        return (2) as s32;
    }
    if (ref matrix[0][0])->[((3) * 5) + (4)] <= matrix_bias_10 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn trace_band_10(matrix: ptr[s32]) s32 {
    var total: s32 = 0;
    for var r: s32 = 0; r < 4; r += 1; {
        for var c: s32 = 0; c < 5; c += 1; {
            if (r + c) <= 7 {
                total += matrix->[((r) * 5) + (c)];
            }
            visited_cells_10 += 1;
        }
    }
    return (total) as s32;
}
