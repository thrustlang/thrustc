static mut branch_hits_10: s32 = 0;
static global_seed_10: const s32 @public @extern("global_seed_10") = 4;

fn dispatch_10(mode: s32, value: s32) s32 {
    if mode == 1 {
        branch_hits_10 += 1;
        return (value + global_seed_10) as s32;
    } else if mode == 2 {
        branch_hits_10 += 1;
        return (value - 2) as s32;
    } else if mode == 3 {
        branch_hits_10 += 1;
        return ((value * 2) + 2) as s32;
    } else {
        return (value) as s32;
    }
}
fn main() s32 @public {
    var modes: array[s32; 7] = fixed[1, 2, 3, 1, 2, 3, 1];
    var values: array[s32; 7] = fixed[6, 8, 5, 4, 7, 3, 9];
    var total: s32 = run_control_10(modes as ptr[s32], values as ptr[s32]);
    if branch_hits_10 != 7 {
        return (1) as s32;
    }
    if total <= 17 {
        return (2) as s32;
    }
    if dispatch_10(3, 2) <= 2 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn run_control_10(modes: const ptr[s32], values: const ptr[s32]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 7; i += 1; {
        var current: s32 = dispatch_10(modes->[i], values->[i]);
        if (current & 1) == 0 {
            total += current / 2;
        } else {
            total += current;
        }
        if total > 34 {
            total -= 1;
        }
    }
    return (total) as s32;
}
