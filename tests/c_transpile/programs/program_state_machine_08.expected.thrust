static finish_bonus_08: const s32 @public @extern("finish_bonus_08") = 3;
static mut transitions_08: s32 = 0;

fn advance_state_08(state: s32, token: s32) s32 {
    if state == 0 {
        transitions_08 += 1;
        if token >= 4 {
            return (1) as s32;
        } else {
            return (0) as s32;
        }
    }
    if state == 1 {
        transitions_08 += 1;
        if token == 2 {
            return (2) as s32;
        } else {
            return (1) as s32;
        }
    }
    transitions_08 += 1;
    if token >= 5 {
        return (1) as s32;
    } else {
        return (2) as s32;
    }
}
fn main() s32 @public {
    var inputs: array[s32; 7] = fixed[4, 6, 2, 3, 5, 2, 1];
    var state: s32 = 0;
    var score: s32 = 0;
    for var i: s32 = 0; i < 7; i += 1; {
        state = advance_state_08(state, inputs->[i]);
        score += state + inputs->[i];
        if state == 2 {
            score += finish_bonus_08;
        }
    }
    if transitions_08 != 7 {
        return (1) as s32;
    }
    if score <= 17 {
        return (2) as s32;
    }
    if state == 0 {
        return (3) as s32;
    }
    return (0) as s32;
}
