static mut branch_hits_02: s32 = 0;

fn main() s32 @public {
    var values: array[s32; 10] = fixed[(-1) as s32, 11, 2, 11, (-5) as s32, 3, 1, 9, 9, (-2) as s32];
    var total: s32 = 0;
    for var i: s32 = 0; i < 10; i += 1; {
        total += mesh_eval_02(values->[i], i);
    }
    if branch_hits_02 != 10 {
        return (1) as s32;
    }
    if total != 47 {
        return (2) as s32;
    }
    return (0) as s32;
}
fn mesh_eval_02(value: s32, i: s32) s32 {
    var out: s32 = value;
    if (((value > 0) && (i % 2 == 0))) || (((value < 0) && (i % 3 == 0))) {
        out = value + i;
    } else if (value == 0) || (i == 5) {
        out = i - value;
    } else {
        out = value - i;
    }
    branch_hits_02 += 1;
    return (out) as s32;
}
