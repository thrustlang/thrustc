struct Player01 {
    id: s32,
    score: s32,
    bonus: s32,
}

static base_reward_01: const s32 @public @extern("base_reward_01") = 3;
static mut updates_01: s32 = 0;

fn apply_round_01(player: ptr[Player01], delta: s32) void {
    player->bonus = clamp_bonus_01(player->bonus + (delta % 4));
    player->score += delta + player->bonus + base_reward_01;
    updates_01 += 1;
}
fn clamp_bonus_01(value: s32) s32 {
    if value < 0 {
        return (0) as s32;
    }
    if value > 6 {
        return (6) as s32;
    }
    return (value) as s32;
}
fn main() s32 @public {
    var players: array[Player01; 5] = fixed[new Player01 { id: 1, score: 10, bonus: 1 }, new Player01 { id: 2, score: 8, bonus: 2 }, new Player01 { id: 3, score: 12, bonus: 0 }, new Player01 { id: 4, score: 7, bonus: 3 }, new Player01 { id: 5, score: 11, bonus: 1 }];
    var deltas: array[s32; 5] = fixed[4, 3, 5, 2, 6];
    var best: s32 = 0;
    for var i: s32 = 0; i < 5; i += 1; {
        apply_round_01(players[i], deltas->[i]);
        if players[i]->score > best {
            best = players[i]->score;
        }
    }
    if updates_01 != 5 {
        return (1) as s32;
    }
    if best <= 10 {
        return (2) as s32;
    }
    if total_score_01(players[0]) <= 70 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn total_score_01(players: ptr[Player01]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 5; i += 1; {
        total += players[i]->score;
    }
    return (total) as s32;
}
