static mut stride_steps_07: s32 = 0;

fn main() s32 @public {
    var left: array[s32; 7] = fixed[(-1) as s32, 0, (-5) as s32, 8, (-4) as s32, 1, 3];
    var right: array[s32; 7] = fixed[1, 11, (-5) as s32, 3, (-6) as s32, 7, (-4) as s32];
    var out: array[s32; 7] = fixed[0, 0, 0, 0, 0, 0, 0];
    var total: s32 = stride_merge_07(out as ptr[s32], left as ptr[s32], right as ptr[s32], 7);
    if stride_steps_07 != 7 {
        return (1) as s32;
    }
    if out->[3] != 8 {
        return (2) as s32;
    }
    if total != 16 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn stride_merge_07(dst: ptr[s32], left: const ptr[s32], right: const ptr[s32], n: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < n; i += 1; {
        var lv: s32 = left->[i];
        var rv: s32 = right->[(n - 1 - i)];
        dst->[i] = lv - rv + i;
        total += dst->[i];
        stride_steps_07 += 1;
    }
    return (total) as s32;
}
