static base_bias_08: const s32 @public @extern("base_bias_08") = 4;
static mut reductions_08: s32 = 0;

fn fold_all_08(pairs: ptr[s32]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 6; i += 1; {
        var local: s32 = fold_pair_08(pairs->[((i) * 2) + (0)], pairs->[((i) * 2) + (1)]);
        if (local % 3) == 0 {
            total += local / 3;
        } else {
            total += local + 2;
        }
    }
    return (total) as s32;
}
fn fold_pair_08(left: s32, right: s32) s32 {
    var common: s32 = gcd_08(left + 3, right + 3);
    var score: s32 = (left * 3) + right + base_bias_08;
    reductions_08 += 1;
    return (score - common) as s32;
}
fn gcd_08(a_param: s32, b_param: s32) s32 {
    var a: s32 = a_param;
    var b: s32 = b_param;

    while b != 0 {
        var next: s32 = a % b;
        a = b;
        b = next;
    }
    if a < 0 {
        return (-a) as s32;
    } else {
        return (a) as s32;
    }
}
fn main() s32 @public {
    var pairs: array[array[s32; 2]; 6] = fixed[fixed[5, 14], fixed[7, 8], fixed[9, 6], fixed[4, 13], fixed[10, 2], fixed[6, 12]];
    var total: s32 = fold_all_08(ref pairs[0][0]);
    var guard: s32 = gcd_08(total, 46 + 15);
    if reductions_08 != 6 {
        return (1) as s32;
    }
    if total <= 46 {
        return (2) as s32;
    }
    if guard <= 0 {
        return (3) as s32;
    }
    return (0) as s32;
}
