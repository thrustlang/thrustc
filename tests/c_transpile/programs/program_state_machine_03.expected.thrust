static finish_bonus_03: const s32 @public @extern("finish_bonus_03") = 6;
static mut transitions_03: s32 = 0;

fn advance_state_03(state: s32, token: s32) s32 {
    if state == 0 {
        transitions_03 += 1;
        if token > 1 {
            return (1) as s32;
        } else {
            return (0) as s32;
        }
    }
    if state == 1 {
        transitions_03 += 1;
        if token == 0 {
            return (2) as s32;
        } else {
            return (1) as s32;
        }
    }
    transitions_03 += 1;
    if token > 3 {
        return (1) as s32;
    } else {
        return (2) as s32;
    }
}
fn main() s32 @public {
    var inputs: array[s32; 9] = fixed[2, 4, 3, 0, 5, 1, 0, 4, 2];
    var state: s32 = 0;
    var score: s32 = 0;
    for var i: s32 = 0; i < 9; i += 1; {
        state = advance_state_03(state, inputs->[i]);
        score += state + inputs->[i];
        if state == 2 {
            score += finish_bonus_03;
        }
    }
    if transitions_03 != 9 {
        return (1) as s32;
    }
    if score <= 24 {
        return (2) as s32;
    }
    if state == 0 {
        return (3) as s32;
    }
    return (0) as s32;
}
