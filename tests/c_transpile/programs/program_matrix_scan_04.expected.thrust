static matrix_bias_04: const s32 @public @extern("matrix_bias_04") = 4;
static mut visited_cells_04: s32 = 0;

fn fill_matrix_04(matrix: ptr[s32]) void {
    for var r: s32 = 0; r < 6; r += 1; {
        for var c: s32 = 0; c < 3; c += 1; {
            matrix->[((r) * 3) + (c)] = (r + 1) * (c + 3) + matrix_bias_04;
        }
    }
}
fn main() s32 @public {
    var matrix: array[array[s32; 3]; 6];
    fill_matrix_04(matrix[0][0]);
    var total: s32 = trace_band_04(matrix[0][0]);
    if visited_cells_04 != (18) as s32 {
        return (1) as s32;
    }
    if total <= 42 {
        return (2) as s32;
    }
    if (matrix[0][0])->[((3) * 3) + (1)] <= matrix_bias_04 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn trace_band_04(matrix: ptr[s32]) s32 {
    var total: s32 = 0;
    for var r: s32 = 0; r < 6; r += 1; {
        for var c: s32 = 0; c < 3; c += 1; {
            if (r + c) <= 6 {
                total += matrix->[((r) * 3) + (c)];
            }
            visited_cells_04 += 1;
        }
    }
    return (total) as s32;
}
