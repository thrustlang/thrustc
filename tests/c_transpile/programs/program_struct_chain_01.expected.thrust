struct Chain_01 {
    left: s32,
    right: s32,
}

static mut chain_steps_01: s32 = 0;

fn eval_chain_01(items: ptr[Chain_01], n: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < n; i += 1; {
        items[i]->right += i;
        if items[i]->left > items[i]->right {
            total += items[i]->left - items[i]->right;
        } else {
            total += items[i]->right - items[i]->left;
        }
        chain_steps_01 += 1;
    }
    return (total) as s32;
}
fn main() s32 @public {
    var items: array[Chain_01; 6] = fixed[new Chain_01 { left: 4, right: 6 }, new Chain_01 { left: 12, right: 14 }, new Chain_01 { left: -5, right: -3 }, new Chain_01 { left: 4, right: 6 }, new Chain_01 { left: -3, right: -1 }, new Chain_01 { left: 6, right: 8 }];
    var score: s32 = eval_chain_01(ref items[0], 6);
    if chain_steps_01 != 6 {
        return (1) as s32;
    }
    if score != 27 {
        return (2) as s32;
    }
    return (0) as s32;
}
