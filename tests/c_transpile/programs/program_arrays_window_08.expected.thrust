static global_offset_08: const s32 @public @extern("global_offset_08") = 3;
static mut processed_windows_08: s32 = 0;

fn count_peaks_08(values: const ptr[s32]) s32 {
    var peaks: s32 = 0;
    for var i: s32 = 1; i + 1 < 16; i += 1; {
        if (values->[i] >= values->[i - 1]) && (values->[i] >= values->[i + 1]) {
            peaks += 1;
        }
    }
    return (peaks) as s32;
}
fn main() s32 @public {
    var raw: array[s32; 16] = fixed[2, -3, 6, 4, 8, -1, 7, 5, 9, -2, 3, 6, 8, -4, 5, 7];
    var cooked: array[s32; 16];
    var best: s32 = 0;
    var score: s32 = 0;
    for var i: s32 = 0; i < 16; i += 1; {
        cooked->[i] = normalize_08(raw->[i]);
        if (i % 3) == 1 {
            cooked->[i] += 2;
        }
    }
    for var i: s32 = 0; i + 6 <= 16; i += 1; {
        var current: s32 = sliding_sum_08(cooked as ptr[s32], i);
        if current > best {
            best = current;
        }
        if current >= 34 {
            score += 2;
        }
    }
    score += count_peaks_08(cooked as ptr[s32]);
    if processed_windows_08 != 16 - 6 + 1 {
        return (1) as s32;
    }
    if best <= 34 {
        return (2) as s32;
    }
    if score < 10 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn normalize_08(value: s32) s32 {
    if value < 0 {
        return ((-value * 2) + global_offset_08) as s32;
    }
    return (value + global_offset_08 + 1) as s32;
}
fn sliding_sum_08(values: const ptr[s32], start: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 6; i += 1; {
        total += values->[start + i];
    }
    processed_windows_08 += 1;
    return (total) as s32;
}
