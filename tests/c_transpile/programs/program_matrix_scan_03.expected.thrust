static matrix_bias_03: const s32 @public @extern("matrix_bias_03") = 1;
static mut visited_cells_03: s32 = 0;

fn fill_matrix_03(matrix: ptr[s32]) void {
    for var r: s32 = 0; r < 4; r += 1; {
        for var c: s32 = 0; c < 6; c += 1; {
            matrix->[((r) * 6) + (c)] = (r + 3) * (c + 1) + matrix_bias_03;
        }
    }
}
fn main() s32 @public {
    var matrix: array[array[s32; 6]; 4];
    fill_matrix_03(matrix[0][0]);
    var total: s32 = trace_band_03(matrix[0][0]);
    if visited_cells_03 != (24) as s32 {
        return (1) as s32;
    }
    if total <= 50 {
        return (2) as s32;
    }
    if (matrix[0][0])->[((2) * 6) + (2)] <= matrix_bias_03 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn trace_band_03(matrix: ptr[s32]) s32 {
    var total: s32 = 0;
    for var r: s32 = 0; r < 4; r += 1; {
        for var c: s32 = 0; c < 6; c += 1; {
            if (r + c) <= 7 {
                total += matrix->[((r) * 6) + (c)];
            }
            visited_cells_03 += 1;
        }
    }
    return (total) as s32;
}
