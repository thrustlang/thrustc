struct Record05 {
    key: s32,
    value: s32,
    active: s32,
}

static checksum_bias_05: const s32 @public @extern("checksum_bias_05") = 2;
static mut kept_records_05: s32 = 0;

fn filter_records_05(records: ptr[Record05]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 7; i += 1; {
        if ((records[i]->active) != 0) && (records[i]->value >= 7) {
            total += records[i]->key + records[i]->value + checksum_bias_05;
            kept_records_05 += 1;
        }
    }
    return (total) as s32;
}
fn main() s32 @public {
    var records: array[Record05; 7] = fixed[new Record05 { key: 1, value: 10, active: 1 }, new Record05 { key: 2, value: 7, active: 1 }, new Record05 { key: 3, value: 4, active: 1 }, new Record05 { key: 4, value: 8, active: 0 }, new Record05 { key: 5, value: 9, active: 1 }, new Record05 { key: 6, value: 6, active: 1 }, new Record05 { key: 7, value: 11, active: 1 }];
    var total: s32 = filter_records_05(ref records[0]);
    if kept_records_05 < 4 {
        return (1) as s32;
    }
    if total <= 30 {
        return (2) as s32;
    }
    if records[4]->active != 1 {
        return (3) as s32;
    }
    return (0) as s32;
}
