static matrix_bias_06: const s32 @public @extern("matrix_bias_06") = 5;
static mut visited_cells_06: s32 = 0;

fn fill_matrix_06(matrix: ptr[s32]) void {
    for var r: s32 = 0; r < 4; r += 1; {
        for var c: s32 = 0; c < 4; c += 1; {
            matrix->[((r) * 4) + (c)] = (r + 1) * (c + 4) + matrix_bias_06;
        }
    }
}
fn main() s32 @public {
    var matrix: array[array[s32; 4]; 4];
    fill_matrix_06(ref matrix[0][0]);
    var total: s32 = trace_band_06(ref matrix[0][0]);
    if visited_cells_06 != 4 * 4 {
        return (1) as s32;
    }
    if total <= 55 {
        return (2) as s32;
    }
    if (ref matrix[0][0])->[((0) * 4) + (3)] <= matrix_bias_06 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn trace_band_06(matrix: ptr[s32]) s32 {
    var total: s32 = 0;
    for var r: s32 = 0; r < 4; r += 1; {
        for var c: s32 = 0; c < 4; c += 1; {
            if (r + c) <= 5 {
                total += matrix->[((r) * 4) + (c)];
            }
            visited_cells_06 += 1;
        }
    }
    return (total) as s32;
}
