struct Chain_03 {
    left: s32,
    right: s32,
}

static mut chain_steps_03: s32 = 0;

fn eval_chain_03(items: ptr[Chain_03], n: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < n; i += 1; {
        items[i]->right += i;
        if items[i]->left > items[i]->right {
            total += items[i]->left - items[i]->right;
        } else {
            total += items[i]->right - items[i]->left;
        }
        chain_steps_03 += 1;
    }
    return (total) as s32;
}
fn main() s32 @public {
    var items: array[Chain_03; 6] = fixed[new Chain_03 { left: 12, right: 16 }, new Chain_03 { left: -2, right: 2 }, new Chain_03 { left: -2, right: 2 }, new Chain_03 { left: -5, right: -1 }, new Chain_03 { left: -8, right: -4 }, new Chain_03 { left: -6, right: -2 }];
    var score: s32 = eval_chain_03(ref items[0], 6);
    if chain_steps_03 != 6 {
        return (1) as s32;
    }
    if score != 39 {
        return (2) as s32;
    }
    return (0) as s32;
}
