static base_bias_10: const s32 @public @extern("base_bias_10") = 3;
static mut reductions_10: s32 = 0;

fn fold_all_10(pairs: ptr[s32]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 5; i += 1; {
        var local: s32 = fold_pair_10(pairs->[((i) * 2) + (0)], pairs->[((i) * 2) + (1)]);
        if (local % 4) == 0 {
            total += local / 2;
        } else {
            total += local + 2;
        }
    }
    return (total) as s32;
}
fn fold_pair_10(left: s32, right: s32) s32 {
    var common: s32 = gcd_10(left + 1, right + 1);
    var score: s32 = (left * 6) + right + base_bias_10;
    reductions_10 += 1;
    return (score - common) as s32;
}
fn gcd_10(a_param: s32, b_param: s32) s32 {
    var a: s32 = a_param;
    var b: s32 = b_param;

    while b != 0 {
        var next: s32 = a % b;
        a = b;
        b = next;
    }
    if a < 0 {
        return (-a) as s32;
    } else {
        return (a) as s32;
    }
}
fn main() s32 @public {
    var pairs: array[array[s32; 2]; 5] = fixed[fixed[6, 7], fixed[8, 5], fixed[9, 4], fixed[11, 2], fixed[10, 6]];
    var total: s32 = fold_all_10(ref pairs[0][0]);
    var guard: s32 = gcd_10(total, 55 + 21);
    if reductions_10 != 5 {
        return (1) as s32;
    }
    if total <= 55 {
        return (2) as s32;
    }
    if guard <= 0 {
        return (3) as s32;
    }
    return (0) as s32;
}
