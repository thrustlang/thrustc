static global_offset_06: const s32 @public @extern("global_offset_06") = 4;
static mut processed_windows_06: s32 = 0;

fn count_peaks_06(values: const ptr[s32]) s32 {
    var peaks: s32 = 0;
    for var i: s32 = 1; i + 1 < 15; i += 1; {
        if (values->[i] >= values->[i - 1]) && (values->[i] > values->[i + 1]) {
            peaks += 1;
        }
    }
    return (peaks) as s32;
}
fn main() s32 @public {
    var raw: array[s32; 15] = fixed[1, (-6) as s32, 3, 8, 4, (-2) as s32, 7, 5, 9, (-1) as s32, 2, 6, 8, (-3) as s32, 4];
    var cooked: array[s32; 15];
    var best: s32 = 0;
    var score: s32 = 0;
