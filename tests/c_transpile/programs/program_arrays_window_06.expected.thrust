fn normalize_06(value: s32) s32 {
    if value < 0 {
        return (((-value) as s32 * 2) + global_offset_06) as s32;
    }
    return (value + global_offset_06) as s32;
}
fn sliding_sum_06(values: const ptr[s32], start: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 5; i += 1; {
        total += values->[start + i];
