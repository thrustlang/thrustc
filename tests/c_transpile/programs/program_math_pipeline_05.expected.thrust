static base_bias_05: const s32 @public @extern("base_bias_05") = 8;
static mut reductions_05: s32 = 0;

fn fold_all_05(pairs: ptr[s32]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 5; i += 1; {
        var local: s32 = fold_pair_05(pairs->[((i) * 2) + (0)], pairs->[((i) * 2) + (1)]);
        if (local & 1) == 0 {
            total += local / 2;
        } else {
            total += local + 2;
        }
    }
    return (total) as s32;
}
fn fold_pair_05(left: s32, right: s32) s32 {
    var common: s32 = gcd_05(left + 1, right + 1);
    var score: s32 = (left * 5) + right + base_bias_05;
    reductions_05 += 1;
    return (score - common) as s32;
}
fn gcd_05(a_param: s32, b_param: s32) s32 {
    var a: s32 = a_param;
    var b: s32 = b_param;

    while b != 0 {
        var next: s32 = a % b;
        a = b;
        b = next;
    }
    if a < 0 {
        return (-a) as s32;
    } else {
        return (a) as s32;
    }
}
fn main() s32 @public {
    var pairs: array[array[s32; 2]; 5] = fixed[fixed[6, 4], fixed[8, 7], fixed[5, 9], fixed[11, 3], fixed[7, 10]];
    var total: s32 = fold_all_05(ref pairs[0][0]);
    var guard: s32 = gcd_05(total, 47 + 7);
    if reductions_05 != 5 {
        return (1) as s32;
    }
    if total <= 47 {
        return (2) as s32;
    }
    if guard <= 0 {
        return (3) as s32;
    }
    return (0) as s32;
}
