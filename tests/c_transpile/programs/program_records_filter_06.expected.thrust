struct Record06 {
    key: s32,
    value: s32,
    active: s32,
}

static checksum_bias_06: const s32 @public @extern("checksum_bias_06") = 3;
static mut kept_records_06: s32 = 0;

fn filter_records_06(records: ptr[Record06]) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 6; i += 1; {
        if ((records[i]->active) != 0) && (records[i]->value >= 6) {
            total += records[i]->key + records[i]->value + checksum_bias_06;
            kept_records_06 += 1;
        }
    }
    return (total) as s32;
}
fn main() s32 @public {
    var records: array[Record06; 6] = fixed[new Record06 { key: 1, value: 7, active: 1 }, new Record06 { key: 2, value: 5, active: 1 }, new Record06 { key: 3, value: 9, active: 1 }, new Record06 { key: 4, value: 4, active: 0 }, new Record06 { key: 5, value: 8, active: 1 }, new Record06 { key: 6, value: 6, active: 1 }];
    var total: s32 = filter_records_06(ref records[0]);
    if kept_records_06 < 4 {
        return (1) as s32;
    }
    if total <= 25 {
        return (2) as s32;
    }
    if records[2]->value != 9 {
        return (3) as s32;
    }
    return (0) as s32;
}
