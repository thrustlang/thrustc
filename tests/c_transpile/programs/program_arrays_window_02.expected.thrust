static global_offset_02: const s32 @public @extern("global_offset_02") = 4;
static mut processed_windows_02: s32 = 0;

fn count_peaks_02(values: const ptr[s32]) s32 {
    var peaks: s32 = 0;
    for var i: s32 = 1; i + 1 < 13; i += 1; {
        if (values->[i] >= values->[i - 1]) && (values->[i] > values->[i + 1]) {
            peaks += 1;
        }
    }
    return (peaks) as s32;
}
fn main() s32 @public {
    var raw: array[s32; 13] = fixed[1, -4, 6, 2, 8, -3, 5, 7, 0, 9, -1, 4, 3];
    var cooked: array[s32; 13];
    var best: s32 = 0;
    var score: s32 = 0;
    for var i: s32 = 0; i < 13; i += 1; {
        cooked->[i] = normalize_02(raw->[i]);
        if (i % 3) == 0 {
            cooked->[i] += 1;
        }
    }
    for var i: s32 = 0; i + 4 <= 13; i += 1; {
        var current: s32 = sliding_sum_02(cooked as ptr[s32], i);
        if current > best {
            best = current;
        }
        if current >= 19 {
            score += 2;
        }
    }
    score += count_peaks_02(cooked as ptr[s32]);
    if processed_windows_02 != 13 - 4 + 1 {
        return (1) as s32;
    }
    if best <= 19 {
        return (2) as s32;
    }
    if score < 8 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn normalize_02(value: s32) s32 {
    if value < 0 {
        return (-value + global_offset_02) as s32;
    }
    return (value + global_offset_02) as s32;
}
fn sliding_sum_02(values: const ptr[s32], start: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 4; i += 1; {
        total += values->[start + i];
    }
    processed_windows_02 += 1;
    return (total) as s32;
}
