struct Chain_07 {
    left: s32,
    right: s32,
}

static mut chain_steps_07: s32 = 0;

fn eval_chain_07(items: ptr[Chain_07], n: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < n; i += 1; {
        items[i]->right += i;
        if items[i]->left > items[i]->right {
            total += items[i]->left - items[i]->right;
        } else {
            total += items[i]->right - items[i]->left;
        }
        chain_steps_07 += 1;
    }
    return (total) as s32;
}
fn main() s32 @public {
    var items: array[Chain_07; 6] = fixed[new Chain_07 { left: -4, right: 0 }, new Chain_07 { left: -1, right: 3 }, new Chain_07 { left: -5, right: -1 }, new Chain_07 { left: -4, right: 0 }, new Chain_07 { left: 3, right: 7 }, new Chain_07 { left: -8, right: -4 }];
    var score: s32 = eval_chain_07(ref items[0], 6);
    if chain_steps_07 != 6 {
        return (1) as s32;
    }
    if score != 39 {
        return (2) as s32;
    }
    return (0) as s32;
}
