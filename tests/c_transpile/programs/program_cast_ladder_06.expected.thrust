static mut cast_steps_06: s32 = 0;

fn ladder_cast_06(values: const ptr[s32], n: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < n; i += 1; {
        var base: s32 = values->[i];
        var up: u32 = ((base + i + 17)) as u32;
        var down: s32 = ((up % (19) as u32)) as s32;
        total += down - (base / 3);
        cast_steps_06 += 1;
    }
    return (total) as s32;
}
fn main() s32 @public {
    var values: array[s32; 8] = fixed[(-8) as s32, 6, 4, 6, 10, 3, 2, (-1) as s32];
    var total: s32 = ladder_cast_06(values as ptr[s32], 8);
    if cast_steps_06 != 8 {
        return (1) as s32;
    }
    if total != 46 {
        return (2) as s32;
    }
    return (0) as s32;
}
