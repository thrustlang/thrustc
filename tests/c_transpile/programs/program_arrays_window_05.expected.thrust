static global_offset_05: const s32 @public @extern("global_offset_05") = 7;
static mut processed_windows_05: s32 = 0;

fn count_peaks_05(values: const ptr[s32]) s32 {
    var peaks: s32 = 0;
    for var i: s32 = 1; i + 1 < 10; i += 1; {
        if (values->[i] > values->[i - 1]) && (values->[i] >= values->[i + 1]) {
            peaks += 1;
        }
    }
    return (peaks) as s32;
}
fn main() s32 @public {
    var raw: array[s32; 10] = fixed[5, -1, 4, 6, -3, 8, 2, 7, -2, 9];
    var cooked: array[s32; 10];
    var best: s32 = 0;
    var score: s32 = 0;
    for var i: s32 = 0; i < 10; i += 1; {
        cooked->[i] = normalize_05(raw->[i]);
        if (i % 2) == 1 {
            cooked->[i] += 2;
        }
    }
    for var i: s32 = 0; i + 4 <= 10; i += 1; {
        var current: s32 = sliding_sum_05(cooked as ptr[s32], i);
        if current > best {
            best = current;
        }
        if current >= 18 {
            score += 1;
        }
    }
    score += count_peaks_05(cooked as ptr[s32]);
    if processed_windows_05 != 10 - 4 + 1 {
        return (1) as s32;
    }
    if best <= 18 {
        return (2) as s32;
    }
    if score < 5 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn normalize_05(value: s32) s32 {
    if value < 0 {
        return (-value + global_offset_05) as s32;
    }
    return (value + global_offset_05 + 1) as s32;
}
fn sliding_sum_05(values: const ptr[s32], start: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < 4; i += 1; {
        total += values->[start + i];
    }
    processed_windows_05 += 1;
    return (total) as s32;
}
