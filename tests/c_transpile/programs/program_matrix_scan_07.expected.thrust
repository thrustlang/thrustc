static matrix_bias_07: const s32 @public @extern("matrix_bias_07") = 3;
static mut visited_cells_07: s32 = 0;

fn fill_matrix_07(matrix: ptr[s32]) void {
    for var r: s32 = 0; r < 6; r += 1; {
        for var c: s32 = 0; c < 4; c += 1; {
            matrix->[((r) * 4) + (c)] = (r + 2) * (c + 3) + matrix_bias_07;
        }
    }
}
fn main() s32 @public {
    var matrix: array[array[s32; 4]; 6];
    fill_matrix_07(matrix[0][0]);
    var total: s32 = trace_band_07(matrix[0][0]);
    if visited_cells_07 != (24) as s32 {
        return (1) as s32;
    }
    if total <= 85 {
        return (2) as s32;
    }
    if (matrix[0][0])->[((5) * 4) + (0)] <= matrix_bias_07 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn trace_band_07(matrix: ptr[s32]) s32 {
    var total: s32 = 0;
    for var r: s32 = 0; r < 6; r += 1; {
        for var c: s32 = 0; c < 4; c += 1; {
            if (r + c) <= 7 {
                total += matrix->[((r) * 4) + (c)];
            }
            visited_cells_07 += 1;
        }
    }
    return (total) as s32;
}
