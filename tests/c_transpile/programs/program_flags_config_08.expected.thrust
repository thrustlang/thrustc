static mut rejected_08: s32 = 0;
static required_mask_08: const s32 @public @extern("required_mask_08") = 4;

fn apply_flags_08(current: s32, extra: s32) s32 {
    var merged: s32 = current | extra;
    if (merged & 2) != 0 {
        merged ^= 2;
        merged |= 4;
    }
    return (merged) as s32;
}
fn main() s32 @public {
    var entries: array[s32; 5] = fixed[0, 2, 1, 4, 1 | 2];
    var accepted: s32 = validate_flags_08(entries as ptr[s32]);
    if accepted < 3 {
        return (1) as s32;
    }
    if rejected_08 <= 0 {
        return (2) as s32;
    }
    if (apply_flags_08(1, 0) & 1) == 0 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn validate_flags_08(entries: const ptr[s32]) s32 {
    var accepted: s32 = 0;
    for var i: s32 = 0; i < 5; i += 1; {
        var merged: s32 = apply_flags_08(entries->[i], 1);
        if (merged & required_mask_08) == required_mask_08 {
            accepted += 1;
        } else {
            rejected_08 += 1;
        }
    }
    return (accepted) as s32;
}
