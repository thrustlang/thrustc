struct Chain_10 {
    left: s32,
    right: s32,
}

static mut chain_steps_10: s32 = 0;

fn eval_chain_10(items: ptr[Chain_10], n: s32) s32 {
    var total: s32 = 0;
    for var i: s32 = 0; i < n; i += 1; {
        items[i]->right += i;
        if items[i]->left > items[i]->right {
            total += items[i]->left - items[i]->right;
        } else {
            total += items[i]->right - items[i]->left;
        }
        chain_steps_10 += 1;
    }
    return (total) as s32;
}
fn main() s32 @public {
    var items: array[Chain_10; 6] = fixed[new Chain_10 { left: (-5) as s32, right: (-2) as s32 }, new Chain_10 { left: (-1) as s32, right: 2 }, new Chain_10 { left: 7, right: 10 }, new Chain_10 { left: 0, right: 3 }, new Chain_10 { left: 11, right: 14 }, new Chain_10 { left: 12, right: 15 }];
    var score: s32 = eval_chain_10(items[0], 6);
    if chain_steps_10 != 6 {
        return (1) as s32;
    }
    if score != 33 {
        return (2) as s32;
    }
    return (0) as s32;
}
