static mut rejected_04: s32 = 0;
static required_mask_04: const s32 @public @extern("required_mask_04") = 1;

fn apply_flags_04(current: s32, extra: s32) s32 {
    var merged: s32 = current | extra;
    if (merged & 2) != 0 {
        merged ^= 2;
        merged |= 4;
    }
    return (merged) as s32;
}
fn main() s32 @public {
    var entries: array[s32; 6] = fixed[2, 0, 4, 1, 1 | 2, 4 | 2];
    var accepted: s32 = validate_flags_04(entries as ptr[s32]);
    if accepted < 4 {
        return (1) as s32;
    }
    if rejected_04 < 0 {
        return (2) as s32;
    }
    if (apply_flags_04(2, 1) & 2) != 0 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn validate_flags_04(entries: const ptr[s32]) s32 {
    var accepted: s32 = 0;
    for var i: s32 = 0; i < 6; i += 1; {
        var merged: s32 = apply_flags_04(entries->[i], 1);
        if (merged & required_mask_04) == required_mask_04 {
            accepted += 1;
        } else {
            rejected_04 += 1;
        }
    }
    return (accepted) as s32;
}
