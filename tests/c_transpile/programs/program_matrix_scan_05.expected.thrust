static matrix_bias_05: const s32 @public @extern("matrix_bias_05") = 2;
static mut visited_cells_05: s32 = 0;

fn fill_matrix_05(matrix: ptr[s32]) void {
    for var r: s32 = 0; r < 5; r += 1; {
        for var c: s32 = 0; c < 5; c += 1; {
            matrix->[((r) * 5) + (c)] = (r + 2) * (c + 2) + matrix_bias_05;
        }
    }
}
fn main() s32 @public {
    var matrix: array[array[s32; 5]; 5];
    fill_matrix_05(matrix[0][0]);
    var total: s32 = trace_band_05(matrix[0][0]);
    if visited_cells_05 != (25) as s32 {
        return (1) as s32;
    }
    if total <= 70 {
        return (2) as s32;
    }
    if (matrix[0][0])->[((4) * 5) + (4)] <= matrix_bias_05 {
        return (3) as s32;
    }
    return (0) as s32;
}
fn trace_band_05(matrix: ptr[s32]) s32 {
    var total: s32 = 0;
    for var r: s32 = 0; r < 5; r += 1; {
        for var c: s32 = 0; c < 5; c += 1; {
            if (r + c) <= 8 {
                total += matrix->[((r) * 5) + (c)];
            }
            visited_cells_05 += 1;
        }
    }
    return (total) as s32;
}
