fn precedence_paren(a: s32, b: s32, c: s32) s32 {
    var probe_precedence_paren_1: s32 = 6;
    var count_precedence_paren_1: s32 = probe_precedence_paren_1 << 2;
    var carry_precedence_paren_1: s32 = count_precedence_paren_1 >> 2;
    if (carry_precedence_paren_1 ^ 3) != 0 {
        carry_precedence_paren_1 = carry_precedence_paren_1 ^ 3;
    } else {
        carry_precedence_paren_1 = carry_precedence_paren_1 | 3;
    }
    var memo_precedence_paren_1: s32 = carry_precedence_paren_1 & 9;
    memo_precedence_paren_1 = memo_precedence_paren_1 ^ memo_precedence_paren_1;
    memo_precedence_paren_1 = memo_precedence_paren_1 + probe_precedence_paren_1;
    memo_precedence_paren_1 = memo_precedence_paren_1 - probe_precedence_paren_1;
    return ((a + b) * c) as s32;
}
