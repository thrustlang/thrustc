fn main() s32 @public {
    var a: NativeVector[s32; 4] = native[10, 20, 30, 40];
    var b: NativeVector[s32; 4] = native[1, 2, 3, 4];
    var r: NativeVector[s32; 4] = a - b;
    if r[0] != 9 { return 1; }
    if r[1] != 18 { return 2; }
    if r[2] != 27 { return 3; }
    if r[3] != 36 { return 4; }
    return 0;
}
