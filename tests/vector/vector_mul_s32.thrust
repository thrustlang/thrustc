fn main() s32 @public {
    var a: NativeVector[s32; 4] = native[1, 2, 3, 4];
    var b: NativeVector[s32; 4] = native[2, 3, 4, 5];
    var r: NativeVector[s32; 4] = a * b;
    if r[0] != 2 { return 1; }
    if r[1] != 6 { return 2; }
    if r[2] != 12 { return 3; }
    if r[3] != 20 { return 4; }
    return 0;
}
