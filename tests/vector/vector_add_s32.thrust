fn main() s32 @public {
    var a: NativeVector[s32; 4] = native[1, 2, 3, 4];
    var b: NativeVector[s32; 4] = native[10, 20, 30, 40];
    var r: NativeVector[s32; 4] = a + b;
    if r[0] != 11 { return 1; }
    if r[1] != 22 { return 2; }
    if r[2] != 33 { return 3; }
    if r[3] != 44 { return 4; }
    return 0;
}
