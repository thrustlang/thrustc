fn main() s32 @public {
    var a: NativeVector[s32; 4] = native[6, 7, 8, 9];
    var b: NativeVector[s32; 4] = native[3, 3, 3, 3];
    var r: NativeVector[s32; 4] = a & b;
    if r[0] != 2 { return 1; }
    if r[1] != 3 { return 2; }
    if r[2] != 0 { return 3; }
    if r[3] != 1 { return 4; }
    return 0;
}
