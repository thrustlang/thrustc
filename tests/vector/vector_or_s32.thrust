fn main() s32 @public {
    var a: NativeVector[s32; 4] = native[1, 2, 4, 8];
    var b: NativeVector[s32; 4] = native[1, 1, 1, 1];
    var r: NativeVector[s32; 4] = a | b;
    if r[0] != 1 { return 1; }
    if r[1] != 3 { return 2; }
    if r[2] != 5 { return 3; }
    if r[3] != 9 { return 4; }
    return 0;
}
