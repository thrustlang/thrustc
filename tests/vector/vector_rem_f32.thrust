fn main() s32 @public {
    var a: NativeVector[f32; 4] = native[10.0, 20.0, 30.0, 40.0];
    var b: NativeVector[f32; 4] = native[3.0, 6.0, 7.0, 9.0];
    var r: NativeVector[f32; 4] = a % b;
    if r[0] != 1.0 { return 1; }
    if r[1] != 2.0 { return 2; }
    if r[2] != 2.0 { return 3; }
    if r[3] != 4.0 { return 4; }
    return 0;
}
