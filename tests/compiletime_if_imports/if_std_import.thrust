/*
 * Conditional standard library imports: @if / @else selection
 *
 * On x86_64-linux, isLinux() is true so std::testmod is imported and
 * std_val resolves. The test std root is provided via -std.
 */

@if(isLinux()) import std::testmod only { std_val };
@else import std::other only { std_val };

fn main() s32 @public {
    if std_val() != 7 { return 1; }

    return 0;
}