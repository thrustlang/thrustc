/*
 * Compile-time builtins: stringLength with escapes and empty strings.
 */

fn main() s32 @public {
    if stringLength("") != 0 { return 1; }
    if stringLength("a") != 1 { return 2; }
    if stringLength("abc") != 3 { return 3; }
    if stringLength("a\nb") != 3 { return 4; }
    if stringLength("1234567890") != 10 { return 5; }
    return 0;
}