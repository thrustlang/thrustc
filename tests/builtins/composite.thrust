/*
 * Compile-time builtins on composite types
 *
 * Verifies sizeOf/alignOf on structs, fixed arrays and pointers.
 */

struct pair_u32 {
    first: u32,
    second: u32,
}

struct single_u8 {
    value: u8,
}

fn main() s32 @public {
    if sizeOf(pair_u32) != 8 {
        return 1;
    }

    if alignOf(pair_u32) != 4 {
        return 2;
    }

    if sizeOf(single_u8) != 1 {
        return 3;
    }

    if alignOf(single_u8) != 1 {
        return 4;
    }

    if sizeOf(array[u32; 3]) != 12 {
        return 5;
    }

    if sizeOf(array[u8; 16]) != 16 {
        return 6;
    }

    if alignOf(array[u32; 3]) != alignOf(u32) {
        return 7;
    }

    if sizeOf(ptr) != sizeOf(ptr[u32]) {
        return 8;
    }

    return 0;
}