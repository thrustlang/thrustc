/*
 * Stress Test para Thrust Compiler
 * Generado automáticamente - 80000 líneas
 * Solo variables locales (dentro de funciones)
 */

fn test_func_0() void @public {
    var x: s32 = 0;
    var y: s32 = x * 2 + 10;
    var z: f32 = 3.14 * 0.0;
    var a: u64 = 12345678;
    var b: bool = true;
    var c: array[f32] = [1.0, 2.0, 3.0];

    if (x % 100 == 0) {
        var temp: s32 = x + 500;
        y = temp * 2;
    }

    while (y < 200) {
        y = y + 1;
        z = z + 0.1;
    }

    return;
}

