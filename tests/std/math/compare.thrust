import std::math;

fn main() s32 @public {
    if math::absolute(-3.5) != 3.5 { return 1; }
    if math::minimum(3.0, 5.0) != 3.0 { return 2; }
    if math::maximum(3.0, 5.0) != 5.0 { return 3; }
    if math::positiveDifference(5.0, 3.0) != 2.0 { return 4; }
    if math::positiveDifference(3.0, 5.0) != 0.0 { return 5; }
    if math::copySign(3.0, -1.0) != -3.0 { return 6; }
    if math::fusedMultiplyAdd(2.0, 3.0, 1.0) != 7.0 { return 7; }

    return 0;
}