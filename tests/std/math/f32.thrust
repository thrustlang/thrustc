import std::math;

fn closeTo(actual: f64, expected: f64, epsilon: f64) bool {
    return math::absolute(actual - expected) <= epsilon;
}

fn main() s32 @public {
    if math::sine32(0.0 as f32) as f64 != 0.0 { return 1; }
    if math::cosine32(0.0 as f32) as f64 != 1.0 { return 2; }
    if math::tangent32(0.0 as f32) as f64 != 0.0 { return 3; }
    if math::squareRoot32(9.0 as f32) as f64 != 3.0 { return 4; }
    if math::power32(2.0 as f32, 10.0 as f32) as f64 != 1024.0 { return 5; }
    if math::absolute32(-2.5 as f32) as f64 != 2.5 { return 6; }
    if math::floorValue32(3.7 as f32) as f64 != 3.0 { return 7; }
    if math::ceiling32(3.2 as f32) as f64 != 4.0 { return 8; }
    if math::exponential32(0.0 as f32) as f64 != 1.0 { return 9; }
    if math::naturalLogarithm32(1.0 as f32) as f64 != 0.0 { return 10; }
    if math::hypotenuse32(3.0 as f32, 4.0 as f32) as f64 != 5.0 { return 11; }
    if math::minimum32(3.0 as f32, 5.0 as f32) as f64 != 3.0 { return 12; }
    if math::maximum32(3.0 as f32, 5.0 as f32) as f64 != 5.0 { return 13; }
    if math::modulo32(7.0 as f32, 3.0 as f32) as f64 != 1.0 { return 14; }
    if math::cubeRoot32(27.0 as f32) as f64 != 3.0 { return 15; }
    if math::gammaFunction32(4.0 as f32) as f64 != 6.0 { return 16; }

    if !closeTo(math::arcSine32(0.5 as f32) as f64, 0.5235987755982988, 0.000001) { return 17; }
    if !closeTo(math::arcTangent2F32(1.0 as f32, 1.0 as f32) as f64, 0.7853981633974483, 0.000001) { return 18; }
    if !closeTo(math::logarithm10F32(100.0 as f32) as f64, 2.0, 0.000001) { return 19; }
    if !closeTo(math::exponential2F32(3.0 as f32) as f64, 8.0, 0.000001) { return 20; }
    if !closeTo(math::logarithm2F32(8.0 as f32) as f64, 3.0, 0.000001) { return 21; }
    if !closeTo(math::errorFunction32(1.0 as f32) as f64, 0.8427007929497149, 0.000001) { return 22; }

    return 0;
}