/*
 * Exercises std::env: main argument helpers and environment variable access.
 * The test binary runs without arguments, so argc == 1.
 * Returns 0 on success, non-zero on failure.
 */

import std::env;
import std::tstring;
import std::collections::vector as vec;

fn main(argc: s32, argv: ptr[array[char]]) s32 @public {
    if !env::hasArgument(argc, 0) { return 1; }
    if env::hasArgument(argc, 1) { return 2; }

    var first := env::argument(argc, argv, 0);
    var firstT := tstring::fromCString(first);
    if tstring::len(ref firstT) == 0 { return 3; }
    tstring::dropTString(ref firstT);

    var path := env::argumentAsTString(argc, argv, 0);
    if tstring::len(ref path) == 0 { return 4; }
    tstring::dropTString(ref path);

    var missing := env::argumentAsTString(argc, argv, 5);
    if tstring::len(ref missing) != 0 { return 5; }
    tstring::dropTString(ref missing);

    var all := env::arguments(argc, argv);
    if vec::getLength[tstring::TString](ref all) != (argc as usize) { return 6; }

    var arg0: tstring::TString = vec::at[tstring::TString](ref all, 0);
    if tstring::len(ref arg0) == 0 { return 7; }

    var allData: ptr[tstring::TString] = vec::getDataPointer[tstring::TString](ref all);
    var i: usize = 0;

    while i < vec::getLength[tstring::TString](ref all) {
        tstring::dropTString(ref allData[i]);
        i = i + 1;
    }

    vec::dropVector[tstring::TString](ref all);

    if env::setVariable("THRUST_ENV_TEST", "hello", true) != 0 { return 8; }
    if !env::hasVariable("THRUST_ENV_TEST") { return 9; }

    var expected := tstring::fromCString("hello");
    var got := env::getVariableAsTString("THRUST_ENV_TEST");
    if !tstring::equals(ref got, ref expected) { return 10; }
    tstring::dropTString(ref got);

    if env::setVariable("THRUST_ENV_TEST", "world", false) != 0 { return 11; }
    var kept := env::getVariableAsTString("THRUST_ENV_TEST");
    if !tstring::equals(ref kept, ref expected) { return 12; }
    tstring::dropTString(ref kept);
    tstring::dropTString(ref expected);

    if env::unsetVariable("THRUST_ENV_TEST") != 0 { return 13; }
    if env::hasVariable("THRUST_ENV_TEST") { return 14; }

    if env::hasVariable("HOME") {
        var home := env::getVariableAsTString("HOME");
        if tstring::len(ref home) == 0 { return 15; }
        tstring::dropTString(ref home);
    }

    if env::clearVariables() != 0 { return 16; }

    return 0;
}