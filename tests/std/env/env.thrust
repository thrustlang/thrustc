/*
 * Exercises std::env without depending on the implementation of the module.
 * The test binary runs without arguments, so argc == 1.
 * Returns 0 on success, non-zero on failure.
 */

directive "--disable-warnings=W0015";
directive "--disable-warnings=W0016";
directive "--disable-warnings=W0020";
directive "--disable-warnings=W0028";
directive "--disable-warnings=W0030";

import std::env;
import std::tstring;
import std::collections::vector as vec;

fn isAbsolutePath(path: CString) bool {
    var data: ptr[char] = path as ptr[char];
    var absolute: bool = false;

    if data == nullptr {
        return false;
    }

    @if(isWindows()) {
        if (data->[0] as s32) == 92 && (data->[1] as s32) == 92 {
            absolute = true;
        } else if data->[1] == ':' {
            if (data->[2] as s32) == 92 || (data->[2] as s32) == 47 {
                absolute = true;
            }
        }
    } @else {
        if data->[0] == '/' {
            absolute = true;
        }
    }

    return absolute;
}

fn main(argc: s32, argv: ptr[array[char]]) s32 @public {
    if !env::hasArgument(argc, 0) { return 1; }
    if env::hasArgument(argc, 1) { return 2; }
    if env::hasArgument(argc, -1) { return 3; }

    var first := env::argument(argc, argv, 0);
    var firstT := tstring::fromCString(first);
    if tstring::len(ref firstT) == 0 { return 4; }
    tstring::dropTString(ref firstT);

    var path := env::argumentAsTString(argc, argv, 0);
    if tstring::len(ref path) == 0 { return 5; }
    tstring::dropTString(ref path);

    var missing := env::argumentAsTString(argc, argv, 5);
    if tstring::len(ref missing) != 0 { return 6; }
    tstring::dropTString(ref missing);

    var all := env::arguments(argc, argv);
    if vec::getLength[tstring::TString](ref all) != (argc as usize) { return 7; }

    var arg0: tstring::TString = vec::at[tstring::TString](ref all, 0);
    if tstring::len(ref arg0) == 0 { return 8; }

    var allData: ptr[tstring::TString] = vec::getDataPointer[tstring::TString](ref all);
    var i: usize = 0;

    while i < vec::getLength[tstring::TString](ref all) {
        tstring::dropTString(allData[i]);
        i = i + 1;
    }

    vec::dropVector[tstring::TString](ref all);

    if env::setVariable("THRUST_ENV_MODEL", "one", true) != 0 { return 9; }
    if !env::hasVariable("THRUST_ENV_MODEL") { return 10; }

    var expectedOne: tstring::TString = tstring::fromCString("one");
    var gotOne: tstring::TString = env::getVariableAsTString("THRUST_ENV_MODEL");
    if !tstring::equals(ref gotOne, ref expectedOne) { return 11; }
    tstring::dropTString(ref gotOne);
    tstring::dropTString(ref expectedOne);

    if env::setVariable("THRUST_ENV_MODEL", "two", false) != 0 { return 12; }

    var expectedKept: tstring::TString = tstring::fromCString("one");
    var kept: tstring::TString = env::getVariableAsTString("THRUST_ENV_MODEL");
    if !tstring::equals(ref kept, ref expectedKept) { return 13; }
    tstring::dropTString(ref kept);
    tstring::dropTString(ref expectedKept);

    if env::setVariable("THRUST_ENV_MODEL", "two", true) != 0 { return 14; }

    var expectedTwo: tstring::TString = tstring::fromCString("two");
    var replaced: tstring::TString = env::getVariableAsTString("THRUST_ENV_MODEL");
    if !tstring::equals(ref replaced, ref expectedTwo) { return 15; }
    tstring::dropTString(ref replaced);
    tstring::dropTString(ref expectedTwo);

    if env::unsetVariable("THRUST_ENV_MODEL") != 0 { return 16; }
    if env::hasVariable("THRUST_ENV_MODEL") { return 17; }

    if env::hasVariable("THRUST_ENV_MODEL_MISSING") { return 18; }
    if (env::getVariable("THRUST_ENV_MODEL_MISSING") as ptr[char]) != nullptr { return 19; }

    var missingText: tstring::TString = env::getVariableAsTString("THRUST_ENV_MODEL_MISSING");
    if tstring::len(ref missingText) != 0 { return 20; }
    tstring::dropTString(ref missingText);

    var home: CString = env::homeDirectory();
    if (home as ptr[char]) == nullptr { return 21; }

    var homeText: tstring::TString = tstring::fromCString(home);
    if tstring::len(ref homeText) == 0 { return 22; }
    if !isAbsolutePath(home) { return 23; }
    tstring::dropTString(ref homeText);

    var temporary: CString = env::temporaryDirectory();
    if (temporary as ptr[char]) == nullptr { return 24; }

    var temporaryText: tstring::TString = tstring::fromCString(temporary);
    if tstring::len(ref temporaryText) == 0 { return 25; }
    if !isAbsolutePath(temporary) { return 26; }
    tstring::dropTString(ref temporaryText);

    var current: CString = env::currentDirectory();
    if (current as ptr[char]) == nullptr { return 27; }

    var currentText: tstring::TString = tstring::fromCString(current);
    if tstring::len(ref currentText) == 0 { return 28; }
    if !isAbsolutePath(current) { return 29; }
    tstring::dropTString(ref currentText);

    var user: CString = env::userName();
    if (user as ptr[char]) == nullptr { return 30; }

    var userText: tstring::TString = tstring::fromCString(user);
    if tstring::len(ref userText) == 0 { return 31; }
    tstring::dropTString(ref userText);

    var host: CString = env::hostName();
    if (host as ptr[char]) == nullptr { return 32; }

    var hostText: tstring::TString = tstring::fromCString(host);
    if tstring::len(ref hostText) == 0 { return 33; }
    tstring::dropTString(ref hostText);

    if env::setVariable("THRUST_ENV_CLEAR_A", "a", true) != 0 { return 40; }
    if env::setVariable("THRUST_ENV_CLEAR_B", "b", true) != 0 { return 41; }
    if !env::hasVariable("THRUST_ENV_CLEAR_A") { return 42; }
    if !env::hasVariable("THRUST_ENV_CLEAR_B") { return 43; }

    if env::clearVariables() != 0 { return 44; }
    if env::hasVariable("THRUST_ENV_CLEAR_A") { return 45; }
    if env::hasVariable("THRUST_ENV_CLEAR_B") { return 46; }

    if env::setVariable("THRUST_ENV_CLEAR_C", "c", true) != 0 { return 47; }
    if !env::hasVariable("THRUST_ENV_CLEAR_C") { return 48; }

    var expectedClear: tstring::TString = tstring::fromCString("c");
    var clearValue: tstring::TString = env::getVariableAsTString("THRUST_ENV_CLEAR_C");
    if !tstring::equals(ref clearValue, ref expectedClear) { return 49; }
    tstring::dropTString(ref clearValue);
    tstring::dropTString(ref expectedClear);

    return 0;
}
