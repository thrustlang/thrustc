/*
 * Exercises std::int parse helpers on CString inputs.
 * Returns 0 on success, non-zero on failure.
 */

import std::int;

fn main() s32 @public {
    var text: CString = "255";

    if int::parse[s32](text) != 255 { return 1; }
    if int::parseWithBase[s32](text, 16) != 597 { return 2; }

    var signed: int::ParseSignedResult = int::parseSignedCString(text);
    if !(signed->ok) { return 3; }
    if signed->value != 255 { return 4; }

    var uns: int::ParseUnsignedResult = int::parseUnsignedCString(text);
    if !(uns->ok) { return 5; }
    if uns->value != 255 { return 6; }

    return 0;
}