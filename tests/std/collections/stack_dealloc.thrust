/*
 * Exercises automatic @dealloc resolution for std::collections::stack.
 * Returns 0 on success, non-zero on failure.
 */

import std::collections::stack;

directive "--disable-warnings=W0005";
directive "--disable-warnings=W0020";

fn main() s32 @public {
    var values @dealloc: stack::Stack[s32] = stack::newStack[s32]();

    stack::push(ref values, 10);
    stack::push(ref values, 20);

    if stack::getLength(ref values) != 2 { return 1; }
    if stack::pop(ref values) != 20 { return 2; }

    return 0;
}
