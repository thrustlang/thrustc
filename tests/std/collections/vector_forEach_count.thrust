/*
 * Exercises vector::forEach with a count-driven loop: the callback reads
 * the number of variadic arguments via arbitraryArgsCount and consumes that
 * many integers through arbitraryArgFrom.
 * Returns 0 on success, non-zero on failure.
 */

directive "--disable-warnings=W0020";

import std::collections::vector;

static mut total: s32 = 0;

fn sumAll(value: ptr[s32], args: ptr, count: usize) void {
    var i: usize = 0;

    while i < count {
        total = total + arbitraryArgFrom(args, s32);
        i = i + 1;
    }
}

fn main() s32 @public {
    var values @dealloc: vector::Vector[s32] = vector::newVector[s32]();
    vector::push(ref values, 0);

    vector::forEach(ref values, sumAll, 10 as s32, 20 as s32, 30 as s32);

    if total != 60 { return 1; }

    return 0;
}