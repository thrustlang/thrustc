/*
 * Exercises std::collections::vector iteration with index.
 * Returns 0 on success, non-zero on failure.
 */

import std::collections::vector;

directive "--disable-warnings=W0020";

fn main() s32 @public {
    var values @dealloc: vector::Vector[s32] = vector::newVector[s32]();
    var index: usize = 0;
    var total: s32 = 0;

    vector::push(ref values, 10);
    vector::push(ref values, 20);
    vector::push(ref values, 30);

    while index < vector::getLength(ref values) {
        total = total + vector::at(ref values, index);
        index = index + 1;
    }

    if total != 60 { return 1; }

    return 0;
}