/*
 * Exercises std::collections::vecdeque push and pop both ends.
 * Returns 0 on success, non-zero on failure.
 */

import std::collections::vecdeque;

directive "--disable-warnings=W0020";

fn main() s32 @public {
    var values := vecdeque::newVecDeque[s32]();

    vecdeque::pushBack(ref values, 1);
    vecdeque::pushBack(ref values, 2);
    vecdeque::pushFront(ref values, 0);

    if vecdeque::front(ref values) != 0 { return 1; }
    if vecdeque::back(ref values) != 2 { return 2; }

    if vecdeque::popFront(ref values) != 0 { return 3; }
    if vecdeque::popBack(ref values) != 2 { return 4; }

    vecdeque::dropVecDeque(ref values);

    return 0;
}