fn sum(count: s32) s32 @public @arbitraryArgs {
    var total: s32 = 0;
    var i: s32 = 0;

    while i < count {
        total += arbitraryArg(s32);
        i += 1;
    }

    return total;
}

fn main() s32 @public {
    if sum(4, 1, 2, 3, 4) != 10 { return 1; }
    if sum(2, 5, 6) != 11 { return 2; }
    return 0;
}