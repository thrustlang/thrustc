/*
 * Tests the compound assignment operator '^=' on a direct reference.
 * 12 = 0b1100, 10 = 0b1010, 12 ^ 10 = 0b0110 = 6.
 * Returns 0 on success, non-zero on failure.
 */

fn main() s32 @public {
    var x: s32 = 12;

    x ^= 10;

    if x != 6 {
        return 1;
    }

    var u: u64 = 0xFF;
    u ^= 0x0F;

    if u != 0xF0 {
        return 2;
    }

    return 0;
}