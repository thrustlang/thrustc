/*
 * Compile-time conditional chains: @elif and @else if
 */

fn main() s32 @public {
    var count: s32 = 0;

    @if(false) {
        count += 1;
    } @elif(true) {
        count += 2;
    } @else {
        count += 100;
    }

    @if(false) {
        count += 1000;
    } @else if(true) {
        count += 4;
    } @else {
        count += 10000;
    }

    @if(false) {
        count += 100000;
    } @elif(false) {
        count += 1000000;
    } @else {
        count += 8;
    }

    if count != 14 { return 1; }

    return 0;
}