/*
 * Compile-time conditional over top-level declarations
 *
 * Functions, constants and statics can be conditionally compiled at the
 * top level. The PLATFORM_CONST expectation assumes an x86_64-linux
 * target.
 */

@if(true) fn active_fn() s32 { return 100; } @else fn inactive_fn() s32 { return 9999; }

@if(false) fn a() s32 { return 1; } @else if(true) fn b() s32 { return 2; } @else fn c() s32 { return 3; }

@if(false) const BAD_CONST: u32 = 42; @else const GOOD_CONST: u32 = 7;

@if(isWindows()) const PLATFORM_CONST: u32 = 1; @elif(isLinux()) const PLATFORM_CONST: u32 = 2; @else const PLATFORM_CONST: u32 = 3;

@if(true) static ACTIVE_STATIC: u32 = 9; @else static INACTIVE_STATIC: u32 = 999;

fn main() s32 @public {
    if active_fn() != 100 { return 1; }
    if b() != 2 { return 2; }
    if GOOD_CONST != 7 { return 3; }
    if PLATFORM_CONST != 2 { return 4; }
    if ACTIVE_STATIC != 9 { return 5; }

    return 0;
}