fn main() s32 @public {
    var count: s32 = 0;

    @if(true) {
        count += 1;
    } @elif(false) {
        count += 100;
    } @else {
        count += 1000;
    }

    @if(false) {
        count += 100;
    } @elif(true) {
        count += 2;
    } @else {
        count += 1000;
    }

    @if(false) {
        count += 100;
    } @elif(false) {
        count += 1000;
    } @else {
        count += 4;
    }

    if count != 7 { return 1; }

    return 0;
}