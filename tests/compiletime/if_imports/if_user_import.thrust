/*
 * Conditional user imports: @if / @else selection
 *
 * On x86_64-linux, isLinux() is true, so mod_a is imported and from_mod_a
 * resolves.
 */

@if(isLinux()) import "mod_a.thrust" only { from_mod_a };
@else import "mod_b.thrust" only { from_mod_b };

fn main() s32 @public {
    if from_mod_a() != 1 { return 1; }

    return 0;
}