fn main() s32 @public {
    var count: s32 = 0;

    @if(isAarch64()) {
        count += 100;
    } @elif(isX8664()) {
        count += 1;
    } @else {
        count += 1000;
    }

    @if(isElf()) {
        count += 2;
    } @else if(isMachO()) {
        count += 100;
    } @else {
        count += 1000;
    }

    @if(hasSysvAbi()) {
        count += 4;
    } @else {
        count += 100;
    }

    if count != 7 { return 1; }

    return 0;
}