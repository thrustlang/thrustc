fn main() s32 @public {
    var atomicRelax counter: u32 = 1;

    var a: u32 = atomicAdd(counter, 1);
    var b: u32 = atomicAdd(counter, 1);
    var c: u32 = atomicAdd(counter, 1);

    if a != 1 { return 1; }
    if b != 2 { return 2; }
    if c != 3 { return 3; }
    if counter != 4 { return 4; }

    return 0;
}