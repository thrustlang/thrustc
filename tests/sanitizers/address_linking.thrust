/*
 * Exercises sanitizer propagation from file configuration to compiler-based
 * linking. The test should link with -fsanitize=address when built normally.
 */

directive "--sanitizer=address";
directive "--disable-warnings=W0020";

fn main() s32 @public {
    var value: s32 = 7;

    if value != 7 {
        return 1;
    }

    return 0;
}
