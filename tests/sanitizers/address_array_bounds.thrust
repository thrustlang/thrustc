/*
 * Sanitizer build with array indexing within bounds.
 */

directive "--sanitizer=address";
directive "--disable-warnings=W0020";

fn main() s32 @public {
    var buffer: array[s32; 4] = fixed[10, 20, 30, 40];
    var total: s32 = 0;
    var i: s32 = 0;

    while i < 4 {
        total += buffer->[i];
        i += 1;
    }

    if total != 100 { return 1; }

    return 0;
}