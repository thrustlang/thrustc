fn identity(value: NativeVector[f32; 4]) NativeVector[f32; 4] @simd {
    return value;
}

fn main() s32 @public {
    var value: NativeVector[f32; 4] = native[1.0, 2.0, 3.0, 4.0];
    var result: NativeVector[f32; 4] = identity(value);

    if result[0] != 1.0 { return 1; }
    if result[3] != 4.0 { return 2; }

    return 0;
}
