/*
 * Function inlining friendly: small leaf functions called repeatedly.
 */

fn add(a: s32, b: s32) s32 {
    return a + b;
}

fn sumArray() s32 {
    var total: s32 = 0;
    total = add(total, 1);
    total = add(total, 2);
    total = add(total, 3);
    total = add(total, 4);

    return total;
}

fn main() s32 @public {
    if sumArray() != 10 { return 1; }
    return 0;
}