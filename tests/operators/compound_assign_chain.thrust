fn main() s32 @public {
    var value: s32 = 15;

    value += 3;
    if value != 18 { return 1; }

    value -= 8;
    if value != 10 { return 2; }

    value *= 4;
    if value != 40 { return 3; }

    value /= 5;
    if value != 8 { return 4; }

    value %= 3;
    if value != 2 { return 5; }

    return 0;
}