fn main() s32 @public {
    var value: s32 = 5;

    var pre: s32 = ++value;
    if pre != 6 { return 1; }
    if value != 6 { return 2; }

    var post: s32 = value++;
    if post != 6 { return 3; }
    if value != 7 { return 4; }

    pre = --value;
    if pre != 6 { return 5; }
    if value != 6 { return 6; }

    post = value--;
    if post != 6 { return 7; }
    if value != 5 { return 8; }

    return 0;
}