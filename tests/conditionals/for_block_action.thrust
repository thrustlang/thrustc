directive "--disable-warnings=W0020";
directive "--disable-warnings=W0030";

fn main() s32 @public {
    var total: s32 = 0;

    for var i: s32 = 0; i < 3; {
        var step: s32 = 1;
        total += 10;
        i += step;
    } {
        total += 1;
    }

    if total != 33 { return 1; }

    return 0;
}
