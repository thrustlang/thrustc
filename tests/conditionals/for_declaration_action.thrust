directive "--disable-warnings=W0005";
directive "--disable-warnings=W0020";
directive "--disable-warnings=W0030";

fn main() s32 @public {
    var hits: s32 = 0;

    for var i: s32 = 0; i < 1; var actionLocal: s32 = 7; {
        hits += 1;
        i += 1;
    }

    if hits != 1 { return 1; }

    return 0;
}
