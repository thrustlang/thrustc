/*
 * File with TWO accumulated directives: W0020 and W0030 must NOT appear.
 * Returns 0 on success.
 */

directive "--disable-warnings=W0020";
directive "--disable-warnings=W0030";

fn helper() s32 {
    var y: s32 = 7;

    if y != 7 { return 1; }

    return 0;
}

fn main() s32 @public {
    var x: s32 = 5;

    if x != 5 { return 1; }
    if helper() != 0 { return 2; }

    return 0;
}