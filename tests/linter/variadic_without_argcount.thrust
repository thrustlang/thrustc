/*
 * Warnings: variadic function without @noArgCount, warning disabled.
 */

directive "--disable-warnings=W0033";
directive "--disable-warnings=W0020";

fn collect(count: s32) s32 @public @arbitraryArgs {
    var total: s32 = 0;
    var i: s32 = 0;

    while i < count {
        total += arbitraryArg(s32);
        i += 1;
    }

    return total;
}

fn main() s32 @public {
    if collect(3, 1, 2, 3) != 6 { return 1; }
    return 0;
}