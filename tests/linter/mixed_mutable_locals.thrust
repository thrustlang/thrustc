/*
 * Warnings: multiple mutable locals with mixed usage.
 */

directive "--disable-warnings=W0020";
directive "--disable-warnings=W0021";

fn combine() s32 {
    var a: s32 = 1;
    var b: s32 = 2;

    a = a + b;

    return a;
}

fn main() s32 @public {
    if combine() != 3 { return 1; }
    return 0;
}