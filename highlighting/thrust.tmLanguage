<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Thrust</string>
	<key>scopeName</key>
	<string>source.thrust</string>
	<key>fileTypes</key>
	<array>
		<string>thrust</string>
	</array>
	<key>patterns</key>
	<array>
		<dict>
			<key>include</key>
			<string>#block-comment</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#line-comment</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#attributes</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#strings</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#char-literal</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#numbers</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#keywords</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#atomic</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#types</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#builtins</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#constants</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#function-def</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#function-call</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#operators</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#punctuation</string>
		</dict>
	</array>
	<key>repository</key>
	<dict>
		<key>block-comment</key>
		<dict>
			<key>name</key>
			<string>comment.block.thrust</string>
			<key>begin</key>
			<string>/\*</string>
			<key>end</key>
			<string>\*/</string>
		</dict>
		<key>line-comment</key>
		<dict>
			<key>name</key>
			<string>comment.line.double-slash.thrust</string>
			<key>match</key>
			<string>//.*$</string>
		</dict>
		<key>attributes</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>comment</key>
					<string>Attributes with parenthesized argument</string>
					<key>name</key>
					<string>entity.other.attribute-name.thrust</string>
					<key>match</key>
					<string>@(?:asmAlignStack|asmSyntax|asmThrowErrors|asmSideEffects|align|optFuzzing|noUnwind|packed|heap|public|linkage|extern|arbitraryArgs|hot|minSize|alwaysInline|noInline|inline|safeStack|weakStack|strongStack|preciseFloatingPoint|convention|pure|thunk|cuda|constructor|destructor)\b</string>
				</dict>
			</array>
		</dict>
		<key>strings</key>
		<dict>
			<key>name</key>
			<string>string.quoted.double.thrust</string>
			<key>begin</key>
			<string>"</string>
			<key>end</key>
			<string>"</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.character.escape.thrust</string>
					<key>match</key>
					<string>\\(?:[nrtf0\\"']|x[0-9a-fA-F]{2})</string>
				</dict>
			</array>
		</dict>
		<key>char-literal</key>
		<dict>
			<key>name</key>
			<string>string.quoted.single.thrust</string>
			<key>match</key>
			<string>'(?:[^'\\]|\\.)'</string>
		</dict>
		<key>numbers</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.numeric.float.thrust</string>
					<key>match</key>
					<string>\b[0-9][0-9_]*\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>constant.numeric.hex.thrust</string>
					<key>match</key>
					<string>\b0x[0-9a-fA-F][0-9a-fA-F_]*\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>constant.numeric.binary.thrust</string>
					<key>match</key>
					<string>\b0b[01][01_]*\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>constant.numeric.integer.thrust</string>
					<key>match</key>
					<string>\b[0-9][0-9_]*\b</string>
				</dict>
			</array>
		</dict>
		<key>keywords</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>keyword.control.thrust</string>
					<key>match</key>
					<string>\b(if|elif|else|for|while|loop|return|break|continue|breakall|continueall|pass|defer|unreachable)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.declaration.thrust</string>
					<key>match</key>
					<string>\b(fn|var|const|struct|enum|type|asmfn|intrinsic|embedded|import|importC|new)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.thrust</string>
					<key>match</key>
					<string>\b(as|deref|ref|address|addr|load|write|alloc|fixed|or|and)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.modifier.thrust</string>
					<key>match</key>
					<string>\b(mut|static|global_asm|asm)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>constant.language.thrust</string>
					<key>match</key>
					<string>\b(true|false|nullptr)\b</string>
				</dict>
			</array>
		</dict>
		<key>atomic</key>
		<dict>
			<key>name</key>
			<string>storage.modifier.thrust</string>
			<key>match</key>
			<string>\b(volatile|lazyThread|atomicNone|atomicFree|atomicRelax|atomicGrab|atomicDrop|atomicSync|atomicStrict|threadInit|threadDyn|threadExec|threadLDyn)\b</string>
		</dict>
		<key>types</key>
		<dict>
			<key>name</key>
			<string>storage.type.thrust</string>
			<key>match</key>
			<string>\b(s8|s16|s32|s64|ssize|u8|u16|u32|u64|u128|usize|f32|f64|f128|f80|fppc_128|bool|char|ptr|array|void|Fn)\b</string>
		</dict>
		<key>builtins</key>
		<dict>
			<key>name</key>
			<string>support.function.builtin.thrust</string>
			<key>match</key>
			<string>\b(halloc|sizeOf|memset|memmove|memcpy|alignOf|abiSizeOf|bitSizeOf|abiAlignOf)\b</string>
		</dict>
		<key>constants</key>
		<dict>
			<key>name</key>
			<string>variable.other.constant.thrust</string>
			<key>match</key>
			<string>\b[A-Z][A-Z0-9_]{1,}\b</string>
		</dict>
		<key>function-def</key>
		<dict>
			<key>comment</key>
			<string>fn name(...) — highlight function name at definition</string>
			<key>match</key>
			<string>\b(fn)\s+([a-zA-Z_][a-zA-Z0-9_]*)\s*(?=\()</string>
			<key>captures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>keyword.declaration.thrust</string>
				</dict>
				<key>2</key>
				<dict>
					<key>name</key>
					<string>entity.name.function.thrust</string>
				</dict>
			</dict>
		</dict>
		<key>function-call</key>
		<dict>
			<key>comment</key>
			<string>name(...) — highlight function calls</string>
			<key>match</key>
			<string>\b([a-zA-Z_][a-zA-Z0-9_]*)\s*(?=\()</string>
			<key>captures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>entity.name.function.call.thrust</string>
				</dict>
			</dict>
		</dict>
		<key>operators</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>keyword.operator.comparison.thrust</string>
					<key>match</key>
					<string>==|!=|&lt;=|&gt;=|&lt;|&gt;</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.assignment.thrust</string>
					<key>match</key>
					<string>=</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.arithmetic.thrust</string>
					<key>match</key>
					<string>\+\+|--|\+|-|\*|/|%|>>|&lt;&lt;</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.bitwise.thrust</string>
					<key>match</key>
					<string>&amp;|\||\^|~</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.logical.thrust</string>
					<key>match</key>
					<string>!(?!=)</string>
				</dict>
			</array>
		</dict>
		<key>punctuation</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>punctuation.brackets.thrust</string>
					<key>match</key>
					<string>[\[\]\(\)\{\}]</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.separator.thrust</string>
					<key>match</key>
					<string>[,;:]</string>
				</dict>
				<dict>
					<key>name</key>
					<string>punctuation.accessor.thrust</string>
					<key>match</key>
					<string>\.</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
