{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Thrust",
  "scopeName": "source.thrust",
  "fileTypes": ["thrust"],
  "patterns": [
    { "include": "#block-comment" },
    { "include": "#line-comment" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#char-literal" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#atomic" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#function-def" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {

    "block-comment": {
      "name": "comment.block.thrust",
      "begin": "/\\*",
      "end": "\\*/"
    },

    "line-comment": {
      "name": "comment.line.double-slash.thrust",
      "match": "//.*$"
    },

    "attributes": {
      "patterns": [
        {
          "comment": "Attributes with parenthesized argument",
          "name": "entity.other.attribute-name.thrust",
          "match": "@(?:asmAlignStack|asmSyntax|asmThrowErrors|asmSideEffects|align|optFuzzing|noUnwind|packed|heap|public|linkage|extern|arbitraryArgs|hot|minSize|alwaysInline|noInline|inline|safeStack|weakStack|strongStack|preciseFloatingPoint|convention|pure|thunk|cuda|constructor|destructor)\\b"
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.thrust",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.thrust",
          "match": "\\\\(?:[nrtf0\\\\\"'\\\\]|x[0-9a-fA-F]{2})"
        }
      ]
    },

    "char-literal": {
      "name": "string.quoted.single.thrust",
      "match": "'(?:[^'\\\\]|\\\\.)'"
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.thrust",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.thrust",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.thrust",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "constant.numeric.integer.thrust",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.thrust",
          "match": "\\b(if|elif|else|for|while|loop|return|break|continue|breakall|continueall|pass|defer|unreachable)\\b"
        },
        {
          "name": "keyword.declaration.thrust",
          "match": "\\b(fn|var|const|struct|enum|type|asmfn|intrinsic|embedded|import|importC|new)\\b"
        },
        {
          "name": "keyword.operator.thrust",
          "match": "\\b(as|deref|ref|address|addr|load|write|alloc|fixed|or|and)\\b"
        },
        {
          "name": "keyword.modifier.thrust",
          "match": "\\b(mut|static|global_asm|asm)\\b"
        },
        {
          "name": "constant.language.thrust",
          "match": "\\b(true|false|nullptr)\\b"
        }
      ]
    },

    "atomic": {
      "name": "storage.modifier.thrust",
      "match": "\\b(volatile|lazyThread|atomicNone|atomicFree|atomicRelax|atomicGrab|atomicDrop|atomicSync|atomicStrict|threadInit|threadDyn|threadExec|threadLDyn)\\b"
    },

    "types": {
      "name": "storage.type.thrust",
      "match": "\\b(s8|s16|s32|s64|ssize|u8|u16|u32|u64|u128|usize|f32|f64|f128|f80|fppc_128|bool|char|ptr|array|void|Fn)\\b"
    },

    "builtins": {
      "name": "support.function.builtin.thrust",
      "match": "\\b(halloc|sizeOf|memset|memmove|memcpy|alignOf|abiSizeOf|bitSizeOf|abiAlignOf)\\b"
    },

    "constants": {
      "name": "variable.other.constant.thrust",
      "match": "\\b[A-Z][A-Z0-9_]{1,}\\b"
    },

    "function-def": {
      "comment": "fn name(...) — highlight function name at definition",
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "keyword.declaration.thrust" },
        "2": { "name": "entity.name.function.thrust" }
      }
    },

    "function-call": {
      "comment": "name(...) — highlight function calls",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.thrust" }
      }
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.thrust",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.thrust",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.thrust",
          "match": "\\+\\+|--|\\+|-|\\*|/|%|>>|<<"
        },
        {
          "name": "keyword.operator.bitwise.thrust",
          "match": "&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.logical.thrust",
          "match": "!(?!=)"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.brackets.thrust",
          "match": "[\\[\\]\\(\\)\\{\\}]"
        },
        {
          "name": "punctuation.separator.thrust",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.accessor.thrust",
          "match": "\\."
        }
      ]
    }
  }
}
