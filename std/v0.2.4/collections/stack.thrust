directive "--disable-warnings=W0020";

import std::collections::vector;

struct Stack [T] @public {
    storage: vector::Vector[T]
}

fn newStack [T] () Stack[T] @public {
    return new Stack[T] {
        storage: vector::newVector[T]()
    };
}

fn withCapacity [T] (capacity: usize) Stack[T] @public {
    return new Stack[T] {
        storage: vector::withCapacity[T](capacity)
    };
}

fn dropStack [T] (stack: ptr[Stack[T]]) void @public @deallocator {
    vector::dropVector[T](stack.storage);
}

fn getLength [T] (stack: ptr[Stack[T]]) usize @public {
    return vector::getLength[T](stack.storage);
}

fn getCapacity [T] (stack: ptr[Stack[T]]) usize @public {
    return vector::getCapacity[T](stack.storage);
}

fn isEmpty [T] (stack: ptr[Stack[T]]) bool @public {
    return vector::isEmpty[T](stack.storage);
}

fn push [T] (stack: ptr[Stack[T]], value: T) void @public {
    vector::push[T](stack.storage, value);
}

fn pop [T] (stack: ptr[Stack[T]]) T @public {
    return vector::pop[T](stack.storage);
}

fn peek [T] (stack: ptr[Stack[T]]) T @public {
    return vector::back[T](stack.storage);
}

fn clear [T] (stack: ptr[Stack[T]]) void @public {
    vector::clear[T](stack.storage);
}

fn reserveCapacity [T] (stack: ptr[Stack[T]], capacity: usize) void @public {
    vector::reserveCapacity[T](stack.storage, capacity);
}

fn shrinkToFit [T] (stack: ptr[Stack[T]]) void @public {
    vector::shrinkToFit[T](stack.storage);
}
