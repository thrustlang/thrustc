import std::ffi::c::math as c;

const E: f64 @public @extern("E") = 2.7182818284590452354;
const LOG2E: f64 @public @extern("LOG2E") = 1.4426950408889634074;
const LOG10E: f64 @public @extern("LOG10E") = 0.43429448190325182765;
const LN2: f64 @public @extern("LN2") = 0.69314718055994530942;
const LN10: f64 @public @extern("LN10") = 2.30258509299404568402;
const PI: f64 @public @extern("PI") = 3.14159265358979323846;
const PI_2: f64 @public @extern("PI_2") = 1.57079632679489661923;
const PI_4: f64 @public @extern("PI_4") = 0.78539816339744830962;
const ONE_OVER_PI: f64 @public @extern("ONE_OVER_PI") = 0.31830988618379067154;
const TWO_OVER_PI: f64 @public @extern("TWO_OVER_PI") = 0.63661977236758134308;
const TWO_OVER_SQRT_PI: f64 @public @extern("TWO_OVER_SQRT_PI") = 1.12837916709551257390;
const SQRT2: f64 @public @extern("SQRT2") = 1.41421356237309504880;
const ONE_OVER_SQRT2: f64 @public @extern("ONE_OVER_SQRT2") = 0.70710678118654752440;

const TAU: f64 @public @extern("TAU") = 6.28318530717958647692;
const PI_3: f64 @public @extern("PI_3") = 1.04719755119659774615;
const PI_6: f64 @public @extern("PI_6") = 0.52359877559829887308;
const PI_8: f64 @public @extern("PI_8") = 0.39269908169872415481;
const RADIANS_PER_DEGREE: f64 @public @extern("RADIANS_PER_DEGREE") = 0.01745329251994329577;
const DEGREES_PER_RADIAN: f64 @public @extern("DEGREES_PER_RADIAN") = 57.295779513082320877;
const LOG2_10: f64 @public @extern("LOG2_10") = 3.32192809488736234787;
const LOG10_2: f64 @public @extern("LOG10_2") = 0.30102999566398119521;
const SQRT3: f64 @public @extern("SQRT3") = 1.73205080756887729353;
const ONE_OVER_SQRT3: f64 @public @extern("ONE_OVER_SQRT3") = 0.57735026918962576451;
const EULER_GAMMA: f64 @public @extern("EULER_GAMMA") = 0.57721566490153286061;
const GOLDEN_RATIO: f64 @public @extern("GOLDEN_RATIO") = 1.61803398874989484820;
const CATALAN: f64 @public @extern("CATALAN") = 0.91596559417721901505;
const APERY: f64 @public @extern("APERY") = 1.20205690315959428540;

fn sine(x: f64) f64 @public {
    return c::sin(x);
}

fn cosine(x: f64) f64 @public {
    return c::cos(x);
}

fn tangent(x: f64) f64 @public {
    return c::tan(x);
}

fn arcSine(x: f64) f64 @public {
    return c::asin(x);
}

fn arcCosine(x: f64) f64 @public {
    return c::acos(x);
}

fn arcTangent(x: f64) f64 @public {
    return c::atan(x);
}

fn arcTangent2(y: f64, x: f64) f64 @public {
    return c::atan2(y, x);
}

fn hyperbolicSine(x: f64) f64 @public {
    return c::sinh(x);
}

fn hyperbolicCosine(x: f64) f64 @public {
    return c::cosh(x);
}

fn hyperbolicTangent(x: f64) f64 @public {
    return c::tanh(x);
}

fn inverseHyperbolicSine(x: f64) f64 @public {
    return c::asinh(x);
}

fn inverseHyperbolicCosine(x: f64) f64 @public {
    return c::acosh(x);
}

fn inverseHyperbolicTangent(x: f64) f64 @public {
    return c::atanh(x);
}

fn exponential(x: f64) f64 @public {
    return c::exp(x);
}

fn exponential2(x: f64) f64 @public {
    return c::exp2(x);
}

fn exponentialMinusOne(x: f64) f64 @public {
    return c::expm1(x);
}

fn naturalLogarithm(x: f64) f64 @public {
    return c::log(x);
}

fn logarithm2(x: f64) f64 @public {
    return c::log2(x);
}

fn logarithm10(x: f64) f64 @public {
    return c::log10(x);
}

fn naturalLogarithmPlusOne(x: f64) f64 @public {
    return c::log1p(x);
}

fn logarithmExponent(x: f64) f64 @public {
    return c::logb(x);
}

fn scaleByExponent(x: f64, exponent: s32) f64 @public {
    return c::ldexp(x, exponent);
}

fn fractionAndExponent(x: f64, exponent: ptr[s32]) f64 @public {
    return c::frexp(x, exponent);
}

fn splitFraction(x: f64, integerPart: ptr[f64]) f64 @public {
    return c::modf(x, integerPart);
}

fn power(x: f64, y: f64) f64 @public {
    return c::pow(x, y);
}

fn squareRoot(x: f64) f64 @public {
    return c::sqrt(x);
}

fn cubeRoot(x: f64) f64 @public {
    return c::cbrt(x);
}

fn hypotenuse(x: f64, y: f64) f64 @public {
    return c::hypot(x, y);
}

fn powerInteger(x: f64, n: s64) f64 @public {
    return c::pown(x, n);
}

fn powerReal(x: f64, y: f64) f64 @public {
    return c::powr(x, y);
}

fn integerRoot(x: f64, n: s64) f64 @public {
    return c::rootn(x, n);
}

fn reciprocalSquareRoot(x: f64) f64 @public {
    return c::rsqrt(x);
}

fn compound(x: f64, n: s64) f64 @public {
    return c::compoundn(x, n);
}

fn ceiling(x: f64) f64 @public {
    return c::ceil(x);
}

fn floorValue(x: f64) f64 @public {
    return c::floor(x);
}

fn roundValue(x: f64) f64 @public {
    return c::round(x);
}

fn truncate(x: f64) f64 @public {
    return c::trunc(x);
}

fn nearestInteger(x: f64) f64 @public {
    return c::rint(x);
}

fn nearbyInteger(x: f64) f64 @public {
    return c::nearbyint(x);
}

fn modulo(x: f64, y: f64) f64 @public {
    return c::fmod(x, y);
}

fn remainderValue(x: f64, y: f64) f64 @public {
    return c::remainder(x, y);
}

fn remainderQuotient(x: f64, y: f64, quotient: ptr[s32]) f64 @public {
    return c::remquo(x, y, quotient);
}

fn absolute(x: f64) f64 @public {
    return c::fabs(x);
}

fn minimum(x: f64, y: f64) f64 @public {
    return c::fmin(x, y);
}

fn maximum(x: f64, y: f64) f64 @public {
    return c::fmax(x, y);
}

fn positiveDifference(x: f64, y: f64) f64 @public {
    return c::fdim(x, y);
}

fn copySign(x: f64, y: f64) f64 @public {
    return c::copysign(x, y);
}

fn fusedMultiplyAdd(x: f64, y: f64, z: f64) f64 @public {
    return c::fma(x, y, z);
}

fn notANumber(tag: CString) f64 @public {
    return c::nan(tag);
}

fn nextRepresentable(x: f64, y: f64) f64 @public {
    return c::nextafter(x, y);
}

fn scaleByPowerOfTwo(x: f64, n: s32) f64 @public {
    return c::scalbn(x, n);
}

fn scaleByPowerOfTwoLong(x: f64, n: s64) f64 @public {
    return c::scalbln(x, n);
}

fn integerLogarithm(x: f64) s32 @public {
    return c::ilogb(x);
}

fn longLogarithm(x: f64) s64 @public {
    return c::llogb(x);
}

fn nearestIntegerToLong(x: f64) s64 @public {
    return c::lrint(x);
}

fn nearestIntegerToLongLong(x: f64) s64 @public {
    return c::llrint(x);
}

fn roundToLong(x: f64) s64 @public {
    return c::lround(x);
}

fn roundToLongLong(x: f64) s64 @public {
    return c::llround(x);
}

fn errorFunction(x: f64) f64 @public {
    return c::erf(x);
}

fn complementaryErrorFunction(x: f64) f64 @public {
    return c::erfc(x);
}

fn gammaFunction(x: f64) f64 @public {
    return c::tgamma(x);
}

fn logGamma(x: f64) f64 @public {
    return c::lgamma(x);
}

fn logGammaSigned(x: f64, sign: ptr[s32]) f64 @public {
    return c::logGammaR(x, sign);
}

fn besselJ0(x: f64) f64 @public {
    return c::j0(x);
}

fn besselJ1(x: f64) f64 @public {
    return c::j1(x);
}

fn besselJn(n: s32, x: f64) f64 @public {
    return c::jn(n, x);
}

fn besselY0(x: f64) f64 @public {
    return c::y0(x);
}

fn besselY1(x: f64) f64 @public {
    return c::y1(x);
}

fn besselYn(n: s32, x: f64) f64 @public {
    return c::yn(n, x);
}