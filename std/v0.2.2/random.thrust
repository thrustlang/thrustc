import std::ffi::c::random as c;

directive "--disable-warnings=W0020";
directive "--disable-warnings=W0024";
directive "--disable-warnings=W0030";

static mut randomState: u64 = 0;
static mut randomCounter: u64 = 0;
static mut randomInitialized: bool = false;

fn randomU64() u64 @public {
    var value: u64 = 0;

    @if(isLinux() || isDarwin()) {
        if c::getentropy(ref value as ptr, sizeOf(u64)) == 0 {
            return value;
        }
    } @else if(isWindows()) {
        var low: u32 = 0;
        var high: u32 = 0;

        if c::randS(ref low) == 0 && c::randS(ref high) == 0 {
            return ((high as u64) << 32) | (low as u64);
        }
    } @else {
        value = 0;
    }

    ensureRandomInitialized();

    randomState = splitMix64(randomState + randomCounter);
    randomCounter = randomCounter + 0x9E3779B97F4A7C15;

    return randomState;
}

fn randomUsize() usize @public {
    return randomU64() as usize;
}

fn fillRandomBytes(buffer: ptr, length: usize) void @public {
    var bytes: ptr[u8] = buffer as ptr[u8];
    var index: usize = 0;
    var value: u64 = 0;
    var available: usize = 0;

    while index < length {
        if available == 0 {
            value = randomU64();
            available = sizeOf(u64);
        }

        bytes[index] = (value & 0xFF) as u8;
        value = value >> 8;
        available = available - 1;
        index = index + 1;
    }
}

fn seedRandom(seed: u64) void @public {
    randomState = splitMix64(seed);
    randomCounter = 0x9E3779B97F4A7C15;
    randomInitialized = true;
}

fn ensureRandomInitialized() void {
    if !randomInitialized {
        var timer: s64 = 0;
        var now: s64 = c::time(ref timer);
        var ticks: s64 = c::clock();
        var local: u64 = 0;
        var localAddress: usize = (ref local) as usize;
        var seed: u64 = (now as u64) ^ ((ticks as u64) << 32) ^ (localAddress as u64);

        c::srand((seed ^ (seed >> 32)) as u32);

        seed = seed ^ ((c::rand() as u64) << 1);
        seed = seed ^ ((c::rand() as u64) << 33);

        seedRandom(seed);
    }
}

fn splitMix64(value: u64) u64 {
    var result: u64 = value + 0x9E3779B97F4A7C15;

    result = (result ^ (result >> 30)) * 0xBF58476D1CE4E5B9;
    result = (result ^ (result >> 27)) * 0x94D049BB133111EB;

    return result ^ (result >> 31);
}
