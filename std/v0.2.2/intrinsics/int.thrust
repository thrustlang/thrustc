fn wrappingAddS32(left: s32, right: s32) s32 @public { return signedAddWithOverflowS32(left, right)->value; }
fn wrappingAddU32(left: u32, right: u32) u32 @public { return unsignedAddWithOverflowU32(left, right)->value; }
fn wrappingSubS32(left: s32, right: s32) s32 @public { return signedSubWithOverflowS32(left, right)->value; }
fn wrappingSubU32(left: u32, right: u32) u32 @public { return unsignedSubWithOverflowU32(left, right)->value; }
fn wrappingMulS32(left: s32, right: s32) s32 @public { return signedMulWithOverflowS32(left, right)->value; }
fn wrappingMulU32(left: u32, right: u32) u32 @public { return unsignedMulWithOverflowU32(left, right)->value; }

fn saturatingAdd [T] (left: T, right: T) T @public {
    staticAssert(isInteger(T), "intrinsics::int::saturatingAdd[T] requires an integer type");

    @if(isSameType(T, s32)) { return signedSaturatingAddS32(left, right) as T; }
    @else if(isSameType(T, s64)) { return signedSaturatingAddS64(left, right) as T; }
    @else if(isSameType(T, u32)) { return unsignedSaturatingAddU32(left, right) as T; }
    @else if(isSameType(T, u64)) { return unsignedSaturatingAddU64(left, right) as T; }
}

fn saturatingSub [T] (left: T, right: T) T @public {
    staticAssert(isInteger(T), "intrinsics::int::saturatingSub[T] requires an integer type");

    @if(isSameType(T, s32)) { return signedSaturatingSubS32(left, right) as T; }
    @else if(isSameType(T, s64)) { return signedSaturatingSubS64(left, right) as T; }
    @else if(isSameType(T, u32)) { return unsignedSaturatingSubU32(left, right) as T; }
    @else if(isSameType(T, u64)) { return unsignedSaturatingSubU64(left, right) as T; }
}

fn max [T] (left: T, right: T) T @public {
    staticAssert(isInteger(T), "intrinsics::int::max[T] requires an integer type");

    @if(isSameType(T, s32)) { return signedMaxS32(left, right) as T; }
    @else if(isSameType(T, s64)) { return signedMaxS64(left, right) as T; }
    @else if(isSameType(T, u32)) { return unsignedMaxU32(left, right) as T; }
    @else if(isSameType(T, u64)) { return unsignedMaxU64(left, right) as T; }
}

fn min [T] (left: T, right: T) T @public {
    staticAssert(isInteger(T), "intrinsics::int::min[T] requires an integer type");

    @if(isSameType(T, s32)) { return signedMinS32(left, right) as T; }
    @else if(isSameType(T, s64)) { return signedMinS64(left, right) as T; }
    @else if(isSameType(T, u32)) { return unsignedMinU32(left, right) as T; }
    @else if(isSameType(T, u64)) { return unsignedMinU64(left, right) as T; }
}

fn absolute [T] (value: T) T @public {
    staticAssert(isSigned(T), "intrinsics::int::absolute[T] requires a signed integer type");

    @if(isSameType(T, s32)) { return absS32(value, false) as T; }
    @else if(isSameType(T, s64)) { return absS64(value, false) as T; }
}
