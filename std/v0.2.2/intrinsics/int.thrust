struct S8OverflowResult @public { value: s8, overflow: bool }
struct S16OverflowResult @public { value: s16, overflow: bool }
struct S32OverflowResult @public { value: s32, overflow: bool }
struct S64OverflowResult @public { value: s64, overflow: bool }
struct U8OverflowResult @public { value: u8, overflow: bool }
struct U16OverflowResult @public { value: u16, overflow: bool }
struct U32OverflowResult @public { value: u32, overflow: bool }
struct U64OverflowResult @public { value: u64, overflow: bool }

