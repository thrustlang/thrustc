directive "--disable-warnings=W0010";
directive "--disable-warnings=W0017";
directive "--disable-warnings=W0020";
directive "--disable-warnings=W0029";
directive "--disable-warnings=W0030";

import std::mem;
import std::random;
import std::tstring;

const HASHSET_INITIAL_CAPACITY: usize @public = 8;

const KEY_MODE_RAW: u8 @public = 0;
const KEY_MODE_CSTRING: u8 @public = 1;
const KEY_MODE_TSTRING: u8 @public = 2;

const MAX_LOAD_PERCENT: usize = 70;

const ENTRY_EMPTY: u8 = 0;
const ENTRY_OCCUPIED: u8 = 1;
const ENTRY_TOMBSTONE: u8 = 2;

struct HashSetEntry @public {
    key: ptr,
    keySize: usize,
    hash: u64,
    state: u8
}

struct HashSet [K] @public {
    entries: ptr[HashSetEntry],
    length: usize,
    capacity: usize,
    tombstones: usize,
    seed0: u64,
    seed1: u64,
    keyMode: u8,
    keySize: usize,
    keyMarker: ptr[K]
}

fn newHashSet [K] () HashSet[K] @public {
    /*
     * Raw keys are stored as exactly sizeOf(K) bytes. CString and TString are
     * content keys instead: copying/comparing their pointer or struct bytes
     * would compare ownership metadata, not the string contents.
     */
    @if(isSameType(K, CString)) {
        return buildHashSet[K](KEY_MODE_CSTRING, 0);
    } @else if(isSameType(K, tstring::TString)) {
        return buildHashSet[K](KEY_MODE_TSTRING, 0);
    } @else {
        return buildHashSet[K](KEY_MODE_RAW, sizeOf(K));
    }
}

fn withCapacity [K] (capacity: usize) HashSet[K] @public {
    var set := newHashSet[K]();

    if capacity > 0 {
        reserveCapacity(ref set, capacity);
    }

    return set;
}

fn dropHashSet [K] (set: ptr[HashSet[K]]) void @public {
    clear(set);

    if set->entries != nullptr {
        mem::freeMemory(set->entries as ptr);
    }

    set->entries = nullptr;
    set->length = 0;
    set->capacity = 0;
    set->tombstones = 0;
}

fn getLength [K] (set: ptr[HashSet[K]]) usize @public {
    return set->length;
}

fn getCapacity [K] (set: ptr[HashSet[K]]) usize @public {
    return set->capacity;
}

fn isEmpty [K] (set: ptr[HashSet[K]]) bool @public {
    return set->length == 0;
}

fn contains [K] (set: ptr[HashSet[K]], key: ptr) bool @public {
    if set->capacity == 0 {
        return false;
    }

    var keySize: usize = getKeySize(set, key);
    var hash: u64 = hashKeyData(set, key, keySize);
    var index: usize = (hash as usize) % set->capacity;
    var probes: usize = 0;

    while probes < set->capacity {
        if entryState(ref set->entries[index]) == ENTRY_EMPTY {
            return false;
        }

        if entryState(ref set->entries[index]) == ENTRY_OCCUPIED
            && entryHash(ref set->entries[index]) == hash
            && entryKeyEquals(ref set->entries[index], set, key, keySize)
        {
            return true;
        }

        index = (index + 1) % set->capacity;
        probes = probes + 1;
    }

    return false;
}

fn insert [K] (set: ptr[HashSet[K]], key: ptr) bool @public {
    ensureCapacity(set);

    var keySize: usize = getKeySize(set, key);
    var hash: u64 = hashKeyData(set, key, keySize);
    var index: usize = (hash as usize) % set->capacity;
    var probes: usize = 0;
    var firstTombstone: usize = set->capacity;

    while probes < set->capacity {
        if entryState(ref set->entries[index]) == ENTRY_EMPTY {
            if firstTombstone != set->capacity {
                index = firstTombstone;
                set->tombstones = set->tombstones - 1;
            }

            setEntry(ref set->entries[index], set, key, keySize, hash);
            set->length = set->length + 1;

            return true;
        }

        if entryState(ref set->entries[index]) == ENTRY_TOMBSTONE && firstTombstone == set->capacity {
            firstTombstone = index;
        }

        if entryState(ref set->entries[index]) == ENTRY_OCCUPIED
            && entryHash(ref set->entries[index]) == hash
            && entryKeyEquals(ref set->entries[index], set, key, keySize)
        {
            return false;
        }

        index = (index + 1) % set->capacity;
        probes = probes + 1;
    }

    reserveCapacity(set, set->capacity * 2);

    return insert(set, key);
}

fn remove [K] (set: ptr[HashSet[K]], key: ptr) bool @public {
    if set->capacity == 0 {
        return false;
    }

    var keySize: usize = getKeySize(set, key);
    var hash: u64 = hashKeyData(set, key, keySize);
    var index: usize = (hash as usize) % set->capacity;
    var probes: usize = 0;

    while probes < set->capacity {
        if entryState(ref set->entries[index]) == ENTRY_EMPTY {
            return false;
        }

        if entryState(ref set->entries[index]) == ENTRY_OCCUPIED
            && entryHash(ref set->entries[index]) == hash
            && entryKeyEquals(ref set->entries[index], set, key, keySize)
        {
            freeEntryKey(ref set->entries[index]);
            setEntryState(ref set->entries[index], ENTRY_TOMBSTONE);
            set->length = set->length - 1;
            set->tombstones = set->tombstones + 1;

            return true;
        }

        index = (index + 1) % set->capacity;
        probes = probes + 1;
    }

    return false;
}

fn clear [K] (set: ptr[HashSet[K]]) void @public {
    var index: usize = 0;

    while index < set->capacity {
        if entryState(ref set->entries[index]) == ENTRY_OCCUPIED {
            freeEntryKey(ref set->entries[index]);
        }

        setEntryState(ref set->entries[index], ENTRY_EMPTY);
        index = index + 1;
    }

    set->length = 0;
    set->tombstones = 0;
}

fn reserveCapacity [K] (set: ptr[HashSet[K]], requestedCapacity: usize) void @public {
    var newCapacity: usize = HASHSET_INITIAL_CAPACITY;

    while newCapacity < requestedCapacity {
        newCapacity = newCapacity * 2;
    }

    if newCapacity > set->capacity {
        rehash(set, newCapacity);
    }
}

fn buildHashSet [K] (keyMode: u8, keySize: usize) HashSet[K] {
    return new HashSet[K] {
        entries: nullptr,
        length: 0,
        capacity: 0,
        tombstones: 0,
        seed0: random::randomU64(),
        seed1: random::randomU64(),
        keyMode: keyMode,
        keySize: keySize,
        keyMarker: nullptr
    };
}

fn ensureCapacity [K] (target: ptr[HashSet[K]]) void {
    if target->capacity == 0 {
        rehash(target, HASHSET_INITIAL_CAPACITY);
        return;
    }

    if (target->length + target->tombstones + 1) * 100 >= target->capacity * MAX_LOAD_PERCENT {
        rehash(target, target->capacity * 2);
    }
}

fn rehash [K] (target: ptr[HashSet[K]], newCapacity: usize) void {
    var oldEntries: ptr[HashSetEntry] = target->entries;
    var oldCapacity: usize = target->capacity;
    var index: usize = 0;

    target->entries = mem::allocateZeroedMemory(newCapacity, sizeOf(HashSetEntry)) as ptr[HashSetEntry];
    target->capacity = newCapacity;
    target->length = 0;
    target->tombstones = 0;

    while index < oldCapacity {
        if entryState(ref oldEntries[index]) == ENTRY_OCCUPIED {
            insertRehashed(target, ref oldEntries[index]);
        }

        index = index + 1;
    }

    if oldEntries != nullptr {
        mem::freeMemory(oldEntries as ptr);
    }
}

fn insertRehashed [K] (target: ptr[HashSet[K]], source: ptr[HashSetEntry]) void {
    var index: usize = (source->hash as usize) % target->capacity;

    loop {
        if entryState(ref target->entries[index]) != ENTRY_OCCUPIED {
            copyEntry(ref target->entries[index], source);
            target->length = target->length + 1;

            return;
        }

        index = (index + 1) % target->capacity;
    }
}

fn setEntry [K] (entry: ptr[HashSetEntry], set: ptr[HashSet[K]], key: ptr, keySize: usize, hash: u64) void {
    entry->key = copyKey(set, key, keySize);
    entry->keySize = keySize;
    entry->hash = hash;
    entry->state = ENTRY_OCCUPIED;
}

fn copyEntry(target: ptr[HashSetEntry], source: ptr[HashSetEntry]) void {
    target->key = source->key;
    target->keySize = source->keySize;
    target->hash = source->hash;
    target->state = source->state;
}

fn setEntryState(entry: ptr[HashSetEntry], state: u8) void {
    entry->state = state;
}

fn freeEntryKey(entry: ptr[HashSetEntry]) void {
    if entry->key != nullptr {
        mem::freeMemory(entry->key);
    }

    entry->key = nullptr;
    entry->keySize = 0;
}

fn entryHash(entry: ptr[HashSetEntry]) u64 {
    return entry->hash;
}

fn entryState(entry: ptr[HashSetEntry]) u8 {
    return entry->state;
}

fn entryKeyEquals [K] (entry: ptr[HashSetEntry], set: ptr[HashSet[K]], key: ptr, keySize: usize) bool {
    if entry->keySize != keySize {
        return false;
    }

    return mem::compareMemory(entry->key, keyDataPointer(set, key), keySize) == 0;
}

fn copyKey [K] (set: ptr[HashSet[K]], key: ptr, keySize: usize) ptr {
    var copy: ptr = mem::allocateMemory(keySize);

    mem::copyMemory(copy, keyDataPointer(set, key), keySize);

    return copy;
}

fn hashKeyData [K] (set: ptr[HashSet[K]], key: ptr, keySize: usize) u64 {
    return sipHash13(keyDataPointer(set, key) as ptr[u8], keySize, set->seed0, set->seed1);
}

fn getKeySize [K] (set: ptr[HashSet[K]], key: ptr) usize {
    /*
     * CString length excludes the trailing NUL because equality and hashing are
     * based on string content. TString follows the same rule through tstring::len.
     */
    if set->keyMode == KEY_MODE_CSTRING {
        return cstringLength(key as CString);
    }

    if set->keyMode == KEY_MODE_TSTRING {
        return tstring::len(key as ptr[tstring::TString]);
    }

    return set->keySize;
}

fn keyDataPointer [K] (set: ptr[HashSet[K]], key: ptr) ptr {
    /*
     * Raw and CString keys already point at the compared bytes. TString keys are
     * structs, so their comparable data is the backing string buffer.
     */
    if set->keyMode == KEY_MODE_TSTRING {
        return tstring::toCString(key as ptr[tstring::TString]) as ptr;
    }

    return key;
}

fn cstringLength(text: CString) usize {
    var index: usize = 0;
    var data: ptr[char] = text as ptr[char];

    while data->[index] != '\0' {
        index = index + 1;
    }

    return index;
}

fn sipHash13(data: ptr[u8], length: usize, seed0: u64, seed1: u64) u64 {
    var v0: u64 = 0x736F6D6570736575 ^ seed0;
    var v1: u64 = 0x646F72616E646F6D ^ seed1;
    var v2: u64 = 0x6C7967656E657261 ^ seed0;
    var v3: u64 = 0x7465646279746573 ^ seed1;
    var offset: usize = 0;
    var message: u64;
    var last: u64 = (length as u64) << 56;

    while offset + 8 <= length {
        message = readU64LittleEndian(data, offset);
        v3 = v3 ^ message;
        sipRound(ref v0, ref v1, ref v2, ref v3);
        v0 = v0 ^ message;
        offset = offset + 8;
    }

    last = last | readTail(data, offset, length - offset);
    v3 = v3 ^ last;
    sipRound(ref v0, ref v1, ref v2, ref v3);
    v0 = v0 ^ last;
    v2 = v2 ^ 0xFF;
    sipRound(ref v0, ref v1, ref v2, ref v3);
    sipRound(ref v0, ref v1, ref v2, ref v3);
    sipRound(ref v0, ref v1, ref v2, ref v3);

    return v0 ^ v1 ^ v2 ^ v3;
}

fn sipRound(v0: ptr[u64], v1: ptr[u64], v2: ptr[u64], v3: ptr[u64]) void {
    v0[0] = v0->[0] + v1->[0];
    v1[0] = rotateLeft64(v1->[0], 13);
    v1[0] = v1->[0] ^ v0->[0];
    v0[0] = rotateLeft64(v0->[0], 32);
    v2[0] = v2->[0] + v3->[0];
    v3[0] = rotateLeft64(v3->[0], 16);
    v3[0] = v3->[0] ^ v2->[0];
    v0[0] = v0->[0] + v3->[0];
    v3[0] = rotateLeft64(v3->[0], 21);
    v3[0] = v3->[0] ^ v0->[0];
    v2[0] = v2->[0] + v1->[0];
    v1[0] = rotateLeft64(v1->[0], 17);
    v1[0] = v1->[0] ^ v2->[0];
    v2[0] = rotateLeft64(v2->[0], 32);
}

fn readU64LittleEndian(data: ptr[u8], offset: usize) u64 {
    return (data->[offset] as u64)
        | ((data->[offset + 1] as u64) << 8)
        | ((data->[offset + 2] as u64) << 16)
        | ((data->[offset + 3] as u64) << 24)
        | ((data->[offset + 4] as u64) << 32)
        | ((data->[offset + 5] as u64) << 40)
        | ((data->[offset + 6] as u64) << 48)
        | ((data->[offset + 7] as u64) << 56);
}

fn readTail(data: ptr[u8], offset: usize, length: usize) u64 {
    var result: u64 = 0;
    var index: usize = 0;

    while index < length {
        result = result | ((data->[offset + index] as u64) << ((index * 8) as u32));
        index = index + 1;
    }

    return result;
}

fn rotateLeft64(value: u64, bits: u32) u64 {
    return (value << bits) | (value >> (64 - bits));
}
