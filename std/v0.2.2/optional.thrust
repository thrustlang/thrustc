directive "--disable-warnings=W0016";
directive "--disable-warnings=W0017";
directive "--disable-warnings=W0020";
directive "--disable-warnings=W0030";

struct Optional [T] @public {
    value: T,
    hasValue: bool
}

fn some [T] (item: T) Optional[T] @public {
    var stored: T = item;

    return new Optional[T] {
        value: stored,
        hasValue: true
    };
}

fn none [T] () Optional[T] @public {
    var optional: Optional[T];

    optional->hasValue = false;

    return optional;
}

fn hasValue [T] (optional: ptr[Optional[T]]) bool @public {
    return optional->hasValue;
}

fn isSome [T] (optional: ptr[Optional[T]]) bool @public {
    return optional->hasValue;
}

fn isNone [T] (optional: ptr[Optional[T]]) bool @public {
    return !(optional->hasValue);
}

fn unwrap [T] (optional: ptr[Optional[T]]) T @public {
    return optional->value;
}

fn unwrapOr [T] (optional: ptr[Optional[T]], fallback: T) T @public {
    if optional->hasValue {
        return optional->value;
    }

    return fallback;
}

fn valueOr [T] (optional: ptr[Optional[T]], fallback: T) T @public {
    return unwrapOr(optional, fallback);
}

fn set [T] (optional: ptr[Optional[T]], value: T) void @public {
    optional->value = value;
    optional->hasValue = true;
}

fn replace [T] (optional: ptr[Optional[T]], value: T) Optional[T] @public {
    var previous: Optional[T] = optional->[0];

    set(optional, value);

    return previous;
}

fn clear [T] (optional: ptr[Optional[T]]) void @public {
    optional->hasValue = false;
}

fn take [T] (optional: ptr[Optional[T]]) Optional[T] @public {
    var current: Optional[T] = optional->[0];

    clear(optional);

    return current;
}

fn orElse [T] (optional: ptr[Optional[T]], fallback: Optional[T]) Optional[T] @public {
    if optional->hasValue {
        return optional->[0];
    }

    return fallback;
}

fn fromPtr [T] (value: ptr[T]) Optional[ptr[T]] @public {
    if value == nullptr {
        return none[ptr[T]]();
    }

    return some[ptr[T]](value);
}

fn ptrOrNull [T] (optional: ptr[Optional[ptr[T]]]) ptr[T] @public {
    if optional->hasValue {
        return optional->value;
    }

    return nullptr;
}
