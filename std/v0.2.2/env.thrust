directive "--disable-warnings=W0015";
directive "--disable-warnings=W0016";
directive "--disable-warnings=W0017";
directive "--disable-warnings=W0020";
directive "--disable-warnings=W0028";
directive "--disable-warnings=W0030";

import std::ffi::c::env as c;
import std::int;
import std::float;
import std::tstring;

fn hasArgument(argc: s32, index: s32) bool @public {
    return index >= 0 && index < argc;
}

fn argument(argc: s32, argv: ptr[array[char]], index: s32) CString @public {
    if !hasArgument(argc, index) {
        return "";
    }

    return argv->[index];
}

fn argumentAsTString(argc: s32, argv: ptr[array[char]], index: s32) tstring::TString @public {
    return tstring::fromCString(argument(argc, argv, index));
}

fn argumentAsS32(argc: s32, argv: ptr[array[char]], index: s32) s32 @public {
    return int::parseCString[s32](argument(argc, argv, index));
}

fn argumentAsS64(argc: s32, argv: ptr[array[char]], index: s32) s64 @public {
    return int::parseCString[s64](argument(argc, argv, index));
}

fn argumentAsU32(argc: s32, argv: ptr[array[char]], index: s32) u32 @public {
    return int::parseCString[u32](argument(argc, argv, index));
}

fn argumentAsU64(argc: s32, argv: ptr[array[char]], index: s32) u64 @public {
    return int::parseCString[u64](argument(argc, argv, index));
}

fn argumentAsF64(argc: s32, argv: ptr[array[char]], index: s32) f64 @public {
    return float::parseCString[f64](argument(argc, argv, index));
}

fn getVariable(name: CString) CString @public {
    return c::getenv(name);
}

fn getVariableAsTString(name: CString) tstring::TString @public {
    return tstring::fromCString(c::getenv(name));
}

fn hasVariable(name: CString) bool @public {
    return (c::getenv(name) as ptr[char]) != nullptr;
}

fn setVariable(name: CString, value: CString, overwrite: bool) s32 @public {
    var flag: s32 = 0;

    if overwrite {
        flag = 1;
    }

    return c::setenv(name, value, flag);
}

fn unsetVariable(name: CString) s32 @public {
    return c::unsetenv(name);
}

fn clearVariables() s32 @public {
    return c::clearenv();
}

fn homeDirectory() CString @public {
    return c::getenv("HOME");
}

fn temporaryDirectory() CString @public {
    return c::getenv("TMPDIR");
}

fn userName() CString @public {
    return c::getenv("USER");
}

fn hostName() CString @public {
    return c::getenv("HOSTNAME");
}

fn currentDirectory() CString @public {
    return c::getenv("PWD");
}