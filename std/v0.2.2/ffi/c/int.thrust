fn atoi(text: CString)                                  s32 @public @extern("atoi")    @convention("C");
fn atol(text: CString)                                  s64 @public @extern("atol")    @convention("C");
fn atoll(text: CString)                                 s64 @public @extern("atoll")   @convention("C");

fn strtol(text: CString, end: ptr[ptr], base: s32)      s64 @public @extern("strtol")  @convention("C");
fn strtoll(text: CString, end: ptr[ptr], base: s32)     s64 @public @extern("strtoll") @convention("C");
fn strtoul(text: CString, end: ptr[ptr], base: s32)     u64 @public @extern("strtoul") @convention("C");
fn strtoull(text: CString, end: ptr[ptr], base: s32)    u64 @public @extern("strtoull") @convention("C");
