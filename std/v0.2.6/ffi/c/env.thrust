fn getenv(name: CString) CString @public @extern("getenv") @convention("C");

@if(isWindows()) fn putenvS(name: CString, value: CString) s32 @public @extern("_putenv_s") @convention("C");
@else const hasPutenvS: bool @public = false;

@if(isWindows()) fn setEnvironmentVariable(name: CString, value: ptr) s32 @public @extern("SetEnvironmentVariableA") @convention("C");
@else const hasSetEnvironmentVariable: bool @public = false;

@if(isWindows()) fn getEnvironmentStrings() ptr[char] @public @extern("GetEnvironmentStringsA") @convention("C");
@else const hasGetEnvironmentStrings: bool @public = false;

@if(isWindows()) fn freeEnvironmentStrings(block: ptr[char]) s32 @public @extern("FreeEnvironmentStringsA") @convention("C");
@else const hasFreeEnvironmentStrings: bool @public = false;

@if(isWindows()) fn getComputerName(buffer: ptr, size: ptr[u32]) s32 @public @extern("GetComputerNameA") @convention("C");
@else const hasGetComputerName: bool @public = false;

@if(isWindows()) fn getTempPath(buffer: ptr, size: u32) u32 @public @extern("GetTempPathA") @convention("C");
@else const hasGetTempPath: bool @public = false;

@if(isWindows()) fn getCurrentDirectoryWindows(buffer: ptr, size: s32) CString @public @extern("_getcwd") @convention("C");
@else const hasGetCurrentDirectoryWindows: bool @public = false;

@if(isWindows()) const hasGetCurrentDirectoryPosix: bool @public = false;
@else fn getCurrentDirectoryPosix(buffer: ptr, size: usize) CString @public @extern("getcwd") @convention("C");

@if(isLinux()) fn secureGetenv(name: CString) CString @public @extern("secure_getenv") @convention("C");
@else const hasSecureGetenv: bool @public = false;

@if(isWindows()) const hasSetenv: bool @public = false;
@else fn setenv(name: CString, value: CString, overwrite: s32) s32 @public @extern("setenv") @convention("C");

@if(isWindows()) const hasUnsetenv: bool @public = false;
@else fn unsetenv(name: CString) s32 @public @extern("unsetenv") @convention("C");

@if(isLinux()) fn clearenv() s32 @public @extern("clearenv") @convention("C");
@else const hasClearenv: bool @public = false;

@if(isWindows()) const hasPutenv: bool @public = false;
@else fn putenv(assignment: CString) s32 @public @extern("putenv") @convention("C");

@if(isWindows()) const hasGethostname: bool @public = false;
@else fn gethostname(name: ptr, length: usize) s32 @public @extern("gethostname") @convention("C");

@if(isDarwin()) fn getBaseEnvironment() ptr[ptr[ptr[char]]] @public @extern("_NSGetEnviron") @convention("C");
@else if(isWindows()) const hasBaseEnvironment: bool @public = false;
@else static mut environ: ptr[ptr[char]] @public @extern("environ");