import std::intrinsics::x86_64::simd as x86_64simd_api;

// Float vectors

type F32x4 @public = NativeVector[f32; 4];
type F64x2 @public = NativeVector[f64; 2];
type F32x8 @public = NativeVector[f32; 8];
type F64x4 @public = NativeVector[f64; 4];
type F32x16 @public = NativeVector[f32; 16];
type F64x8 @public = NativeVector[f64; 8];

// Integer vectors

type S8x16 @public = NativeVector[s8; 16];
type U8x16 @public = NativeVector[u8; 16];
type S16x8 @public = NativeVector[s16; 8];
type U16x8 @public = NativeVector[u16; 8];
type S32x4 @public = NativeVector[s32; 4];
type U32x4 @public = NativeVector[u32; 4];
type S64x2 @public = NativeVector[s64; 2];
type U64x2 @public = NativeVector[u64; 2];
type S8x32 @public = NativeVector[s8; 32];
type U8x32 @public = NativeVector[u8; 32];
type S16x16 @public = NativeVector[s16; 16];
type U16x16 @public = NativeVector[u16; 16];
type S32x8 @public = NativeVector[s32; 8];
type U32x8 @public = NativeVector[u32; 8];
type S64x4 @public = NativeVector[s64; 4];
type U64x4 @public = NativeVector[u64; 4];
type S8x64 @public = NativeVector[s8; 64];
type U8x64 @public = NativeVector[u8; 64];
type S16x32 @public = NativeVector[s16; 32];
type U16x32 @public = NativeVector[u16; 32];
type S32x16 @public = NativeVector[s32; 16];
type U32x16 @public = NativeVector[u32; 16];
type S64x8 @public = NativeVector[s64; 8];
type U64x8 @public = NativeVector[u64; 8];

fn addPackedSinglePrecision128(left: F32x4, right: F32x4) F32x4 @public @simd {
    return x86_64simd_api::addF32x4(left, right);
}

fn subPackedSinglePrecision128(left: F32x4, right: F32x4) F32x4 @public @simd {
    return x86_64simd_api::subF32x4(left, right);
}

fn mulPackedSinglePrecision128(left: F32x4, right: F32x4) F32x4 @public @simd {
