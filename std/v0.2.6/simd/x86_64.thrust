    return x86_64simd_api::maxF32x4(left, right);
}

fn sqrtPackedSinglePrecision128(value: F32x4) F32x4 @public @simd {
    return x86_64simd_api::sqrtF32x4(value);
}

fn absPackedSinglePrecision128(value: F32x4) F32x4 @public @simd {
    return x86_64simd_api::absF32x4(value);
}

