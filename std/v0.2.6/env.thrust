directive "--disable-warnings=W0015";
directive "--disable-warnings=W0016";
directive "--disable-warnings=W0017";
directive "--disable-warnings=W0020";
directive "--disable-warnings=W0028";
directive "--disable-warnings=W0030";

import std::cstring;
import std::ffi::c::env as c;
import std::int;
import std::float;
import std::tstring;
import std::collections::vector as vec;

static mut currentDirectoryStorage: array[char; 4096];
static mut hostNameStorage: array[char; 256];

@if(isWindows()) static mut temporaryDirectoryStorage: array[char; 4096];
@else const hasTemporaryDirectoryStorage: bool @public = false;

@if(isWindows()) static mut homeDirectoryStorage: array[char; 4096];
@else const hasHomeDirectoryStorage: bool @public = false;

fn arguments(argc: s32, argv: ptr[array[char]]) vec::Vector[tstring::TString] @public {
    var result := vec::withCapacity[tstring::TString](argc as usize);
    var index: usize = 0;

    while index < (argc as usize) {
        vec::push[tstring::TString](ref result, tstring::fromCString(argv->[index]));
        index = index + 1;
    }

    return result;
}

fn setVariable(name: CString, value: CString, overwrite: bool) s32 @public {
    @if(isWindows()) {
        if !overwrite {
            if (c::getenv(name) as ptr[char]) != nullptr {
                return 0;
            }
        }

        var result: s32 = c::putenvS(name, value);

        if result == 0 {
            c::setEnvironmentVariable(name, value as ptr);
        }

        return result;
    } @else {
        var flag: s32 = 0;

        if overwrite {
            flag = 1;
        }

        return c::setenv(name, value, flag);
    }
}

fn argument(argc: s32, argv: ptr[array[char]], index: s32) CString @public {
    if !hasArgument(argc, index) {
        return "";
    }

    return argv->[index];
}

fn hasArgument(argc: s32, index: s32) bool @public {
    return index >= 0 && index < argc;
}

fn argumentAsTString(argc: s32, argv: ptr[array[char]], index: s32) tstring::TString @public {
    return tstring::fromCString(argument(argc, argv, index));
}

fn argumentAsS32(argc: s32, argv: ptr[array[char]], index: s32) s32 @public {
    return int::parseCString[s32](argument(argc, argv, index));
}

fn argumentAsS64(argc: s32, argv: ptr[array[char]], index: s32) s64 @public {
    return int::parseCString[s64](argument(argc, argv, index));
}

fn argumentAsU32(argc: s32, argv: ptr[array[char]], index: s32) u32 @public {
    return int::parseCString[u32](argument(argc, argv, index));
}

fn argumentAsU64(argc: s32, argv: ptr[array[char]], index: s32) u64 @public {
    return int::parseCString[u64](argument(argc, argv, index));
}

fn argumentAsF64(argc: s32, argv: ptr[array[char]], index: s32) f64 @public {
    return float::parseCString[f64](argument(argc, argv, index));
}

fn getVariable(name: CString) CString @public {
    return c::getenv(name);
}

fn getVariableAsTString(name: CString) tstring::TString @public {
    var value: ptr[char] = c::getenv(name) as ptr[char];

    if value == nullptr {
        return tstring::fromCString("");
    }

    return tstring::fromCString(value as CString);
}

fn hasVariable(name: CString) bool @public {
    return (c::getenv(name) as ptr[char]) != nullptr;
}

fn unsetVariable(name: CString) s32 @public {
    @if(isWindows()) {
        var result: s32 = c::putenvS(name, "");

        c::setEnvironmentVariable(name, nullptr);

        return result;
    } @else {
        return c::unsetenv(name);
    }
}

fn clearVariables() s32 @public {
    @if(isWindows()) {
        var block: ptr[char] = c::getEnvironmentStrings();
        var buffer: array[char; 4096];
        var offset: usize = 0;

        if block == nullptr {
            return -1;
        }

        while block->[offset] != '\0' {
            var entryStart: usize = offset;
            var nameLength: usize = 0;

            while block->[offset + nameLength] != '\0' && block->[offset + nameLength] != '=' {
                nameLength = nameLength + 1;
            }

            if block->[entryStart] != '=' && nameLength > 0 {
                if nameLength >= 4096 {
                    c::freeEnvironmentStrings(block);

                    return -1;
                }

                var index: usize = 0;

                while index < nameLength {
                    buffer[index] = block->[entryStart + index];
                    index = index + 1;
                }

                buffer[nameLength] = '\0';

                c::putenvS((ref buffer) as CString, "");
                c::setEnvironmentVariable((ref buffer) as CString, nullptr);
            }

            while block->[offset] != '\0' {
                offset = offset + 1;
            }

            offset = offset + 1;
        }

        c::freeEnvironmentStrings(block);

        return 0;
    } @else if(isDarwin()) {
        var buffer: array[char; 1024];

        loop {
            var environment: ptr[ptr[char]] = c::getBaseEnvironment()->[0];

            if environment == nullptr {
                return 0;
            }

            var entry: ptr[char] = environment->[0];

            if entry == nullptr {
                return 0;
            }

            var nameLength: usize = 0;

            while entry->[nameLength] != '\0' && entry->[nameLength] != '=' {
                nameLength = nameLength + 1;
            }

            if nameLength == 0 || nameLength >= 1024 {
                return -1;
            }

            var index: usize = 0;

            while index < nameLength {
                buffer[index] = entry->[index];
                index = index + 1;
            }

            buffer[nameLength] = '\0';

            if c::unsetenv((ref buffer) as CString) != 0 {
                return -1;
            }
        }
    } @else {
        var buffer: array[char; 1024];

        loop {
            var environment: ptr[ptr[char]] = c::environ;

            if environment == nullptr {
                return 0;
            }

            var entry: ptr[char] = environment->[0];

            if entry == nullptr {
                return 0;
            }

            var nameLength: usize = 0;

            while entry->[nameLength] != '\0' && entry->[nameLength] != '=' {
                nameLength = nameLength + 1;
            }

            if nameLength == 0 || nameLength >= 1024 {
                return -1;
            }

            var index: usize = 0;

            while index < nameLength {
                buffer[index] = entry->[index];
                index = index + 1;
            }

            buffer[nameLength] = '\0';

            if c::unsetenv((ref buffer) as CString) != 0 {
                return -1;
            }
        }
    }
}

fn homeDirectory() CString @public {
    @if(isWindows()) {
        if (c::getenv("USERPROFILE") as ptr[char]) != nullptr {
            return c::getenv("USERPROFILE");
        }

        if (c::getenv("HOME") as ptr[char]) != nullptr {
            return c::getenv("HOME");
        }

        var drive: ptr[char] = c::getenv("HOMEDRIVE") as ptr[char];
        var path: ptr[char] = c::getenv("HOMEPATH") as ptr[char];

        if drive != nullptr && path != nullptr {
            var driveLength: usize = cstring::lengthRaw(drive);
            var pathLength: usize = cstring::lengthRaw(path);

            if driveLength + pathLength < 4096 {
                var destination: ptr[char] = (ref homeDirectoryStorage) as ptr[char];
                var end: usize = cstring::pushAt(destination, 4096, 0, drive);

                end = cstring::pushAt(destination, 4096, end, path);

                return (ref homeDirectoryStorage) as CString;
            }
        }
    } @else {
        if (c::getenv("HOME") as ptr[char]) != nullptr {
            return c::getenv("HOME");
        }
    }

    return currentDirectory();
}

fn temporaryDirectory() CString @public {
    @if(isWindows()) {
        if (c::getenv("TEMP") as ptr[char]) != nullptr {
            return c::getenv("TEMP");
        }

        if (c::getenv("TMP") as ptr[char]) != nullptr {
            return c::getenv("TMP");
        }

        var length: u32 = c::getTempPath((ref temporaryDirectoryStorage) as ptr, 4096);

        if length > 0 && length < 4096 {
            return (ref temporaryDirectoryStorage) as CString;
        }

        return currentDirectory();
    } @else {
        if (c::getenv("TMPDIR") as ptr[char]) != nullptr {
            return c::getenv("TMPDIR");
        }

        return "/tmp";
    }
}

fn userName() CString @public {
    @if(isWindows()) {
        if (c::getenv("USERNAME") as ptr[char]) != nullptr {
            return c::getenv("USERNAME");
        }

        if (c::getenv("USER") as ptr[char]) != nullptr {
            return c::getenv("USER");
        }
    } @else {
        if (c::getenv("USER") as ptr[char]) != nullptr {
            return c::getenv("USER");
        }

        if (c::getenv("LOGNAME") as ptr[char]) != nullptr {
            return c::getenv("LOGNAME");
        }
    }

    return "";
}

fn hostName() CString @public {
    @if(isWindows()) {
        if (c::getenv("COMPUTERNAME") as ptr[char]) != nullptr {
            return c::getenv("COMPUTERNAME");
        }

        var length: u32 = 256;

        if c::getComputerName((ref hostNameStorage) as ptr, ref length) != 0 {
            var destination: ptr[char] = (ref hostNameStorage) as ptr;

            if length < 256 {
                cstring::terminateAt(destination, length as usize);
            } else {
                cstring::terminateAt(destination, 255);
            }

            return (ref hostNameStorage) as CString;
        }

        return "";
    } @else {
        if (c::getenv("HOSTNAME") as ptr[char]) != nullptr {
            return c::getenv("HOSTNAME");
        }

        if c::gethostname((ref hostNameStorage) as ptr, 256) == 0 {
            var destination: ptr[char] = (ref hostNameStorage) as ptr;

            cstring::ensureTerminated(destination, 256);

            return (ref hostNameStorage) as CString;
        }

        return "";
    }
}

fn currentDirectory() CString @public {
    @if(isWindows()) {
        if (c::getCurrentDirectoryWindows((ref currentDirectoryStorage) as ptr, 4096 as s32) as ptr[char]) != nullptr {
            return (ref currentDirectoryStorage) as CString;
        }
    } @else {
        if (c::getCurrentDirectoryPosix((ref currentDirectoryStorage) as ptr, 4096) as ptr[char]) != nullptr {
            return (ref currentDirectoryStorage) as CString;
        }
    }

    if (c::getenv("PWD") as ptr[char]) != nullptr {
        return c::getenv("PWD");
    }

    return "";
}
