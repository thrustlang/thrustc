type U64x8 @public = NativeVector[u64; 8];

fn addF32x4(left: F32x4, right: F32x4) F32x4 @public @simd {
    return left + right;
}

fn subF32x4(left: F32x4, right: F32x4) F32x4 @public @simd {
    return left - right;
}

fn mulF32x4(left: F32x4, right: F32x4) F32x4 @public @simd {
    return left * right;
}

fn divF32x4(left: F32x4, right: F32x4) F32x4 @public @simd {
    return left / right;
}

intrinsic("llvm.sqrt.v4f32") sqrtF32x4Native(value: F32x4) F32x4 @public @simd;
fn sqrtF32x4(value: F32x4) F32x4 @public @simd {
    return sqrtF32x4Native(value);
}

intrinsic("llvm.fabs.v4f32") absF32x4Native(value: F32x4) F32x4 @public @simd;
fn absF32x4(value: F32x4) F32x4 @public @simd {
    return absF32x4Native(value);
}

intrinsic("llvm.minimum.v4f32") minF32x4Native(left: F32x4, right: F32x4) F32x4 @public @simd;
fn minF32x4(left: F32x4, right: F32x4) F32x4 @public @simd {
    return minF32x4Native(left, right);
}

intrinsic("llvm.maximum.v4f32") maxF32x4Native(left: F32x4, right: F32x4) F32x4 @public @simd;
fn maxF32x4(left: F32x4, right: F32x4) F32x4 @public @simd {
    return maxF32x4Native(left, right);
}

