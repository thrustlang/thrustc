directive "--disable-warnings=W0020";

import std::collections::vecdeque;

struct Queue [T] @public {
    storage: vecdeque::VecDeque[T]
}

fn newQueue [T] () Queue[T] @public {
    return new Queue[T] {
        storage: vecdeque::newVecDeque[T]()
    };
}

fn withCapacity [T] (capacity: usize) Queue[T] @public {
    return new Queue[T] {
        storage: vecdeque::withCapacity[T](capacity)
    };
}

fn dropQueue [T] (queue: ptr[Queue[T]]) void @public @deallocator {
    vecdeque::dropVecDeque[T](queue.storage);
}

fn getLength [T] (queue: ptr[Queue[T]]) usize @public {
    return vecdeque::getLength[T](queue.storage);
}

fn getCapacity [T] (queue: ptr[Queue[T]]) usize @public {
    return vecdeque::getCapacity[T](queue.storage);
}

fn isEmpty [T] (queue: ptr[Queue[T]]) bool @public {
    return vecdeque::isEmpty[T](queue.storage);
}

fn enqueue [T] (queue: ptr[Queue[T]], value: T) void @public {
    vecdeque::pushBack[T](queue.storage, value);
}

fn dequeue [T] (queue: ptr[Queue[T]]) T @public {
    return vecdeque::popFront[T](queue.storage);
}

fn front [T] (queue: ptr[Queue[T]]) T @public {
    return vecdeque::front[T](queue.storage);
}

fn back [T] (queue: ptr[Queue[T]]) T @public {
    return vecdeque::back[T](queue.storage);
}

fn clear [T] (queue: ptr[Queue[T]]) void @public {
    vecdeque::clear[T](queue.storage);
}

fn reserveCapacity [T] (queue: ptr[Queue[T]], capacity: usize) void @public {
    vecdeque::reserveCapacity[T](queue.storage, capacity);
}

fn shrinkToFit [T] (queue: ptr[Queue[T]]) void @public {
    vecdeque::shrinkToFit[T](queue.storage);
}
