fn logarithmExponent(x: f64) f64 @public {
    return c::logb(x);
}

fn scaleByExponent(x: f64, exponent: s32) f64 @public {
    return c::ldexp(x, exponent);
}

fn fractionAndExponent(x: f64, exponent: ptr[s32]) f64 @public {
    return c::frexp(x, exponent);
}

fn splitFraction(x: f64, integerPart: ptr[f64]) f64 @public {
