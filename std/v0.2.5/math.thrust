}

fn reciprocalSquareRoot(x: f64) f64 @public {
    return c::rsqrt(x);
}

fn compound(x: f64, n: s64) f64 @public {
    return c::compoundn(x, n);
}

fn ceiling(x: f64) f64 @public {
    return c::ceil(x);
}

fn floorValue(x: f64) f64 @public {
    return c::floor(x);
