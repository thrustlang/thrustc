@if(isLinux() || isDarwin()) fn getentropy(buffer: ptr, length: usize) s32 @public @extern("getentropy") @convention("C");
@else const hasGetEntropy: bool @public = false;

@if(isWindows()) fn randS(value: ptr[u32]) s32 @public @extern("rand_s") @convention("C");
@else const hasRandS: bool @public = false;

fn time(timer: ptr[s64]) s64 @public @extern("time") @convention("C");
fn clock() s64 @public @extern("clock") @convention("C");
fn rand() s32 @public @extern("rand") @convention("C");
fn srand(seed: u32) void @public @extern("srand") @convention("C");
