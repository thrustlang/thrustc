fn atof(text: CString)                             f64 @public @extern("atof")    @convention("C");
fn strtof(text: CString, end: ptr[ptr])            f32 @public @extern("strtof")  @convention("C");
fn strtod(text: CString, end: ptr[ptr])            f64 @public @extern("strtod")  @convention("C");
fn strtold(text: CString, end: ptr[ptr])           f80 @public @extern("strtold") @convention("C");
